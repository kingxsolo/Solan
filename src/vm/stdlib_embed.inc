    "    اذا ليس [\"https\", \"http\", \"ssh\", \"git\"].يحتوي(مخطط) { ارمي \"بروتوكول غير مسموح: \" + مخطط + \" (المسموح: https, http, ssh, git, file)\" }\n"
    "    خل ب = م.جزء(م.ابحث(\"://\") + 3)\n"
    "    خل ا = ب.ابحث(\"@\")\n"
    "    خل ش = ب.ابحث(\"/\")\n"
    "    اذا ا >= 0 و (ش < 0 او ا < ش) { ب = ب.جزء(ا + 1) }\n"
    "    معرف = ب\n"
    "    مضيف = ب.قسم(\"/\")[0].قسم(\":\")[0]\n"
    "  } والا اذا م.يبدأ_ب(\"git@\") {\n"
    "    معرف = م.جزء(4).ابدل(\":\", \"/\")\n"
    "    مضيف = معرف.قسم(\"/\")[0]\n"
    "  } والا {\n"
    "    اذا ليس م.يحتوي(\"/\") او م.يحتوي(\":\") { ارمي \"مصدر غير صالح (الشكل المتوقع owner/repo): \" + نص }\n"
    "    رابط = \"https://github.com/\" + م + \".git\"\n"
    "    معرف = \"github.com/\" + م\n"
    "    مضيف = \"github.com\"\n"
    "  }\n"
    "  معرف = معرف.ابدل(\":\", \"_\")\n"
    "  اذا معرف.ينتهي_ب(\".git\") { معرف = معرف.جزء(0, طول(معرف) - 4) }\n"
    "  طالما معرف.ينتهي_ب(\"/\") { معرف = معرف.جزء(0, طول(معرف) - 1) }\n"
    "  اذا _مستضيفات_غير_حساسة.يحتوي(مضيف.صغير()) { معرف = معرف.صغير() }\n"
    "  اذا معرف.يحتوي(\"..\") او معرف.يبدأ_ب(\"/\") او معرف.يبدأ_ب(\"-\") او معرف.يحتوي(\"//\") او طول(معرف) > 200 او طول(معرف.قسم(\"/\")) < 2 { ارمي \"مصدر غير صالح: \" + نص }\n"
    "  لكل ح في معرف {\n"
    "    اذا ليس (\"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-/\".يحتوي(ح)) { ارمي \"مصدر غير صالح (حرف غير مسموح): \" + نص }\n"
    "  }\n"
    "  اذا رابط.يبدأ_ب(\"-\") او رابط.يحتوي(\" \") او رابط.يحتوي(\"\\n\") او رابط.يحتوي(\"\\\"\") او رابط.يبدأ_ب(\"ext::\") او طول(رابط) > 400 { ارمي \"رابط غير صالح: \" + نص }\n"
    "  اذا مرجع != \"\" { _تحقق(مرجع, \"المرجع\") }\n"
    "  اذا نطاق != \"\" { لكل ح في نطاق { اذا ليس \"0123456789.xX*^~<>=vV latest\".يحتوي(ح) { ارمي \"نطاق إصدار غير صالح: \" + نطاق } } }\n"
    "  اذا مرجع != \"\" و نطاق != \"\" { ارمي \"لا يمكن الجمع بين نطاق إصدار ومرجع (#): \" + نص }\n"
    "  ارجع {\"نوع\": \"git\", \"رابط\": رابط, \"معرف\": معرف, \"نطاق\": نطاق, \"مرجع\": مرجع}\n"
    "}\n"
    "دالة _اسم_افتراضي(معرف) {\n"
    "  خل ق = معرف.قسم(\"/\")\n"
    "  ارجع ق[طول(ق) - 1]\n"
    "}\n"
    "\n"
    "دالة _وسوم(رابط) {\n"
    "  خل ر = _نفذ([\"git\", \"ls-remote\", \"--tags\", \"--refs\", \"--\", رابط])\n"
    "  اذا ر[\"رمز\"] != 0 { ارمي \"تعذّر قراءة وسوم المستودع (تحقق من الرابط والاتصال والصلاحيات): \" + رابط }\n"
    "  خل خارج = []\n"
    "  لكل س في ر[\"ناتج\"].قسم(\"\\n\") {\n"
    "    خل ج = س.قسم(\"\\t\")\n"
    "    اذا طول(ج) < 2 { استمر }\n"
    "    خل وسم = ج[1].نظف()\n"
    "    اذا ليس وسم.يبدأ_ب(\"refs/tags/\") { استمر }\n"
    "    وسم = وسم.جزء(10)\n"
    "    خل ن = _اجزاء(وسم)\n"
    "    اذا ن != عدم { خارج.اضف({\"وسم\": وسم, \"ن\": ن, \"نص\": \"${ن[0]}.${ن[1]}.${ن[2]}\"}) }\n"
    "  }\n"
    "  ارجع خارج\n"
    "}\n"
    "دالة _اصدارات_محلية(معرف) {\n"
    "  خل خارج = []\n"
    "  خل مجلد = المتجر + \"/\" + معرف\n"
    "  اذا ليس ملفات.هل_مجلد(مجلد) { ارجع خارج }\n"
    "  لكل س في ملفات.قائمة(مجلد) {\n"
    "    خل ن = _اجزاء(س)\n"
    "    اذا ن != عدم { خارج.اضف({\"وسم\": \"v\" + س, \"ن\": ن, \"نص\": س}) }\n"
    "  }\n"
    "  ارجع خارج\n"
    "}\n"
    "دالة _ميتا(معرف, اصدار) {\n"
    "  خل مسار = _مسار_المتجر(معرف, اصدار) + \"/.solan-meta\"\n"
    "  اذا ملفات.موجود(مسار) {\n"
    "    حاول { ارجع جيسون.فك(ملفات.اقرا(مسار)) } امسك (خ) { ارجع عدم }\n"
    "  }\n"
    "  ارجع عدم\n"
    "}\n"
    "دالة _اختر(وسوم, نطاق) {\n"
    "  خل مرشح = وسوم.رشح(ع => _يطابق(ع[\"ن\"], نطاق))\n"
    "  اذا طول(مرشح) == 0 { ارجع عدم }\n"
    "  خل مرتب = مرشح.رتب((أ, ب) => _قارن(ب[\"ن\"], أ[\"ن\"]))\n"
    "  ارجع مرتب[0]\n"
    "}\n"
    "\n"
    "دالة _ملفات(مجلد, اساس, خارج) {\n"
    "  لكل س في ملفات.قائمة(مجلد) {\n"
    "    اذا س == \".git\" او س == \".solan-meta\" { استمر }\n"
    "    خل مسار = مجلد + \"/\" + س\n"
    "    خل نسبي = اساس == \"\" ؟ س : اساس + \"/\" + س\n"
    "    اذا ملفات.هل_رابط(مسار) { ارمي \"الحزمة تحتوي رابطا رمزيا (غير مسموح): \" + نسبي }\n"
    "    اذا ملفات.هل_مجلد(مسار) { _ملفات(مسار, نسبي, خارج) } والا {\n"
    "      خارج.اضف(نسبي)\n"
    "      اذا طول(خارج) > الحد_الاقصى_للملفات { ارمي \"الحزمة تتجاوز الحد الأقصى لعدد الملفات (\" + نسق(\"{}\", الحد_الاقصى_للملفات) + \")\" }\n"
    "    }\n"
    "  }\n"
    "}\n"
    "دالة بصمة(مجلد) {\n"
    "  خل ق = []\n"
    "  _ملفات(مجلد, \"\", ق)\n"
    "  ق = ق.رتب()\n"
    "  خل ب = []\n"
    "  خل حجم = 0\n"
    "  لكل م في ق {\n"
    "    حجم += ملفات.حجم(مجلد + \"/\" + م)\n"
    "    اذا حجم > الحد_الاقصى_للحجم { ارمي \"الحزمة تتجاوز الحد الأقصى للحجم (50 ميغابايت)\" }\n"
    "    ب.اضف(م + \":\" + تشفير.sha256(ملفات.اقرا(مجلد + \"/\" + م)))\n"
    "  }\n"
    "  ارجع تشفير.sha256(ب.ادمج(\"\\n\"))\n"
    "}\n"
    "\n"
    "دالة _مسار_المتجر(معرف, اصدار) { ارجع المتجر + \"/\" + معرف + \"/\" + اصدار }\n"
    "دالة _معرف_كامل(معرف, اصدار) { ارجع معرف + \"@\" + اصدار }\n"
    "دالة _اصدار_من(id) {\n"
    "  خل ق = id.قسم(\"@\")\n"
    "  ارجع ق[طول(ق) - 1]\n"
    "}\n"
    "دالة _معرف_من(id) {\n"
    "  خل ص = _اصدار_من(id)\n"
    "  ارجع id.جزء(0, طول(id) - طول(ص) - 1)\n"
    "}\n"
    "دالة _قصير(س) { ارجع س == عدم ؟ \"\" : (طول(س) > 8 ؟ س.جزء(0, 8) : س) }\n"
    "\n"
    "دالة _اجلب(رابط, مرجع, وجهة_مؤقتة) {\n"
    "  خل وسم_او_فرع = مرجع != \"\" و ليس (طول(مرجع) >= 7 و _ست_عشري(مرجع))\n"
    "  خل اساس = [\"git\", \"-c\", \"advice.detachedHead=false\", \"-c\", \"core.autocrlf=false\", \"-c\", \"core.eol=lf\"]\n"
    "  اذا مرجع == \"\" او وسم_او_فرع {\n"
    "    خل أمر = اساس + [\"clone\", \"-q\", \"--depth\", \"1\"]\n"
    "    اذا مرجع != \"\" { أمر = أمر + [\"--branch\", مرجع] }\n"
    "    أمر = أمر + [\"--\", رابط, وجهة_مؤقتة]\n"
    "    اذا _نفذ(أمر)[\"رمز\"] != 0 { ارمي \"فشل جلب \" + رابط + (مرجع != \"\" ؟ \" (\" + مرجع + \")\" : \"\") }\n"
    "  } والا {\n"
    "    اذا _نفذ(اساس + [\"clone\", \"-q\", \"--\", رابط, وجهة_مؤقتة])[\"رمز\"] != 0 { ارمي \"فشل جلب \" + رابط }\n"
    "    اذا _نفذ([\"git\", \"-C\", وجهة_مؤقتة, \"checkout\", \"-q\", \"--detach\", مرجع])[\"رمز\"] != 0 { ارمي \"الالتزام غير موجود: \" + مرجع }\n"
    "  }\n"
    "  خل ت = _نفذ([\"git\", \"-C\", وجهة_مؤقتة, \"rev-parse\", \"HEAD\"])\n"
    "  اذا ت[\"رمز\"] != 0 { ارمي \"تعذّر قراءة الالتزام\" }\n"
    "  خل التزام = ت[\"ناتج\"].نظف()\n"
    "  _احذف_مجلد(وجهة_مؤقتة + \"/.git\")\n"
    "  ارجع التزام\n"
    "}\n"
    "\n"
    "دالة _قيد_المتجر(معرف, اصدار, رابط, مرجع, التزام_مقفل, بصمة_مقفلة) {\n"
    "  اذا اصدار != \"\" {\n"
    "    خل موجود = _مسار_المتجر(معرف, اصدار)\n"
    "    اذا ملفات.هل_مجلد(موجود) {\n"
    "      خل م = _ميتا(معرف, اصدار)\n"
    "      اذا م != عدم { ارجع {\"التزام\": م[\"التزام\"], \"بصمة\": م[\"بصمة\"], \"اصدار\": اصدار, \"جديد\": غلط} }\n"
    "      ارجع {\"التزام\": التزام_مقفل != عدم ؟ التزام_مقفل : \"غير معروف\", \"بصمة\": بصمة(موجود), \"اصدار\": اصدار, \"جديد\": غلط}\n"
    "    }\n"
    "  }\n"
    "  _انشئ(الكاش)\n"
    "  خل مؤقت = الكاش + \"/جلب\" + نص_عشوائي()\n"
    "  ملفات.احذف_شجرة(مؤقت)\n"
    "  خل نتيجة = عدم\n"
    "  حاول {\n"
    "    خل التزام = _اجلب(رابط, مرجع, مؤقت)\n"
    "    اذا التزام_مقفل != عدم و التزام_مقفل != \"\" و التزام != التزام_مقفل {\n"
    "      ارمي \"الالتزام لا يطابق القفل لـ \" + معرف + \" (المتوقع \" + _قصير(التزام_مقفل) + \"، الفعلي \" + _قصير(التزام) + \")\"\n"
    "    }\n"
    "    خل ب = بصمة(مؤقت)\n"
    "    اذا بصمة_مقفلة != عدم و بصمة_مقفلة != \"\" و ب != بصمة_مقفلة {\n"
    "      ارمي \"عدم تطابق البصمة لـ \" + معرف + \" (تلاعب أو تغيّر المصدر)\"\n"
    "    }\n"
    "    خل نهائي = اصدار != \"\" ؟ اصدار : \"head-\" + التزام.جزء(0, 8)\n"
    "    خل وجهة = _مسار_المتجر(معرف, نهائي)\n"
    "    اذا ملفات.هل_مجلد(وجهة) {\n"
    "      ملفات.احذف_شجرة(مؤقت)\n"
    "      نتيجة = {\"التزام\": التزام, \"بصمة\": ب, \"اصدار\": نهائي, \"جديد\": غلط}\n"
    "    } والا {\n"
    "      ملفات.اكتب(مؤقت + \"/.solan-meta\", جيسون.ترميز({\"التزام\": التزام, \"بصمة\": ب}))\n"
    "      _انشئ(المتجر + \"/\" + معرف)\n"
    "      اذا ليس ملفات.انقل(مؤقت, وجهة) {\n"
    "        اذا ملفات.هل_مجلد(وجهة) { ملفات.احذف_شجرة(مؤقت) } والا { ارمي \"تعذّر نقل الحزمة إلى المتجر\" }\n"
    "      }\n"
    "      نتيجة = {\"التزام\": التزام, \"بصمة\": ب, \"اصدار\": نهائي, \"جديد\": صح}\n"
    "    }\n"
    "  } امسك (خ) {\n"
    "    ملفات.احذف_شجرة(مؤقت)\n"
    "    ارمي خ\n"
    "  }\n"
    "  ارجع نتيجة\n"
    "}\n"
    "\n"
    "دالة _اقرأ_json(مسار, ماذا) {\n"
    "  خل نص = ملفات.اقرا(مسار)\n"
    "  حاول { ارجع جيسون.فك(نص) } امسك (خ) { ارمي ماذا + \" غير صالح (JSON): \" + مسار + \" — \" + خ }\n"
    "}\n"
    "دالة _اقرأ_بيان(مجلد = \".\") {\n"
    "  خل مسار = مجلد + \"/\" + البيان\n"
    "  اذا ليس ملفات.موجود(مسار) { ارمي \"لا يوجد \" + مسار + \" (شغّل: solan init)\" }\n"
    "  خل ب = _اقرأ_json(مسار, البيان)\n"
    "  اذا ليس هل_قاموس(ب) { ارمي البيان + \" يجب أن يكون كائن JSON\" }\n"
    "  ارجع ب\n"
    "}\n"
    "دالة _اعتماديات(بيان) {\n"
    "  خل أ = بيان.احصل(\"الاعتماديات\")\n"
    "  خل ب = بيان.احصل(\"dependencies\")\n"
    "  اذا أ != عدم و ب != عدم { ارمي \"لا يمكن وجود الاعتماديات و dependencies معا في \" + البيان }\n"
    "  خل د = أ != عدم ؟ أ : ب\n"
    "  اذا د == عدم { ارجع {} }\n"
    "  اذا ليس هل_قاموس(د) { ارمي \"الاعتماديات يجب أن تكون كائنا (اسم: مصدر)\" }\n"
    "  لكل اسم، ن في د {\n"
    "    اذا ليس هل_نص(ن) او ن.نظف() == \"\" { ارمي \"قيمة الاعتمادية '\" + اسم + \"' يجب أن تكون نصا غير فارغ\" }\n"
    "  }\n"
    "  ارجع د\n"
    "}\n"
    "دالة _مفتاح_الاعتماديات(بيان) {\n"
    "  اذا بيان.احصل(\"dependencies\") != عدم و بيان.احصل(\"الاعتماديات\") == عدم { ارجع \"dependencies\" }\n"
    "  ارجع \"الاعتماديات\"\n"
    "}\n"
    "دالة _اقرأ_قفل() {\n"
    "  اذا ليس ملفات.موجود(القفل) { ارجع عدم }\n"
    "  خل ق = عدم\n"
    "  حاول { ق = جيسون.فك(ملفات.اقرا(القفل)) } امسك (خ) {\n"
    "    اطبع(\"تنبيه: solan.lock تالف وسيُعاد توليده\")\n"
    "    ارجع عدم\n"
    "  }\n"
    "  اذا ليس هل_قاموس(ق) { ارجع عدم }\n"
    "  خل نسخة = ق.احصل(\"نسخة\")\n"
    "  اذا هل_رقم(نسخة) و نسخة > 2 { ارمي \"solan.lock أحدث من هذه النسخة من سولان (نسخة القفل \" + نسق(\"{}\", نسخة) + \")؛ حدّث سولان\" }\n"
    "  اذا نسخة != 2 او ق.احصل(\"حزم\") == عدم او ق.احصل(\"جذر\") == عدم او ق.احصل(\"مواصفات\") == عدم { ارجع عدم }\n"
    "  ارجع ق\n"
    "}\n"
    "دالة _اكتب_قفل(قفل) { _اكتب_ذري(القفل, جيسون.ترميز(قفل, 2) + \"\\n\") }\n"
    "دالة _اكتب_بيان(بيان) { _اكتب_ذري(البيان, جيسون.ترميز(بيان, 2) + \"\\n\") }\n"
    "\n"
    "دالة _سجل_المشاريع() {\n"
    "  اذا ليس ملفات.موجود(ملف_السجل) { ارجع [] }\n"
    "  حاول {\n"
    "    خل ق = جيسون.فك(ملفات.اقرا(ملف_السجل))\n"
    "    اذا هل_قائمة(ق) { ارجع ق }\n"
    "  } امسك (خ) { }\n"
    "  ارجع []\n"
    "}\n"
    "دالة _سجل(جذر) {\n"
    "  حاول {\n"
    "    خل ق = _سجل_المشاريع()\n"
    "    اذا ق.يحتوي(جذر) { ارجع }\n"
    "    ق.اضف(جذر)\n"
    "    اذا طول(ق) > الحد_الاقصى_للسجل { ق = ق.اقتطع(طول(ق) - الحد_الاقصى_للسجل) }\n"
    "    _انشئ(البيت)\n"
    "    _اكتب_ذري(ملف_السجل, جيسون.ترميز(ق) + \"\\n\")\n"
    "  } امسك (خ) { }\n"
    "}\n"
    "\n"
    "دالة _ثبت_مواصفة(نص, حالة, عمق, اساس_المسار) {\n"
    "  اذا عمق > 16 { ارمي \"عمق الاعتماديات كبير جدا (دورة؟): \" + نص }\n"
    "  اذا طول(حالة[\"حزم\"].مفاتيح()) > الحد_الاقصى_للحزم { ارمي \"عدد الحزم يتجاوز الحد الأقصى (\" + نسق(\"{}\", الحد_الاقصى_للحزم) + \")\" }\n"
    "  خل م = _حلل(نص)\n"
    "  اذا م[\"نوع\"] == \"مسار\" {\n"
    "    اذا عمق > 0 { ارمي \"الاعتماديات المحلية (مسارات) مسموحة لمشروعك الرئيسي فقط وليس داخل حزمة: \" + نص }\n"
    "    خل مسار = م[\"مسار\"]\n"
    "    خل كامل = (مسار.يبدأ_ب(\"/\") او (طول(مسار) > 2 و مسار[1] == \":\")) ؟ مسار : اساس_المسار + \"/\" + مسار\n"
    "    اذا ليس ملفات.هل_مجلد(كامل) { ارمي \"مجلد الاعتمادية المحلية غير موجود: \" + مسار }\n"
    "    خل معرف_محلي = \"محلي:\" + مسار\n"
    "    اذا حالة[\"حزم\"].احصل(معرف_محلي) != عدم { ارجع معرف_محلي }\n"
    "    خل ادخال = {\"مصدر\": نص, \"مسار\": مسار, \"اعتماديات\": {}}\n"
    "    حالة[\"حزم\"][معرف_محلي] = ادخال\n"
    "    اذا ملفات.موجود(كامل + \"/\" + البيان) {\n"
    "      لكل اسم، ن في _اعتماديات(_اقرأ_بيان(كامل)) { ادخال[\"اعتماديات\"][اسم] = _ثبت_مواصفة(ن, حالة, عمق + 1, كامل) }\n"
    "    }\n"
    "    ارجع معرف_محلي\n"
    "  }\n"
    "  خل مفتاح_طلب = نص.نظف()\n"
    "  خل سابق = حالة[\"مفهرس\"].احصل(مفتاح_طلب)\n"
    "  خل معرف = م[\"معرف\"]\n"
    "  خل اصدار = \"\"\n"
    "  خل مرجع = \"\"\n"
    "  خل التزام_مقفل = عدم\n"
    "  خل بصمة_مقفلة = عدم\n"
    "  اذا سابق != عدم {\n"
    "    اصدار = سابق[\"اصدار\"]; مرجع = سابق[\"مرجع\"]; التزام_مقفل = سابق[\"التزام\"]; بصمة_مقفلة = سابق[\"بصمة\"]\n"
    "  } والا اذا م[\"مرجع\"] != \"\" {\n"
    "    مرجع = م[\"مرجع\"]\n"
    "    اصدار = \"ref-\" + (_ست_عشري(مرجع) و طول(مرجع) >= 7 ؟ مرجع.جزء(0, 12) : مرجع.ابدل(\"/\", \"_\"))\n"
    "  } والا {\n"
    "    خل اختيار = عدم\n"
    "    خل بلا_وسوم = غلط\n"
    "    اذا _وضع[\"محلي\"] { اختيار = _اختر(_اصدارات_محلية(معرف), م[\"نطاق\"]) }\n"
    "    اذا اختيار == عدم {\n"
    "      خل وسوم = عدم\n"
    "      حاول { وسوم = _وسوم(م[\"رابط\"]) } امسك (خ) {\n"
    "        اختيار = _اختر(_اصدارات_محلية(معرف), م[\"نطاق\"])\n"
    "        اذا اختيار == عدم { ارمي خ }\n"
    "        اطبع(\"تنبيه: لا اتصال بالمستودع، استُخدم الإصدار المثبت محليا لـ \" + معرف)\n"
    "      }\n"
    "      اذا وسوم != عدم { اختيار = _اختر(وسوم, م[\"نطاق\"]); بلا_وسوم = اختيار == عدم و طول(وسوم) == 0 }\n"
    "    }\n"
    "    اذا اختيار != عدم { اصدار = اختيار[\"نص\"]; مرجع = اختيار[\"وسم\"] }\n"
    "    والا اذا بلا_وسوم و (م[\"نطاق\"] == \"\" او م[\"نطاق\"] == \"latest\" او م[\"نطاق\"] == \"*\") { اصدار = \"\"; مرجع = \"\" }\n"
    "    والا { ارمي \"لا يوجد إصدار يطابق '\" + م[\"نطاق\"] + \"' في \" + معرف }\n"
    "  }\n"
    "  خل نتيجة = _قيد_المتجر(معرف, اصدار, م[\"رابط\"], مرجع, التزام_مقفل, بصمة_مقفلة)\n"
    "  اصدار = نتيجة[\"اصدار\"]\n"
    "  خل id = _معرف_كامل(معرف, اصدار)\n"
    "  اذا حالة[\"حزم\"].احصل(id) != عدم { ارجع id }\n"
    "  خل ادخال = {\"مصدر\": نص, \"رابط\": م[\"رابط\"], \"وسم\": مرجع, \"التزام\": نتيجة[\"التزام\"], \"بصمة\": نتيجة[\"بصمة\"], \"اعتماديات\": {}}\n"
    "  حالة[\"حزم\"][id] = ادخال\n"
    "  حالة[\"مفهرس\"][مفتاح_طلب] = {\"اصدار\": اصدار, \"مرجع\": مرجع, \"التزام\": نتيجة[\"التزام\"], \"بصمة\": نتيجة[\"بصمة\"]}\n"
    "  خل مجلد = _مسار_المتجر(معرف, اصدار)\n"
    "  اذا ملفات.موجود(مجلد + \"/\" + البيان) {\n"
    "    خل بيان_حزمة = _اقرأ_بيان(مجلد)\n"
    "    اذا نتيجة[\"جديد\"] و مرجع.يبدأ_ب(\"v\") {\n"
    "      خل مُعلن = بيان_حزمة.احصل(\"النسخة\") != عدم ؟ بيان_حزمة.احصل(\"النسخة\") : بيان_حزمة.احصل(\"version\")\n"
    "      اذا هل_نص(مُعلن) و _اجزاء(مُعلن) != عدم و _قارن(_اجزاء(مُعلن), _اجزاء(اصدار)) != 0 {\n"
    "        اطبع(\"تنبيه: وسم \" + id + \" لا يطابق النسخة المعلنة داخل solan.json (\" + مُعلن + \")\")\n"
    "      }\n"
    "    }\n"
    "    لكل اسم، ن في _اعتماديات(بيان_حزمة) { ادخال[\"اعتماديات\"][اسم] = _ثبت_مواصفة(ن, حالة, عمق + 1, مجلد) }\n"
    "  }\n"
    "  ارجع id\n"
    "}\n"
    "\n"
    "دالة _ابنِ(بيان, قفل_قديم, تجديد) {\n"
    "  خل حالة = {\"حزم\": {}, \"مفهرس\": {}}\n"
    "  اذا قفل_قديم != عدم {\n"
    "    لكل id، ادخال في قفل_قديم[\"حزم\"] {\n"
    "      اذا ادخال.احصل(\"مسار\") == عدم و هل_نص(ادخال.احصل(\"مصدر\")) {\n"
    "        حالة[\"مفهرس\"][ادخال[\"مصدر\"]] = {\"اصدار\": _اصدار_من(id), \"مرجع\": ادخال[\"وسم\"], \"التزام\": ادخال[\"التزام\"], \"بصمة\": ادخال[\"بصمة\"]}\n"
    "      }\n"
    "    }\n"
    "    اذا تجديد != عدم { لكل ن في تجديد { حالة[\"مفهرس\"].احذف(ن) } }\n"
    "  }\n"
    "  خل جذر = {}\n"
    "  خل مواصفات = {}\n"
    "  لكل اسم، نص في _اعتماديات(بيان) {\n"
    "    _اسم_اعتمادية(اسم)\n"
    "    جذر[اسم] = _ثبت_مواصفة(نص, حالة, 0, \".\")\n"
    "    مواصفات[اسم] = نص\n"
    "  }\n"
    "  ارجع {\"نسخة\": 2, \"جذر\": جذر, \"مواصفات\": مواصفات, \"حزم\": حالة[\"حزم\"]}\n"
    "}\n"
    "\n"
    "دالة ثبت_الكل(مجمد = غلط, صامت = غلط, محلي = غلط) {\n"
    "  _وضع[\"محلي\"] = محلي\n"
    "  خل بيان = _اقرأ_بيان()\n"
    "  خل قديم = _اقرأ_قفل()\n"
    "  خل جذر_المشروع = ملفات.مسار_مطلق(\".\")\n"
    "  اذا مجمد {\n"
    "    اذا قديم == عدم { ارمي \"لا يوجد solan.lock صالح (شغّل: solan install بدون --frozen)\" }\n"
    "    خل د = _اعتماديات(بيان)\n"
    "    لكل اسم، نص في د {\n"
    "      اذا قديم[\"مواصفات\"].احصل(اسم) != نص { ارمي \"solan.json لا يطابق solan.lock عند '\" + اسم + \"' (شغّل: solan install)\" }\n"
    "    }\n"
    "    لكل اسم في قديم[\"مواصفات\"].مفاتيح() {\n"
    "      اذا د.احصل(اسم) == عدم { ارمي \"solan.lock يحتوي اعتمادية '\" + اسم + \"' غير موجودة في solan.json (شغّل: solan install)\" }\n"
    "    }\n"
    "    لكل id، ادخال في قديم[\"حزم\"] {\n"
    "      اذا ادخال.احصل(\"مسار\") != عدم { استمر }\n"
    "      خل اصدار = _اصدار_من(id)\n"
    "      خل معرف = _معرف_من(id)\n"
    "      خل مجلد_موجود = _مسار_المتجر(معرف, اصدار)\n"
    "      اذا ملفات.هل_مجلد(مجلد_موجود) و بصمة(مجلد_موجود) != ادخال[\"بصمة\"] {\n"
    "        اطبع(\"تنبيه: المتجر تالف أو معدَّل لـ \" + id + \"، سيُعاد جلبها\")\n"
    "        _احذف_مجلد(مجلد_موجود)\n"
    "      }\n"
    "      _قيد_المتجر(معرف, اصدار, ادخال[\"رابط\"], ادخال[\"وسم\"] != \"\" ؟ ادخال[\"وسم\"] : ادخال[\"التزام\"], ادخال[\"التزام\"], ادخال[\"بصمة\"])\n"
    "    }\n"
    "    _سجل(جذر_المشروع)\n"
    "    اذا ليس صامت { اطبع(\"تم تثبيت \" + نسق(\"{}\", طول(قديم[\"حزم\"].مفاتيح())) + \" حزمة من القفل\") }\n"
    "    ارجع\n"
    "  }\n"
    "  خل جديد = _ابنِ(بيان, قديم, عدم)\n"
    "  _اكتب_قفل(جديد)\n"
    "  _سجل(جذر_المشروع)\n"
    "  اذا ليس صامت {\n"
    "    لكل اسم، id في جديد[\"جذر\"] { اطبع(\"✓ \" + اسم + \" ← \" + id) }\n"
    "    اطبع(\"تم تثبيت \" + نسق(\"{}\", طول(جديد[\"حزم\"].مفاتيح())) + \" حزمة\")\n"
    "  }\n"
    "}\n"
    "\n"
    "دالة اضف(نص, اسم = عدم) {\n"
    "  خل مصدر = نص\n"
    "  خل اسم_صريح = اسم\n"
    "  خل ي = نص.ابحث(\"=\")\n"
    "  اذا ي > 0 و (نص.ابحث(\"/\") < 0 او ي < نص.ابحث(\"/\")) { اسم_صريح = نص.جزء(0, ي); مصدر = نص.جزء(ي + 1) }\n"
    "  خل م = _حلل(مصدر)\n"
    "  خل بيان = _اقرأ_بيان()\n"
    "  خل اسم_نهائي = اسم_صريح\n"
    "  اذا اسم_نهائي == عدم او اسم_نهائي == \"\" {\n"
    "    اسم_نهائي = م[\"نوع\"] == \"مسار\" ؟ _اسم_افتراضي(م[\"مسار\"].ابدل(\"./\", \"\")) : _اسم_افتراضي(م[\"معرف\"])\n"
    "  }\n"
    "  _اسم_اعتمادية(اسم_نهائي)\n"
    "  خل نص_محفوظ = مصدر\n"
    "  اذا م[\"نوع\"] == \"git\" و م[\"نطاق\"] == \"\" و م[\"مرجع\"] == \"\" {\n"
    "    خل وس = _اختر(_وسوم(م[\"رابط\"]), \"\")\n"
    "    اذا وس != عدم { نص_محفوظ = مصدر + \"@^\" + وس[\"نص\"] }\n"
    "  }\n"
    "  خل مفتاح = _مفتاح_الاعتماديات(بيان)\n"
    "  اذا بيان.احصل(مفتاح) == عدم { بيان[مفتاح] = {} }\n"
    "  خل نص_قديم = بيان[مفتاح].احصل(اسم_نهائي)\n"
    "  خل موجودة = نص_قديم != عدم\n"
    "  بيان[مفتاح][اسم_نهائي] = نص_محفوظ\n"
    "  _اكتب_بيان(بيان)\n"
    "  اطبع((موجودة ؟ \"حُدّثت '\" : \"أُضيفت '\") + اسم_نهائي + \"' ← \" + نص_محفوظ)\n"
    "  حاول { ثبت_الكل() } امسك (خ) {\n"
    "    خل بيان2 = _اقرأ_بيان()\n"
    "    اذا موجودة { بيان2[مفتاح][اسم_نهائي] = نص_قديم } والا { بيان2[مفتاح].احذف(اسم_نهائي) }\n"
    "    _اكتب_بيان(بيان2)\n"
    "    ارمي خ\n"
    "  }\n"
    "}\n"
    "\n"
    "دالة احذف(اسم) {\n"
    "  خل بيان = _اقرأ_بيان()\n"
    "  خل مفتاح = _مفتاح_الاعتماديات(بيان)\n"
    "  خل د = _اعتماديات(بيان)\n"
    "  اذا د.احصل(اسم) == عدم { ارمي \"الاعتمادية '\" + اسم + \"' غير موجودة في \" + البيان }\n"
    "  د.احذف(اسم)\n"
    "  بيان[مفتاح] = د\n"
    "  _اكتب_بيان(بيان)\n"
    "  خل جديد = _ابنِ(بيان, _اقرأ_قفل(), عدم)\n"
    "  _اكتب_قفل(جديد)\n"
    "  اطبع(\"أُزيلت '\" + اسم + \"' (تبقى النسخة في المتجر المشترك ولا تتأثر بها المشاريع الأخرى؛ للتنظيف: solan prune)\")\n"
    "}\n"
    "\n"
    "دالة حدّث(اسم = عدم, رئيسي = غلط) {\n"
    "  _وضع[\"محلي\"] = غلط\n"
    "  خل بيان = _اقرأ_بيان()\n"
    "  خل مفتاح = _مفتاح_الاعتماديات(بيان)\n"
    "  خل د = _اعتماديات(بيان)\n"
    "  اذا اسم != عدم و د.احصل(اسم) == عدم { ارمي \"الاعتمادية '\" + اسم + \"' غير موجودة في \" + البيان }\n"
    "  خل قديم = _اقرأ_قفل()\n"
    "  خل اهداف = اسم != عدم ؟ [اسم] : د.مفاتيح()\n"
    "  خل مواصفات_مجددة = []\n"
    "  لكل ه في اهداف {\n"
    "    اذا رئيسي {\n"
    "      خل م = _حلل(د[ه])\n"
    "      اذا م[\"نوع\"] == \"git\" و م[\"مرجع\"] == \"\" {\n"
    "        خل وس = _اختر(_وسوم(م[\"رابط\"]), \"\")\n"
    "        اذا وس != عدم {\n"
    "          خل اساس = د[ه]\n"
    "          خل ي = اساس.اعكس().ابحث(\"@\")\n"
    "          خل موضع = طول(اساس) - 1 - ي\n"
    "          اذا ي >= 0 و موضع > اساس.اعكس().ابحث(\"/\") { اساس = اساس.جزء(0, موضع) }\n"
    "          د[ه] = اساس + \"@^\" + وس[\"نص\"]\n"
    "        }\n"
    "      }\n"
    "    }\n"
    "    مواصفات_مجددة.اضف(د[ه])\n"
    "  }\n"
    "  اذا رئيسي { بيان[مفتاح] = د; _اكتب_بيان(بيان) }\n"
    "  خل جديد = _ابنِ(بيان, قديم, مواصفات_مجددة)\n"
    "  _اكتب_قفل(جديد)\n"
    "  خل تغيّر = 0\n"
    "  لكل ه، id في جديد[\"جذر\"] {\n"
    "    خل قبل = قديم != عدم ؟ قديم[\"جذر\"].احصل(ه) : عدم\n"
    "    اذا قبل != id { اطبع(\"↑ \" + ه + \": \" + (قبل == عدم ؟ \"جديد\" : قبل) + \" ← \" + id); تغيّر += 1 }\n"
    "  }\n"
    "  اذا تغيّر == 0 { اطبع(\"كل شيء محدّث\") }\n"
    "}\n"
    "\n"
    "دالة _مثبتة(id, ادخال) {\n"
    "  اذا ادخال.احصل(\"مسار\") != عدم { ارجع ملفات.هل_مجلد(ادخال[\"مسار\"]) }\n"
    "  ارجع ملفات.هل_مجلد(_مسار_المتجر(_معرف_من(id), _اصدار_من(id)))\n"
    "}\n"
    "دالة _مسح_المتجر(مجلد, نسبي, خارج) {\n"
    "  اذا ليس ملفات.هل_مجلد(مجلد) { ارجع }\n"
    "  لكل س في ملفات.قائمة(مجلد) {\n"
    "    خل مسار = مجلد + \"/\" + س\n"
    "    اذا ليس ملفات.هل_مجلد(مسار) { استمر }\n"
    "    خل ن = نسبي == \"\" ؟ س : نسبي + \"/\" + س\n"
    "    اذا ملفات.موجود(مسار + \"/.solan-meta\") { خارج.اضف(ن.جزء(0, طول(ن) - طول(س) - 1) + \"@\" + س) } والا { _مسح_المتجر(مسار, ن, خارج) }\n"
    "  }\n"
    "}\n"
    "دالة اعرض(شجرة = غلط, مخزن = غلط) {\n"
    "  اذا مخزن {\n"
    "    خل خارج = []\n"
    "    _مسح_المتجر(المتجر, \"\", خارج)\n"
    "    اذا طول(خارج) == 0 { اطبع(\"المتجر فارغ (\" + المتجر + \")\"); ارجع }\n"
    "    لكل ح في خارج.رتب() { اطبع(ح) }\n"
    "    اطبع(\"— \" + نسق(\"{}\", طول(خارج)) + \" حزمة في \" + المتجر)\n"
    "    ارجع\n"
    "  }\n"
    "  خل بيان = _اقرأ_بيان()\n"
    "  خل قفل = _اقرأ_قفل()\n"
    "  خل د = _اعتماديات(بيان)\n"
    "  اذا طول(د.مفاتيح()) == 0 { اطبع(\"لا توجد اعتماديات\"); ارجع }\n"
    "  لكل اسم، نص في د {\n"
    "    خل id = قفل != عدم ؟ قفل[\"جذر\"].احصل(اسم) : عدم\n"
    "    اذا id == عدم { اطبع(اسم + \" ← \" + نص + \"  (غير مثبتة: شغّل solan install)\"); استمر }\n"
    "    خل ادخال = قفل[\"حزم\"][id]\n"
    "    اطبع(اسم + \" ← \" + id + (_مثبتة(id, ادخال) ؟ \"\" : \"  ✗ مفقودة من المتجر\"))\n"
    "    اذا شجرة { _اطبع_فروع(قفل, id, \"  \", {}) }\n"
    "  }\n"
    "}\n"
    "دالة _اطبع_فروع(قفل, id, بادئة, مرئي) {\n"
    "  خل ادخال = قفل[\"حزم\"].احصل(id)\n"
    "  اذا ادخال == عدم او مرئي.احصل(id) != عدم { ارجع }\n"
    "  مرئي[id] = صح\n"
    "  لكل ن، ابن في ادخال[\"اعتماديات\"] {\n"
    "    اطبع(بادئة + \"└ \" + ن + \" ← \" + ابن)\n"
    "    _اطبع_فروع(قفل, ابن, بادئة + \"  \", مرئي)\n"
    "  }\n"
    "}\n"
    "\n"
    "دالة لماذا(اسم) {\n"
    "  خل قفل = _اقرأ_قفل()\n"
    "  اذا قفل == عدم { ارمي \"لا يوجد solan.lock صالح (شغّل: solan install)\" }\n"
    "  خل اهداف = []\n"
    "  لكل id في قفل[\"حزم\"].مفاتيح() { اذا id.صغير().يحتوي(اسم.صغير()) { اهداف.اضف(id) } }\n"
    "  لكل ن، id في قفل[\"جذر\"] { اذا ن == اسم و ليس اهداف.يحتوي(id) { اهداف.اضف(id) } }\n"
    "  اذا طول(اهداف) == 0 { ارمي \"لا توجد حزمة تطابق '\" + اسم + \"' في القفل\" }\n"
    "  لكل ه في اهداف {\n"
    "    اطبع(ه)\n"
    "    خل وجد = غلط\n"
    "    لكل ن، id في قفل[\"جذر\"] { اذا id == ه { اطبع(\"  ← مطلوبة مباشرة من مشروعك باسم '\" + ن + \"'\"); وجد = صح } }\n"
    "    لكل p، ادخال في قفل[\"حزم\"] {\n"
    "      لكل ن، ابن في ادخال[\"اعتماديات\"] { اذا ابن == ه { اطبع(\"  ← يطلبها \" + p + \" باسم '\" + ن + \"'\"); وجد = صح } }\n"
    "    }\n"
    "    اذا ليس وجد { اطبع(\"  (يتيمة: غير مطلوبة من أي حزمة)\") }\n"
    "  }\n"
    "}\n"
    "\n"
    "دالة قديمة() {\n"
    "  _وضع[\"محلي\"] = غلط\n"
    "  خل بيان = _اقرأ_بيان()\n"
    "  خل قفل = _اقرأ_قفل()\n"
    "  خل د = _اعتماديات(بيان)\n"
