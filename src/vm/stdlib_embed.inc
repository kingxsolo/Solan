    "    والا اذا ت == \"--\" { انتهت = صح }\n"
    "    والا اذا ت.يبدأ_ب(\"--\") {\n"
    "      خل اسم = ت.جزء(2); خل قيمة = عدم\n"
    "      اذا اسم.يحتوي(\"=\") { خل ج = اسم.قسم(\"=\"); اسم = ج[0]; قيمة = ج.جزء(1).ادمج(\"=\") }\n"
    "      اذا اسم.يبدأ_ب(\"no-\") و مواصفات.احصل(اسم) == عدم و مواصفات.احصل(اسم.جزء(3)) != عدم {\n"
    "        خيارات[اسم.جزء(3)] = غلط\n"
    "      }\n"
    "      والا اذا اسم.يبدأ_ب(\"بلا-\") و مواصفات.احصل(اسم) == عدم و مواصفات.احصل(اسم.جزء(4)) != عدم {\n"
    "        خيارات[اسم.جزء(4)] = غلط\n"
    "      }\n"
    "      والا { اضبط(اسم, قيمة, ت) }\n"
    "    }\n"
    "    والا {\n"
    "      خل حروف = ت.جزء(1).حروف()\n"
    "      لكل ك في مدى(حروف.طول) {\n"
    "        خل ح = حروف[ك]\n"
    "        خل اسم = بحث_اختصار(ح)\n"
    "        اذا اسم == عدم {\n"
    "          اذا مواصفات.طول > 0 { مجهولة.اضف(\"-\" + ح) }\n"
    "          خيارات[ح] = صح\n"
    "          استمر\n"
    "        }\n"
    "        خل ن = _نوع(مواصفات[اسم])\n"
    "        اذا _يأخذ_قيمة(ن) {\n"
    "          خل باقي = حروف.جزء(ك + 1).ادمج(\"\")\n"
    "          اضبط(اسم, باقي != \"\" ؟ باقي : عدم, ت)\n"
    "          توقف\n"
    "        }\n"
    "        اضبط(اسم, عدم, ت)\n"
    "      }\n"
    "    }\n"
    "    ي += 1\n"
    "  }\n"
    "  لكل اسم، م في مواصفات {\n"
    "    اذا هل_قاموس(م) {\n"
    "      خل بيئة = م.احصل(\"بيئة\")\n"
    "      اذا بيئة != عدم و ليس (اسم في خيارات) او (بيئة != عدم و خيارات[اسم] == م.احصل(\"افتراضي\") و نظام.بيئة(بيئة) != عدم) {\n"
    "        خل خام = نظام.بيئة(بيئة)\n"
    "        اذا خام != عدم { خيارات[اسم] = _حول(_نوع(م), خام, اسم, اخطاء) }\n"
    "      }\n"
    "      خل ق = خيارات.احصل(اسم)\n"
    "      اذا م.احصل(\"مطلوب\", غلط) و (ق == عدم او ق == []) { اخطاء.اضف(\"الخيار --${اسم} مطلوب\") }\n"
    "      خل ك = م.احصل(\"اختيارات\")\n"
    "      اذا ك != عدم و ق != عدم و ليس (ق في ك) و _نوع(م) != \"قائمة\" {  خل مسموح = ك.ادمج(\"، \"); اخطاء.اضف(\"قيمة غير مسموحة للخيار --${اسم}: ${ق} (المسموح: ${مسموح})\") }\n"
    "    }\n"
    "  }\n"
    "  ارجع {\"خيارات\": خيارات, \"موضعية\": موضعية, \"اخطاء\": اخطاء, \"مجهولة\": مجهولة}\n"
    "}\n"
    "\n"
    "دالة مساعدة(مواصفات, عنوان = \"الخيارات\") {\n"
    "  خل س = [عنوان + \":\"]\n"
    "  لكل اسم، م في مواصفات {\n"
    "    خل ا = (هل_قاموس(م) و م.احصل(\"اختصار\") != عدم) ؟ \"-\" + م[\"اختصار\"] + \", \" : \"    \"\n"
    "    خل ن = _نوع(م)\n"
    "    خل وص = هل_قاموس(م) ؟ م.احصل(\"وصف\", \"\") : \"\"\n"
    "    خل اضافات = []\n"
    "    اذا هل_قاموس(م) و م.احصل(\"افتراضي\") != عدم { اضافات.اضف(\"افتراضي: \" + نسق(\"{}\", م[\"افتراضي\"])) }\n"
    "    اذا هل_قاموس(م) و م.احصل(\"مطلوب\", غلط) { اضافات.اضف(\"مطلوب\") }\n"
    "    اذا هل_قاموس(م) و م.احصل(\"اختيارات\") != عدم { اضافات.اضف(\"من: \" + م[\"اختيارات\"].ادمج(\"|\")) }\n"
    "    اذا هل_قاموس(م) و م.احصل(\"بيئة\") != عدم { اضافات.اضف(\"بيئة: \" + م[\"بيئة\"]) }\n"
    "    خل نوع_نص = _يأخذ_قيمة(ن) ؟ \" <\" + ن + \">\" : \"\"\n"
    "    خل ذيل = اضافات.طول > 0 ؟ \" (\" + اضافات.ادمج(\"، \") + \")\" : \"\"\n"
    "    س.اضف(نسق(\"  {}--{:<18} {}{}\", ا, اسم + نوع_نص, وص, ذيل))\n"
    "  }\n"
    "  ارجع س.ادمج(\"\\n\")\n"
    "}\n"
    "\n"
    "دالة حلل_او_اخرج(قائمة, مواصفات = {}, وصف = \"\", امر_اسم = \"\") {\n"
    "  خل ر = حلل(قائمة, مواصفات)\n"
    "  خل ع = ر[\"خيارات\"]\n"
    "  اذا ع.احصل(\"help\") == صح او ع.احصل(\"مساعدة\") == صح او ع.احصل(\"h\") == صح {\n"
    "    اذا وصف != \"\" { اطبع(وصف); اطبع() }\n"
    "    اطبع(مساعدة(مواصفات))\n"
    "    نظام.اخرج(0)\n"
    "  }\n"
    "  خل ك = ر[\"اخطاء\"].انسخ()\n"
    "  لكل م في ر[\"مجهولة\"] { ك.اضف(\"خيار غير معروف: ${م}\") }\n"
    "  اذا ك.طول > 0 {\n"
    "    لكل ق في ك { اطبع(\"خطأ: \" + ق) }\n"
    "    اطبع()\n"
    "    اطبع(مساعدة(مواصفات))\n"
    "    نظام.اخرج(2)\n"
    "  }\n"
    "  ارجع ر\n"
    "}\n"
    "\n"
    "دالة حلل_اوامر(قائمة, اوامر, عام = {}) {\n"
    "  خل اولي = حلل(قائمة, عام)\n"
    "  خل اسم = عدم\n"
    "  اذا اولي[\"موضعية\"].طول > 0 و اولي[\"موضعية\"][0] في اوامر { اسم = اولي[\"موضعية\"][0] }\n"
    "  خل مواصفات = {}\n"
    "  لكل ك، ق في عام { مواصفات[ك] = ق }\n"
    "  اذا اسم != عدم {\n"
    "    خل خاص = اوامر[اسم].احصل(\"خيارات\", {})\n"
    "    لكل ك، ق في خاص { مواصفات[ك] = ق }\n"
    "  }\n"
    "  خل ر = حلل(قائمة, مواصفات)\n"
    "  اذا اسم != عدم { ر[\"موضعية\"] = ر[\"موضعية\"].جزء(1) }\n"
    "  ر[\"امر\"] = اسم\n"
    "  ارجع ر\n"
    "}\n"
    "\n"
    "دالة مساعدة_اوامر(اوامر, عام = {}, برنامج = \"\") {\n"
    "  خل س = []\n"
    "  اذا برنامج != \"\" { س.اضف(\"الاستعمال: \" + برنامج + \" <امر> [خيارات]\"); س.اضف(\"\") }\n"
    "  س.اضف(\"الأوامر:\")\n"
    "  لكل اسم، م في اوامر { س.اضف(نسق(\"  {:<14} {}\", اسم, م.احصل(\"وصف\", \"\"))) }\n"
    "  اذا عام.طول > 0 { س.اضف(\"\"); س.اضف(مساعدة(عام, \"خيارات عامة\")) }\n"
    "  ارجع س.ادمج(\"\\n\")\n"
    "}\n"},
  {NULL, NULL}};
