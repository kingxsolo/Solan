  {"ذاكرة",
    "استورد \"زمن\"\n"
    "\n"
    "صنف ذاكرة_مؤقتة {\n"
    "  بناء(سعة = 0, عمر = 0) {\n"
    "    هذا._سعة = سعة; هذا._عمر = عمر; هذا._د = {}\n"
    "    هذا.اصابات = 0; هذا.اخفاقات = 0\n"
    "  }\n"
    "  _ك(مفتاح) { ارجع نوع(مفتاح) + \":\" + نسق(\"{}\", مفتاح) }\n"
    "  _منتهية(مدخل) { ارجع مدخل[\"حتى\"] != عدم و زمن.ساعة() >= مدخل[\"حتى\"] }\n"
    "  ضع(مفتاح, قيمة, عمر = عدم) {\n"
    "    خل ك = هذا._ك(مفتاح)\n"
    "    اذا ك في هذا._د { هذا._د.احذف(ك) }\n"
    "    خل ع = عمر == عدم ؟ هذا._عمر : عمر\n"
    "    هذا._د[ك] = {\"م\": مفتاح, \"ق\": قيمة, \"حتى\": ع > 0 ؟ زمن.ساعة() + ع : عدم}\n"
    "    اذا هذا._سعة > 0 و هذا._د.طول > هذا._سعة {\n"
    "      لكل س في هذا._د.مفاتيح() { هذا._د.احذف(س); توقف }\n"
    "    }\n"
    "    ارجع قيمة\n"
    "  }\n"
    "  خذ(مفتاح, افتراضي = عدم) {\n"
    "    خل ك = هذا._ك(مفتاح)\n"
    "    خل م = هذا._د.احصل(ك)\n"
    "    اذا م == عدم { هذا.اخفاقات += 1; ارجع افتراضي }\n"
    "    اذا هذا._منتهية(م) { هذا._د.احذف(ك); هذا.اخفاقات += 1; ارجع افتراضي }\n"
    "    هذا._د.احذف(ك)\n"
    "    هذا._د[ك] = م\n"
    "    هذا.اصابات += 1\n"
    "    ارجع م[\"ق\"]\n"
    "  }\n"
    "  يوجد(مفتاح) {\n"
    "    خل م = هذا._د.احصل(هذا._ك(مفتاح))\n"
    "    ارجع م != عدم و ليس هذا._منتهية(م)\n"
    "  }\n"
    "  احذف(مفتاح) { خل ك = هذا._ك(مفتاح); اذا ك في هذا._د { هذا._د.احذف(ك) } ارجع هذا }\n"
    "  امسح() { هذا._د = {}; ارجع هذا }\n"
    "  نظف() {\n"
    "    لكل ك في هذا._د.مفاتيح() { اذا هذا._منتهية(هذا._د[ك]) { هذا._د.احذف(ك) } }\n"
    "    ارجع هذا._د.طول\n"
    "  }\n"
    "  حجم() { ارجع هذا.نظف() }\n"
    "  مفاتيح() { هذا.نظف(); ارجع هذا._د.قيم().حول((م) => م[\"م\"]) }\n"
    "  احسب(مفتاح, ف, عمر = عدم) {\n"
    "    اذا هذا.يوجد(مفتاح) { ارجع هذا.خذ(مفتاح) }\n"
    "    ارجع هذا.ضع(مفتاح, ف(), عمر)\n"
    "  }\n"
    "  احصائيات() {\n"
    "    خل م = هذا.اصابات + هذا.اخفاقات\n"
    "    ارجع {\"اصابات\": هذا.اصابات, \"اخفاقات\": هذا.اخفاقات, \"نسبة_الاصابة\": م == 0 ؟ 0 : هذا.اصابات / م, \"حجم\": هذا.حجم()}\n"
    "  }\n"
    "}\n"
    "دالة جديد(سعة = 0, عمر = 0) { ارجع ذاكرة_مؤقتة(سعة, عمر) }\n"
    "دالة احفظ_نتيجة(ف, عمر = 0, سعة = 0) {\n"
    "  خل ذ = ذاكرة_مؤقتة(سعة, عمر)\n"
    "  ارجع دالة(...وسائط) {\n"
    "    ارجع ذ.احسب(وسائط, () => ف(...وسائط))\n"
    "  }\n"
    "}\n"},
