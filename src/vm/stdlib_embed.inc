    "دالة معلومة(...ق) { _اكتب(20, _افتراضي, ق) }\n"
    "دالة تحذير(...ق) { _اكتب(30, _افتراضي, ق) }\n"
    "دالة خطأ(...ق) { _اكتب(40, _افتراضي, ق) }\n"
    "دالة حرج(...ق) { _اكتب(50, _افتراضي, ق) }\n"},
  {"عرض",
    "استورد \"رياضيات\"\n"
    "\n"
    "دالة _مطلق(س) { ارجع س < 0 ؟ -س : س }\n"
    "\n"
    "دالة ارقام_مفصولة(ن, فاصل = \",\", عشري = عدم) {\n"
    "  خل نص_رقم = عشري == عدم ؟ نسق(\"{}\", _مطلق(ن)) : نسق(\"{:.\" + نص(عشري) + \"f}\", _مطلق(ن))\n"
    "  اذا نص_رقم.يحتوي(\"e\") { ارجع نسق(\"{}\", ن) }\n"
    "  خل اجزاء = نص_رقم.قسم(\".\")\n"
    "  خل جز_اول = اجزاء[0]; خل خ = []\n"
    "  خل ي = جز_اول.طول\n"
    "  طالما ي > 0 {\n"
    "    خل ب = ي - 3\n"
    "    اذا ب < 0 { ب = 0 }\n"
    "    خ.اضف(جز_اول.جزء(ب, ي))\n"
    "    ي = ب\n"
    "  }\n"
    "  خل ناتج = خ.اعكس().ادمج(فاصل)\n"
    "  اذا اجزاء.طول > 1 { ناتج += \".\" + اجزاء[1] }\n"
    "  ارجع (ن < 0 ؟ \"-\" : \"\") + ناتج\n"
    "}\n"
    "\n"
    "دالة حجم_ملف(بايت, عشري = 1, عربي = غلط) {\n"
    "  خل وحدات = عربي ؟ [\"بايت\", \"ك.ب\", \"م.ب\", \"ج.ب\", \"ت.ب\", \"ب.ب\"] : [\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\"]\n"
    "  خل ق = _مطلق(بايت); خل ي = 0\n"
    "  طالما ق >= 1024 و ي < وحدات.طول - 1 { ق = ق / 1024; ي += 1 }\n"
    "  اذا ي == 0 { ارجع نسق(\"{} {}\", بايت, وحدات[0]) }\n"
    "  ارجع نسق(\"{:.\" + نص(عشري) + \"f} {}\", (بايت < 0 ؟ -ق : ق), وحدات[ي])\n"
    "}\n"
    "\n"
    "دالة نسبة(ق, عشري = 1) { ارجع نسق(\"{:.\" + نص(عشري) + \"f}%\", ق * 100) }\n"
    "دالة عملة(ق, رمز = \"\", عشري = 2) {\n"
    "  خل ن = ارقام_مفصولة(ق, \",\", عشري)\n"
    "  ارجع رمز == \"\" ؟ ن : ن + \" \" + رمز\n"
    "}\n"
    "\n"
    "دالة عدد_معدود(ن, مفرد, مثنى, جمع, كثير = عدم) {\n"
    "  خل ك = كثير == عدم ؟ مفرد : كثير\n"
    "  اذا ن == 1 { ارجع مفرد }\n"
    "  اذا ن == 2 { ارجع مثنى }\n"
    "  اذا ن == 0 { ارجع \"0 \" + جمع }\n"
    "  خل م = ن % 100\n"
    "  اذا م >= 3 و م <= 10 { ارجع نسق(\"{} {}\", ن, جمع) }\n"
    "  ارجع نسق(\"{} {}\", ن, ك)\n"
    "}\n"
    "\n"
    "خل _وحدات_زمن = [\n"
    "  [\"يوم\", \"يومان\", \"ايام\", \"يوما\", 86400],\n"
    "  [\"ساعة\", \"ساعتان\", \"ساعات\", \"ساعة\", 3600],\n"
    "  [\"دقيقة\", \"دقيقتان\", \"دقائق\", \"دقيقة\", 60],\n"
    "  [\"ثانية\", \"ثانيتان\", \"ثوان\", \"ثانية\", 1]\n"
    "]\n"
    "دالة مدة(ثواني, حد = 2) {\n"
    "  خل ق = رياضيات.ارضي(_مطلق(ثواني)); خل اجزاء = []\n"
    "  لكل وح في _وحدات_زمن {\n"
    "    خل ع = رياضيات.ارضي(ق / وح[4])\n"
    "    اذا ع > 0 و اجزاء.طول < حد {\n"
    "      اجزاء.اضف(عدد_معدود(ع, وح[0], وح[1], وح[2], وح[3]))\n"
    "      ق -= ع * وح[4]\n"
    "    }\n"
    "  }\n"
    "  اذا اجزاء.طول == 0 { ارجع \"0 ثانية\" }\n"
    "  ارجع اجزاء.ادمج(\" و \")\n"
    "}\n"
    "دالة مدة_قصيرة(ثواني) {\n"
    "  خل ق = رياضيات.ارضي(_مطلق(ثواني)); خل ج = []\n"
    "  لكل ز في [[\"d\", 86400], [\"h\", 3600], [\"m\", 60], [\"s\", 1]] {\n"
    "    خل ع = رياضيات.ارضي(ق / ز[1])\n"
    "    اذا ع > 0 { ج.اضف(نص(ع) + ز[0]); ق -= ع * ز[1] }\n"
    "  }\n"
    "  ارجع ج.طول == 0 ؟ \"0s\" : ج.ادمج(\" \")\n"
    "}\n"
    "\n"
    "خل _احاد = [\"\", \"واحد\", \"اثنان\", \"ثلاثة\", \"أربعة\", \"خمسة\", \"ستة\", \"سبعة\", \"ثمانية\", \"تسعة\", \"عشرة\", \"أحد عشر\", \"اثنا عشر\", \"ثلاثة عشر\", \"أربعة عشر\", \"خمسة عشر\", \"ستة عشر\", \"سبعة عشر\", \"ثمانية عشر\", \"تسعة عشر\"]\n"
    "خل _عشرات = [\"\", \"\", \"عشرون\", \"ثلاثون\", \"أربعون\", \"خمسون\", \"ستون\", \"سبعون\", \"ثمانون\", \"تسعون\"]\n"
    "خل _مئات = [\"\", \"مئة\", \"مئتان\", \"ثلاثمئة\", \"أربعمئة\", \"خمسمئة\", \"ستمئة\", \"سبعمئة\", \"ثمانمئة\", \"تسعمئة\"]\n"
    "خل _مقاييس = [[\"\", \"\", \"\", \"\"], [\"ألف\", \"ألفان\", \"آلاف\", \"ألف\"], [\"مليون\", \"مليونان\", \"ملايين\", \"مليون\"], [\"مليار\", \"ملياران\", \"مليارات\", \"مليار\"], [\"ترليون\", \"ترليونان\", \"ترليونات\", \"ترليون\"]]\n"
    "\n"
    "دالة _مجموعة(ن) {\n"
    "  خل م = رياضيات.ارضي(ن / 100); خل ب = ن % 100; خل ق = []\n"
    "  اذا م > 0 { ق.اضف(_مئات[م]) }\n"
    "  اذا ب > 0 {\n"
    "    اذا ب < 20 { ق.اضف(_احاد[ب]) }\n"
    "    والا {\n"
    "      خل ف = ب % 10\n"
    "      اذا ف > 0 { ق.اضف(_احاد[ف] + \" و\" + _عشرات[رياضيات.ارضي(ب / 10)]) } والا { ق.اضف(_عشرات[رياضيات.ارضي(ب / 10)]) }\n"
    "    }\n"
    "  }\n"
    "  ارجع ق.ادمج(\" و\")\n"
    "}\n"
    "دالة عدد_بالحروف(ن) {\n"
    "  خل ق = رياضيات.قرب(ن)\n"
    "  اذا ق == 0 { ارجع \"صفر\" }\n"
    "  خل سالب = ق < 0\n"
    "  ق = _مطلق(ق)\n"
    "  خل مجموعات = []\n"
    "  طالما ق > 0 { مجموعات.اضف(ق % 1000); ق = رياضيات.ارضي(ق / 1000) }\n"
    "  اذا مجموعات.طول > _مقاييس.طول { ارمي \"العدد كبير جدا\" }\n"
    "  خل اجزاء = []\n"
    "  لكل ي في مدى(مجموعات.طول - 1, -1, -1) {\n"
    "    خل ع = مجموعات[ي]\n"
    "    اذا ع == 0 { استمر }\n"
    "    خل م = _مقاييس[ي]\n"
    "    اذا ي == 0 { اجزاء.اضف(_مجموعة(ع)) }\n"
    "    والا اذا ع == 1 { اجزاء.اضف(م[0]) }\n"
    "    والا اذا ع == 2 { اجزاء.اضف(م[1]) }\n"
    "    والا اذا ع >= 3 و ع <= 10 { اجزاء.اضف(_مجموعة(ع) + \" \" + م[2]) }\n"
    "    والا { اجزاء.اضف(_مجموعة(ع) + \" \" + م[3]) }\n"
    "  }\n"
    "  خل ناتج = اجزاء.ادمج(\" و\")\n"
    "  ارجع سالب ؟ \"سالب \" + ناتج : ناتج\n"
    "}\n"},
  {"عمال",
    "استورد \"نظام\"\n"
    "استورد \"سوكت\"\n"
    "استورد \"جيسون\"\n"
    "استورد \"حلقة\"\n"
    "\n"
    "خل _مفتوحة = []\n"
    "\n"
    "دالة _ارسل(م, قيمة) { سوكت.ارسل(م, جيسون.ترميز(قيمة) + \"\\n\") }\n"
    "دالة _اقرأ(م) {\n"
    "  خل س = سوكت.سطر(م)\n"
    "  اذا س == عدم { ارجع عدم }\n"
    "  ارجع جيسون.فك(س)\n"
    "}\n"
    "\n"
    "صنف قناة {\n"
    "  بناء(م) { هذا.م = م }\n"
    "  ارسل(رسالة) { _ارسل(هذا.م, رسالة) }\n"
    "  استقبل() { ارجع _اقرأ(هذا.م) }\n"
    "}\n"
    "\n"
    "صنف عامل {\n"
    "  بناء(م, pid) {\n"
    "    هذا.م = م\n"
    "    هذا.pid = pid\n"
    "    هذا.حي = صح\n"
    "    هذا._رقم = 0\n"
    "    هذا._معلق = {}\n"
    "    هذا._عند = عدم\n"
    "    هذا._يراقب = غلط\n"
    "  }\n"
    "  ارسل(رسالة) { _ارسل(هذا.م, رسالة) }\n"
    "  استقبل() { ارجع _اقرأ(هذا.م) }\n"
    "  عند_رسالة(ف) { هذا._عند = ف; هذا._راقب() }\n"
    "  اطلب(رسالة) {\n"
    "    هذا._رقم += 1\n"
    "    خل ر = هذا._رقم\n"
    "    خل وع = وعد()\n"
    "    هذا._معلق[نص(ر)] = وع\n"
    "    _ارسل(هذا.م, {\"ر\": ر, \"ب\": رسالة})\n"
    "    هذا._راقب()\n"
    "    ارجع وع\n"
    "  }\n"
    "  _راقب() {\n"
    "    اذا هذا._يراقب { ارجع }\n"
    "    هذا._يراقب = صح\n"
    "    خل ذا = هذا\n"
    "    حلقة.راقب(هذا.م, دالة(م) {\n"
    "      خل ر = _اقرأ(م)\n"
    "      اذا ر == عدم {\n"
    "        حلقة.الغ_مراقبة(م); ذا._يراقب = غلط; ذا.حي = غلط\n"
    "        لكل ك في ذا._معلق.مفاتيح() { ذا._معلق[ك].ارفض(\"انتهى العامل قبل الرد\") }\n"
    "        ذا._معلق = {}\n"
    "        ارجع\n"
    "      }\n"
    "      اذا ر.احصل(\"ر\") != عدم {\n"
    "        خل ك = نص(ر[\"ر\"])\n"
    "        خل وع = ذا._معلق[ك]\n"
    "        اذا وع != عدم {\n"
    "          ذا._معلق[ك] = عدم\n"
    "          اذا ر.احصل(\"خطأ\") != عدم { وع.ارفض(ر[\"خطأ\"]) } والا { وع.حل(ر.احصل(\"قيمة\")) }\n"
    "        }\n"
    "      } والا اذا ذا._عند { ذا._عند(ر) }\n"
    "    })\n"
    "  }\n"
    "  انهِ() {\n"
    "    اذا ليس هذا.حي { ارجع }\n"
    "    هذا.حي = غلط\n"
    "    حاول { حلقة.الغ_مراقبة(هذا.م) } امسك (خ) { }\n"
    "    خل م = هذا.م\n"
    "    _مفتوحة = _مفتوحة.رشح((ق) => ق != م)\n"
    "    سوكت.اغلق(هذا.م)\n"
    "    حاول { نظام.اقتل(هذا.pid) } امسك (خ) { }\n"
    "    نظام.انتظر_عملية(هذا.pid)\n"
    "  }\n"
    "}\n"
    "\n"
    "دالة انشئ(ف) {\n"
    "  خل قدامى = _مفتوحة.انسخ()\n"
    "  خل ع = نظام.عامل(دالة(م) {\n"
    "    لكل ق في قدامى { حاول { سوكت.اغلق(ق) } امسك (خ) { } }\n"
    "    ف(قناة(م))\n"
    "  })\n"
    "  خل ك = عامل(ع.مقبض, ع.pid)\n"
    "  _مفتوحة.اضف(ع.مقبض)\n"
    "  ارجع ك\n"
    "}\n"
    "\n"
    "دالة خادم_طلبات(معالج) {\n"
    "  ارجع دالة(ق) {\n"
    "    طالما صح {\n"
    "      خل ر = ق.استقبل()\n"
    "      اذا ر == عدم { ارجع }\n"
    "      حاول { ق.ارسل({\"ر\": ر[\"ر\"], \"قيمة\": معالج(ر[\"ب\"])}) }\n"
    "      امسك (خ) { ق.ارسل({\"ر\": ر[\"ر\"], \"خطأ\": نص(خ)}) }\n"
    "    }\n"
    "  }\n"
    "}\n"
    "\n"
    "صنف مجمع {\n"
    "  بناء(عدد, معالج) {\n"
    "    هذا.عمال = []\n"
    "    هذا._انشغال = []\n"
    "    كرر عدد {\n"
    "      هذا.عمال.اضف(انشئ(خادم_طلبات(معالج)))\n"
    "      هذا._انشغال.اضف(0)\n"
    "    }\n"
    "  }\n"
    "  نفذ(بيانات) {\n"
    "    خل افضل = 0\n"
    "    لكل ط في مدى(هذا.عمال.طول) { اذا هذا._انشغال[ط] < هذا._انشغال[افضل] { افضل = ط } }\n"
    "    هذا._انشغال[افضل] += 1\n"
    "    خل ذا = هذا\n"
    "    خل وع = هذا.عمال[افضل].اطلب(بيانات)\n"
    "    ارجع وع.ثم(دالة(ق) { ذا._انشغال[افضل] -= 1; ارجع ق }).التقط(دالة(خ) { ذا._انشغال[افضل] -= 1; ارمي خ })\n"
    "  }\n"
    "  حول(قائمة) { ارجع كل_الوعود(قائمة.حول((ع) => هذا.نفذ(ع))) }\n"
    "  اغلق() { لكل ع في هذا.عمال { ع.انهِ() } }\n"
    "}\n"
    "\n"
    "دالة مجمع_جديد(عدد, معالج) { ارجع مجمع(عدد, معالج) }\n"},
  {"قوالب",
    "استورد \"جيسون\"\n"
    "استورد \"عرض\"\n"
    "استورد \"نصوص\"\n"
    "\n"
    "دالة هرب_html(س) {\n"
    "  ارجع نسق(\"{}\", س).ابدل(\"&\", \"&amp;\").ابدل(\"<\", \"&lt;\").ابدل(\">\", \"&gt;\").ابدل(\"\\\"\", \"&quot;\").ابدل(\"'\", \"&#39;\")\n"
    "}\n"
    "\n"
    "دالة _مرشح(اسم, ق, وسيط) {\n"
    "  اذا اسم == \"كبير\" { ارجع نسق(\"{}\", ق).كبير() }\n"
    "  اذا اسم == \"صغير\" { ارجع نسق(\"{}\", ق).صغير() }\n"
    "  اذا اسم == \"عنوان\" { ارجع نصوص.عنوان(نسق(\"{}\", ق)) }\n"
    "  اذا اسم == \"نظف\" { ارجع نسق(\"{}\", ق).نظف() }\n"
    "  اذا اسم == \"طول\" { ارجع ق == عدم ؟ 0 : ق.طول }\n"
    "  اذا اسم == \"ادمج\" { ارجع هل_قائمة(ق) ؟ ق.حول((ع) => نسق(\"{}\", ع)).ادمج(وسيط == عدم ؟ \"، \" : نسق(\"{}\", وسيط)) : ق }\n"
    "  اذا اسم == \"افتراضي\" { ارجع (ق == عدم او ق == \"\" او ق == غلط) ؟ وسيط : ق }\n"
    "  اذا اسم == \"اقتطع\" { ارجع نصوص.اقتطع(نسق(\"{}\", ق), وسيط) }\n"
    "  اذا اسم == \"ارقام\" { ارجع عرض.ارقام_مفصولة(ق, \",\", وسيط) }\n"
    "  اذا اسم == \"حجم\" { ارجع عرض.حجم_ملف(ق) }\n"
    "  اذا اسم == \"نسبة\" { ارجع عرض.نسبة(ق, وسيط == عدم ؟ 1 : وسيط) }\n"
    "  اذا اسم == \"مدة\" { ارجع عرض.مدة(ق) }\n"
    "  اذا اسم == \"حروف\" { ارجع عرض.عدد_بالحروف(ق) }\n"
    "  اذا اسم == \"جيسون\" { ارجع جيسون.ترميز(ق) }\n"
    "  اذا اسم == \"هرب\" { ارجع هرب_html(ق) }\n"
    "  اذا اسم == \"عكس\" { ارجع هل_قائمة(ق) ؟ ق.انسخ().اعكس() : نسق(\"{}\", ق).اعكس() }\n"
    "  اذا اسم == \"رتب\" { ارجع ق.انسخ().رتب() }\n"
    "  اذا اسم == \"املأ\" { ارجع نصوص.املأ_يمين(ق, وسيط) }\n"
    "  ارمي \"مرشح نماذج غير معروف: ${اسم}\"\n"
    "}\n"
    "\n"
    "دالة _حرفية(ن) {\n"
    "  ن = ن.نظف()\n"
    "  اذا ن.طول >= 2 و ((ن.يبدأ_ب(\"\\\"\") و ن.ينتهي_ب(\"\\\"\")) او (ن.يبدأ_ب(\"'\") و ن.ينتهي_ب(\"'\"))) { ارجع {\"حرفية\": صح, \"ق\": ن.جزء(1, ن.طول - 1)} }\n"
    "  اذا ن == \"صح\" { ارجع {\"حرفية\": صح, \"ق\": صح} }\n"
    "  اذا ن == \"غلط\" { ارجع {\"حرفية\": صح, \"ق\": غلط} }\n"
    "  اذا ن == \"عدم\" { ارجع {\"حرفية\": صح, \"ق\": عدم} }\n"
    "  خل ر = رقم(ن)\n"
    "  اذا ر != عدم و ن != \"\" { ارجع {\"حرفية\": صح, \"ق\": ر} }\n"
    "  ارجع {\"حرفية\": غلط, \"مسار\": ن}\n"
    "}\n"
    "\n"
    "دالة _ابحث(سياق, مسار) {\n"
    "  خل اجزاء = مسار.قسم(\".\")\n"
    "  خل ق = عدم; خل وجد = غلط\n"
    "  خل اول = اجزاء[0]\n"
    "  لكل ي في مدى(سياق.طول - 1, -1, -1) {\n"
    "    اذا سياق[ي].احصل(اول) != عدم { ق = سياق[ي][اول]; وجد = صح; توقف }\n"
    "  }\n"
    "  اذا ليس وجد { ارجع عدم }\n"
    "  لكل ي في مدى(1, اجزاء.طول) {\n"
    "    اذا ق == عدم { ارجع عدم }\n"
    "    خل ج = اجزاء[ي]\n"
    "    اذا هل_قاموس(ق) { ق = ق.احصل(ج) }\n"
    "    والا اذا هل_قائمة(ق) { خل ر = رقم(ج); ق = ر == عدم ؟ عدم : ق.احصل(ر) }\n"
    "    والا اذا ج == \"طول\" و هل_نص(ق) { ق = ق.طول }\n"
    "    والا { ارجع عدم }\n"
    "  }\n"
    "  ارجع ق\n"
    "}\n"
    "دالة _قيّم(ن, سياق) {\n"
    "  خل ح = _حرفية(ن)\n"
    "  ارجع ح[\"حرفية\"] ؟ ح[\"ق\"] : _ابحث(سياق, ح[\"مسار\"])\n"
    "}\n"
    "دالة _صادق(ق) {\n"
    "  اذا ق == عدم او ق == غلط او ق == \"\" او ق == 0 { ارجع غلط }\n"
    "  اذا هل_قائمة(ق) او هل_قاموس(ق) { ارجع ق.طول > 0 }\n"
    "  ارجع صح\n"
    "}\n"
    "دالة _شرط(نص_الشرط, سياق) {\n"
