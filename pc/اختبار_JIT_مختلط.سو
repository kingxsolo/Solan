



خل نجاح = 0, فشل = 0
دالة فحص(اسم, شرط) {
  اذا شرط { نجاح++ } والا { فشل++; اطبع("✗ فشل: " + اسم) }
}



دالة مزيج(ن) {
  خل ق = {}
  خل م = 0.0
  لكل ي في مدى(0, ن) {
    م += ي * 1.5
    ق[ي % 10] = م
  }
  ارجع م + ق[9]
}
فحص("مزيج خريطة", مزيج(100) == 14850)



دالة مفاتيح(ن) {
  خل ق = {}
  خل م = 0.0
  لكل ي في مدى(0, ن) {
    ق["م${ي % 5}"] = ي
    م += 1.0
  }
  ارجع م + ق["م3"]
}
فحص("مفاتيح نصية", مفاتيح(200) == 398)



دالة أطوال(ن) {
  خل ق = {}
  خل ص = 0.0
  لكل ي في مدى(0, ن) {
    ق[ي % 7] = ي
    ص += ق.طول
  }
  ارجع ص
}
فحص("أطوال خرائط", أطوال(70) == 469)


دالة قوائم(ن) {
  خل ق = []
  لكل ي في مدى(0, ن) { ق.اضف(ي * 1.0) }
  خل م = 0.0
  لكل ي في مدى(0, ن) { م += ق[ي % ن] }
  ارجع م
}
فحص("قوائم سريعة", قوائم(100) == 4950)


دالة خلط(ن) {
  خل لـ = [], ق = {}
  لكل ي في مدى(0, ن) { لـ.اضف(ي * 1.0) }
  خل م = 0.0
  لكل ي في مدى(0, ن) {
    م += لـ[ي % ن]
    ق[ي % 4] = م
  }
  ارجع م + ق[3]
}
فحص("خلط قائمة وخريطة", خلط(100) == 4950 + 4950)



خل ت = 0
لكل ر في مدى(0, 4) { ت += مزيج(100) }
فحص("مزيج خريطة", ت == 14850 * 4)

ت = 0
