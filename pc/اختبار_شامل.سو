حاول {
  خل م1 = سوكت.udp(29175), م2 = سوكت.udp(29176)
  سوكت.ارسل_الى(م1, "127.0.0.1", 29176, "بيانات_udp")
  نوم(0.05)
  خل وصل = سوكت.استقبل_من(م2)
  خل نص_وصل = ""
  اذا وصل == عدم { نص_وصل = "" } والا اذا هل_قائمة(وصل) { نص_وصل = نص(وصل[0]) } والا { نص_وصل = نص(وصل) }
  فحص("سوكت UDP", نص_وصل.يحتوي("بيانات_udp"))
  سوكت.اغلق(م1); سوكت.اغلق(م2)
} امسك (خ) { فحص("سوكت UDP", غلط) }

