
استورد "شبكة"
خل ر = شبكة.جلب("http://example.com")
اطبع("HTTP حالة: " + نص(ر.حالة) + " | حجم الجسم: " + نص(طول(ر.جسم)))

استورد "قاعدة"
خل تمت_قاعدة = غلط
حاول {
  خل ق = قاعدة.افتح(":memory:")
  قاعدة.نفذ(ق, "CREATE TABLE رسائل(id INTEGER PRIMARY KEY, نص TEXT)")
  قاعدة.نفذ(ق, "INSERT INTO رسائل(نص) VALUES (?)", ["مرحبا من ويندوز"])
  لكل صف في قاعدة.استعلم(ق, "SELECT * FROM رسائل") { اطبع("SQLite: " + صف.نص) }
  قاعدة.اغلق(ق)
  تمت_قاعدة = صح
} امسك ه { اطبع("○ SQLite غير متاحة في هذه البيئة — تخطي") }
اذا تمت_قاعدة { اطبع("اختبار الشبكة وقاعدة البيانات اكتمل ✓") } والا { اطبع("اختبار الشبكة اكتمل ✓") }
