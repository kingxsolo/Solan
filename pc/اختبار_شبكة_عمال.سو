استورد "سوكت"
استورد "زمن"
استورد "عمال"

خل المنفذ = 40000 + (زمن.الان_مللي() % 20000)
خل مستمع = سوكت.استمع(المنفذ, {عنوان: "127.0.0.1"})
خل عميل = سوكت.اتصل("127.0.0.1", المنفذ, {مهلة: 2})
خل قبول = سوكت.اقبل(مستمع)
سوكت.ارسل(عميل, "loopback")
خل وارد = سوكت.استقبل(قبول[0], 64)
سوكت.ارسل(قبول[0], وارد + "-ok")
خل رد = سوكت.استقبل(عميل, 64)
سوكت.اغلق(عميل); سوكت.اغلق(قبول[0]); سوكت.اغلق(مستمع)
اذا وارد != "loopback" او رد != "loopback-ok" { ارمي "فشل TCP loopback" }
اطبع("TCP loopback نجح")

غير_متزامن دالة اختبار_عمال() {
  خل م = عمال.مجمع_جديد(2, دالة(ن) { ارجع ن * ن })
  خل نواتج = انتظر م.حول([1, 2, 3, 4])
  م.اغلق()
  اذا نواتج[0] != 1 او نواتج[1] != 4 او نواتج[2] != 9 او نواتج[3] != 16 { ارمي "فشل العمال المتوازية" }
  اطبع("العمال المتوازية نجحت")
}
شغل(اختبار_عمال)
