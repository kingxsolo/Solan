// تشخيص معزول: كل حالة بمفردها فوق عتبة التجميع (400 تكرار)
خل نجاح = 0, فشل = 0
دالة فحص(اسم, شرط) {
  اذا شرط { نجاح++ } والا { فشل++; اطبع("✗ فشل: " + اسم) }
}

// 1) SET_INDEX خريطة مفتاح عددي — بلا حلقة خارجية
دالة مزيج(ن) {
  خل ق = {}
  خل م = 0.0
  لكل ي في مدى(0, ن) {
    م += ي * 1.5
    ق[ي % 10] = م
  }
  ارجع م + ق[9]
}
فحص("مزيج 400", مزيج(400) == 239400)

// 2) مفاتيح نصية
دالة مفاتيح(ن) {
  خل ق = {}
  خل م = 0.0
  لكل ي في مدى(0, ن) {
    ق["م${ي % 5}"] = ي
    م += 1.0
  }
  ارجع م + ق["م3"]
}
فحص("مفاتيح 400", مفاتيح(400) == 798)

// 3) GET_PROP .طول على خريطة
دالة أطوال(ن) {
  خل ق = {}
  خل ص = 0.0
  لكل ي في مدى(0, ن) {
    ق[ي % 7] = ي
    ص += ق.طول
  }
  ارجع ص
}
فحص("أطوال 700", أطوال(700) == 4879)

// 4) قوائم فقط (مسار سريع)
دالة قوائم(ن) {
  خل ق = []
  لكل ي في مدى(0, ن) { ق.اضف(ي * 1.0) }
  خل م = 0.0
  لكل ي في مدى(0, ن) { م += ق[ي % ن] }
  ارجع م
}
فحص("قوائم 400", قوائم(400) == 79800)

// 5) خلط قائمة وخريطة
دالة خلط(ن) {
  خل لـ = [], ق = {}
  لكل ي في مدى(0, ن) { لـ.اضف(ي * 1.0) }
  خل م = 0.0
  لكل ي في مدى(0, ن) {
    م += لـ[ي % ن]
    ق[ي % 4] = م
  }
  ارجع م + ق[3]
}
فحص("خلط 400", خلط(400) == 159600)

اطبع("التشخيص: ${نجاح} نجاح، ${فشل} فشل")
اذا فشل == 0 { اطبع("التشخيص نجح ✓") }
