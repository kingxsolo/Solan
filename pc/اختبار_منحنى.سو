// 7) تكاملي: توليد مفاتيح عشوائية وتوقيع وتحقق
خل سر_ت = تشفير.ed25519_سر()
فحص("طول سر ed", طول(سر_ت) == 64)
خل عام_ت = تشفير.ed25519_عام(سر_ت)
خل تو = تشفير.ed25519_وقّع(سر_ت, "رسالة اختبار سولان")
فحص("تحقق ذاتي", تشفير.ed25519_تحقق(عام_ت, "رسالة اختبار سولان", تو))
فحص("طول توقيع", طول(تو) == 128)

// 8) تكاملي: ECDH بطرفين بمفاتيح عشوائية
خل خ1 = تشفير.x25519_سر(), خ2 = تشفير.x25519_سر()
خل م1 = تشفير.x25519_عام(خ1), م2 = تشفير.x25519_عام(خ2)
فحص("ECDH تطابق الطرفين", تشفير.x25519_مشترك(خ1, م2) == تشفير.x25519_مشترك(خ2, م1))

// 9) رفض مدخلات غير صالحة
حاول { تشفير.x25519_عام("xyz") } امسك ه { اطبع("رفض hex قصير: " + ه) }
حاول { تشفير.ed25519_وقّع("zz11", "نص") } امسك ه { اطبع("رفض hex غير سداسي عشري: " + ه) }

اطبع("منحنى: نجاح=" + نص(نجاح) + " فشل=" + نص(فشل))
اذا فشل > 0 { ارمي "فشل اختبار المنحنى" }
اطبع("تم ✓")
