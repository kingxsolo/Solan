// اختبار X25519 + Ed25519 بمتجهات RFC 7748 و RFC 8032 الرسمية
// التشغيل: solan pc\اختبار_منحنى.سو
استورد "تشفير"

خل نجاح = 0, فشل = 0
دالة فحص(اسم, شرط) {
  اذا شرط { نجاح++ } والا { فشل++; اطبع("✗ فشل: " + اسم) }
}

