




خل نجاح = 0, فشل = 0
دالة فحص(اسم, شرط) {
  اذا شرط { نجاح++ } والا { فشل++; اطبع("✗ فشل: " + اسم) }
}


خل م = 0
لكل ي في مدى(0, 2000000) { م += ي }
فحص("مجموع مليونين", م == 1999999000000)


خل ب = 0
لكل ي في مدى(0, 200000) { ب += ي % 7 }
فحص("مجاميع الباقي", ب == 599994)


خل ع = 0.5
لكل ي في مدى(0, 200000) { ع = ع * 1.000001 + 0.000001 }
فحص("سلسلة عشرية", ع > 0.8 و ع < 0.9)


خل ص = 0
لكل ي في مدى(0, 200000) { اذا ي * 1.0 < 100000.0 { ص++ } }
فحص("مقارنات أقل من", ص == 100000)


خل تساوي = 0
لكل ي في مدى(0, 100000) { اذا ي % 2 == 0 { تساوي++ } }
فحص("زوجية", تساوي == 50000)


استورد "رياضيات"
خل ج = 0.0
لكل ي في مدى(0, 100000) { ج += رياضيات.جذر(ي * 1.0) }
فحص("مجموع الجذور", ج > 21000000.0 و ج < 22000000.0)

اطبع("")
اطبع("النتيجة: ${نجاح} نجاح، ${فشل} فشل")
اذا فشل > 0 { نظام.اخرج(1) }
اطبع("اختبار JIT نجح ✓")
