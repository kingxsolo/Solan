استورد "زمن"
دالة زوجية(ن) { ارجع ن % 2 == 0 }
دالة داخل(ن, أدنى, أعلى) { ارجع ن >= أدنى و ن <= أعلى }
دالة جمع(أ, ب) { ارجع أ + ب }
خل بداية = زمن.ساعة()
خل م = 0
خل ك = 0
لكل ي في مدى(0, 2000000) {
  اذا زوجية(ي) { م = جمع(م, 1) }
  اذا داخل(ي, 100, 200) { ك = ك + 1 }
}
خل مدة = (زمن.ساعة() - بداية) * 1000
اطبع("م=${م} ك=${ك} مللي=${مدة}")
