استورد "زمن"
استورد "جيسون"
خل عناصر = []
لكل ي في مدى(0, 20000) { عناصر.اضف({"معرف": ي, "اسم": "item${ي}", "قيمة": ي * 1.5}) }
خل تو = 0
خل tf = 0
خل ن = ""
لكل ت في مدى(0, 10) {
  خل ب = زمن.ساعة()
  ن = جيسون.ترميز(عناصر)
  تو += زمن.ساعة() - ب
  خل ب2 = زمن.ساعة()
  جيسون.فك(ن)
  tf += زمن.ساعة() - ب2
}
خل تو1000 = تو * 1000
خل tf1000 = tf * 1000
خل المجموع = تو1000 + tf1000
اطبع("ترميز=${تو1000} فك=${tf1000} مجموع=${المجموع}")
