فحص("الأنواع العامة تفحص القوائم المتداخلة", نوع_الخطأ_من(دالة() { طول_متداخل_عام({"س": [1, "نص"]}) }) == "نوع")
فحص("اتحاد الأنواع العامة يقبل أحد البدائل", نوع_الخطأ_من(دالة() { طول_قائمة_مرنة([1, "س"]) }) == "")
فحص("الأنواع العامة تقبل القيم الصحيحة", طول_قاموس_عام({"س": 1}) == 1 و طول_قائمة_عامة([1, 2]) == 2 و طول_قائمة_مرنة([1, "س"]) == 2 و طول_متداخل_عام({"س": [1, 2]}) == 1)

واجهة قابل_للتنفيذ { دالة نفذ(قيمة: رقم): نص }
