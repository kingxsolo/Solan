


خل نجاح = 0, فشل = 0
دالة فحص(اسم, شرط) {
  اذا شرط { نجاح++ } والا { فشل++; اطبع("✗ فشل: " + اسم) }
}


فحص("حساب", 2 + 3 * 4 == 14)
فحص("نص", "مرحبا".كبير() == "مرحبا")
فحص("قاموس", {"أ": 1}.أ == 1)
فحص("قائمة", [1, 2, 3].مجموع() == 6)
فحص("منطقي", صح و ليس غلط)


دالة جمع(أ, ب = 2) { ارجع أ + ب }
فحص("معامل افتراضي", جمع(1) == 3 و جمع(1, 5) == 6)
خل عداد = دالة() { خل ع = 0; ارجع دالة() { ع++; ارجع ع } }()
عداد(); عداد()
فحص("إغلاق", عداد() == 3)


صنف حيوان {
  دالة بناء(اسم) { هذا.اسم = اسم }
  دالة صوت() { ارجع "..." }
}
صنف قطة يرث حيوان {
  دالة صوت() { ارجع "مياو" }
}
فحص("وراثة", قطة("ميمي").صوت() == "مياو")
فحص("نوع الكائن", نوع(قطة("س")) == "قطه")


خل تم_الأمساك = غلط
حاول { ارمي "تجربة" } امسك (خ) { تم_الأمساك = صح }
فحص("معالجة الأخطاء", تم_الأمساك)


خل م = 0
لكل ي في مدى(0, 1000000) { م += ي }
فحص("حلقة مليون", م == 499999500000)


دالة مجموع_حتى(ن) { اذا ن <= 0 { ارجع 0 } ارجع ن + مجموع_حتى(ن - 1) }
فحص("استدعاء ذاتي", مجموع_حتى(1000) == 500500)


فحص("طول عربي", "سلام".طول == 4)
فحص("استبدال", "أهلاً".ابدل("ً", "") == "أهلا")


