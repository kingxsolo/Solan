}
دالة طول_قاموس_عام(م: قاموس<نص, رقم>) { ارجع م.طول }
دالة طول_قائمة_عامة(ق: قائمة<رقم>) { ارجع ق.طول }
دالة طول_قائمة_مرنة(ق: قائمة<رقم | نص>) { ارجع ق.طول }
دالة طول_متداخل_عام(م: قاموس<نص, قائمة<رقم>>) { ارجع م.طول }
فحص("الأنواع العامة تفحص مفاتيح القاموس", نوع_الخطأ_من(دالة() { طول_قاموس_عام({1: 2}) }) == "نوع")
