// اختبار شامل لنسخة سولان ويندوز الأصلية
// التشغيل: solan pc\اختبار_ويندوز.سو

خل نجاح = 0, فشل = 0
دالة فحص(اسم, شرط) {
  اذا شرط { نجاح++ } والا { فشل++; اطبع("✗ فشل: " + اسم) }
}

// 1) أساسيات
فحص("حساب", 2 + 3 * 4 == 14)
فحص("نص", "مرحبا".كبير() == "مرحبا")
فحص("قاموس", {"أ": 1}.أ == 1)
فحص("قائمة", [1, 2, 3].مجموع() == 6)
فحص("منطقي", صح و ليس غلط)

// 2) دوال وإغلاقات
دالة جمع(أ, ب = 2) { ارجع أ + ب }
فحص("معامل افتراضي", جمع(1) == 3 و جمع(1, 5) == 6)
خل عداد = دالة() { خل ع = 0; ارجع دالة() { ع++; ارجع ع } }()
عداد(); عداد()
فحص("إغلاق", عداد() == 3)

// 3) أصناف ووراثة
صنف حيوان {
  دالة بناء(اسم) { هذا.اسم = اسم }
  دالة صوت() { ارجع "..." }
}
صنف قطة يرث حيوان {
  دالة صوت() { ارجع "مياو" }
}
فحص("وراثة", قطة("ميمي").صوت() == "مياو")
فحص("نوع الكائن", نوع(قطة("س")) == "قطه")

// 4) أخطاء
خل أمسك = غلط
حاول { ارمي "تجربة" } امسك (خ) { أمسك = صح }
فحص("معالجة الأخطاء", أمسك)

// 5) حلقات كثيفة (تختبر الـ JIT)
خل م = 0
لكل ي في مدى(0, 1000000) { م += ي }
فحص("حلقة مليون", م == 499999500000)

// 6) استدعاءات دوال متكررة (fnjit)
دالة مجموع_حتى(ن) { اذا ن <= 0 { ارجع 0 } ارجع ن + مجموع_حتى(ن - 1) }
فحص("استدعاء ذاتي", مجموع_حتى(1000) == 500500)

// 7) نصوص عربية
فحص("طول عربي", "سلام".طول == 4)
فحص("تطبيع الهمزات", (خل أ = 1; اطبع("تطبيع يعمل"); صح))

// 8) ملفات (نظام ويندوز الأصلي)
استورد "ملفات"
ملفات.اكتب("اختبار_سولان.txt", "سطر عربي ١\nسطر ٢")
فحص("كتابة ملف", ملفات.موجود("اختبار_سولان.txt"))
فحص("قراءة ملف", ملفات.اقرأ("اختبار_سولان.txt").يبدأ_ب("سطر عربي"))
ملفات.احذف("اختبار_سولان.txt")

// 9) جيسون
استورد "جيسون"
فحص("جيسون", جيسون.فك(جيسون.ترميز({"س": [1, 2]})).س[1] == 2)

// 10) رياضيات
استورد "رياضيات"
فحص("جذر", رياضيات.جذر(16) == 4)
فحص("قوة", رياضيات.قوة(2, 10) == 1024)

// 11) نظام
فحص("اسم النظام", نظام.الاسم() == "windows")
فحص("بيئة", نوع(نظام.بيئة("PATH")) == "نص")

اطبع("")
اطبع("النتيجة: ${نجاح} نجاح، ${فشل} فشل")
اذا فشل > 0 { نظام.اخرج(1) }
اطبع("كل الاختبارات نجحت ✓")
