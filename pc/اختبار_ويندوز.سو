واجهة واجهة_أنواع_توثيقية { دالة حول(قيمة: رقم): نص }
واجهة واجهة_متبقية { دالة اجمع(...قيم) }
صنف منفذ_متوافق { دالة نفذ(قيمة: رقم): نص { ارجع نص(قيمة) } }
صنف منفذ_بمعامل_إضافي { دالة نفذ(قيمة, زيادة) { ارجع نص(قيمة + زيادة) } }
صنف منفذ_اختياري { دالة نفذ(قيمة, زيادة = 1) { ارجع قيمة + زيادة } }
صنف منفذ_بلا_معاملات { دالة نفذ() { ارجع عدم } }
صنف ناقص_طريقة_بلا_معاملات {}
صنف منفذ_ساكن_مطابق { ساكن دالة نسخة(قيمة) { ارجع نص(قيمة) } }
صنف منفذ_ساكن_كمثيل { دالة نسخة(قيمة) { ارجع نص(قيمة) } }
صنف منفذ_أنواع_مختلفة { دالة حول(قيمة: نص): رقم { ارجع طول(قيمة) } }
صنف منفذ_متبقي { دالة اجمع(...قيم) { ارجع قيم.مجموع() } }
صنف منفذ_ثابت_بدل_متبقي { دالة اجمع(أ, ب) { ارجع أ + ب } }
فحص("الواجهة تتحقق من توقيع عدد المعاملات", يطبق(منفذ_متوافق, قابل_للتنفيذ) و ليس يطبق(منفذ_بمعامل_إضافي, قابل_للتنفيذ))
فحص("الواجهة تقبل معاملات تنفيذ اختيارية إضافية", يطبق(منفذ_اختياري, واجهة_اختيارية))
فحص("الواجهة تتطلب الطريقة ذات التوقيع الصفري", يطبق(منفذ_بلا_معاملات, واجهة_بلا_معاملات) و ليس يطبق(ناقص_طريقة_بلا_معاملات, واجهة_بلا_معاملات))
فحص("الواجهة تتحقق من الطريقة الساكنة", يطبق(منفذ_ساكن_مطابق, واجهة_ساكنة) و ليس يطبق(منفذ_ساكن_كمثيل, واجهة_ساكنة))
فحص("أنواع معاملات وإرجاع الواجهة توثيقية", يطبق(منفذ_أنواع_مختلفة, واجهة_أنواع_توثيقية))
فحص("الواجهة تشترط معاملات متبقية عند التصريح بها", يطبق(منفذ_متبقي, واجهة_متبقية) و ليس يطبق(منفذ_ثابت_بدل_متبقي, واجهة_متبقية))
دالة يقبل_الواجهة(قيمة: قابل_للتنفيذ): منطقي { ارجع يطبق(قيمة, قابل_للتنفيذ) }
فحص("واجهة النوع المعلن تقبل الصنف المنفذ", يقبل_الواجهة(منفذ_متوافق()))
