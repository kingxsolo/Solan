غير_متزامن دالة اختبار_مهلة_الوعد() {
  خل أصل = وعد(); خل ردود = [0]
  أصل.عند_الغاء(دالة() { ردود[0] += 1 })
  خل مؤقت = أصل.مع_مهلة(0.01); خل خطأ_مهلة = غلط
  حاول { انتظر مؤقت } امسك (خ) { خطأ_مهلة = خ.نوع == "مهلة" }
  فحص("مهلة الوعد تُرفض بخطأ مهلة", خطأ_مهلة)
  فحص("المهلة تلغي الوعد الأصلي فقط", أصل.ملغى و ليس مؤقت.ملغى و ردود[0] == 1)
}
شغل(اختبار_مهلة_الوعد)

