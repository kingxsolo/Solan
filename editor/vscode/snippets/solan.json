{
  "دالة": {
    "prefix": "دالة",
    "body": [
      "دالة ${1:اسم}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "تعريف دالة"
  },
  "دالة غير متزامنة": {
    "prefix": "غير_متزامن",
    "body": [
      "غير_متزامن دالة ${1:اسم}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "دالة غير متزامنة"
  },
  "صنف": {
    "prefix": "صنف",
    "body": [
      "صنف ${1:اسم} {",
      "\tبناء(${2}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "تعريف صنف"
  },
  "اذا": {
    "prefix": "اذا",
    "body": [
      "اذا ${1:شرط} {",
      "\t$0",
      "}"
    ],
    "description": "شرط"
  },
  "اذا والا": {
    "prefix": "اذاوالا",
    "body": [
      "اذا ${1:شرط} {",
      "\t$2",
      "} والا {",
      "\t$0",
      "}"
    ],
    "description": "شرط مع والا"
  },
  "لكل": {
    "prefix": "لكل",
    "body": [
      "لكل ${1:س} في ${2:قائمة} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة تكرار"
  },
  "طالما": {
    "prefix": "طالما",
    "body": [
      "طالما ${1:شرط} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة while"
  },
  "حاول": {
    "prefix": "حاول",
    "body": [
      "حاول {",
      "\t$1",
      "} امسك (${2:خ}) {",
      "\t$0",
      "}"
    ],
    "description": "معالجة أخطاء"
  },
  "حاول اخيرا": {
    "prefix": "حاولاخيرا",
    "body": [
      "حاول {",
      "\t$1",
      "} امسك (${2:خ}) {",
      "\t$3",
      "} اخيرا {",
      "\t$0",
      "}"
    ],
    "description": "حاول/امسك/اخيرا"
  },
  "تبديل": {
    "prefix": "تبديل",
    "body": [
      "تبديل ${1:قيمة} {",
      "\tحالة ${2:1} {",
      "\t\t$3",
      "\t}",
      "\tافتراضي {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "تبديل"
  },
  "استورد": {
    "prefix": "استورد",
    "body": [
      "استورد \"${1:مكتبة}\""
    ],
    "description": "استيراد مكتبة"
  },
  "خادم": {
    "prefix": "خادم",
    "body": [
      "استورد \"شبكة\"",
      "شبكة.خادم(${1:8080}, دالة(طلب) {",
      "\tارجع \"${2:مرحبا}\"",
      "})"
    ],
    "description": "خادم HTTP"
  },
  "جلب": {
    "prefix": "جلب",
    "body": [
      "خل رد = شبكة.جلب(\"${1:رابط}\")",
      "اطبع(رد.حالة, رد.جسم)"
    ],
    "description": "طلب HTTP"
  },
  "سهمية": {
    "prefix": "سهم",
    "body": [
      "(${1:س}) => ${0:س}"
    ],
    "description": "دالة سهمية"
  },
  "كرر": {
    "prefix": "كرر",
    "body": [
      "كرر ${1:5} {",
      "\t$0",
      "}"
    ],
    "description": "تكرار عدد مرات"
  },
  "اختبار": {
    "prefix": "اختبر",
    "body": [
      "استورد \"اختبار\"",
      "اختبار.اختبر(\"${1:اسم}\", دالة() {",
      "\tاختبار.يساوي(${2:فعلي}, ${3:متوقع})",
      "})",
      "اختبار.شغل_الكل()"
    ],
    "description": "اختبار وحدة"
  },
  "دالة بأنواع": {
    "prefix": "دالة_نوع",
    "body": [
      "دالة ${1:اسم}(${2:أ}: ${3:رقم}): ${4:رقم} {",
      "\t$0",
      "}"
    ],
    "description": "دالة بأنواع اختيارية"
  },
  "متغير بنوع": {
    "prefix": "خل_نوع",
    "body": [
      "خل ${1:س}: ${2:رقم} = ${3:0}"
    ],
    "description": "متغير بنوع اختياري"
  },
  "مدى كسول": {
    "prefix": "مدى",
    "body": [
      "لكل ${1:س} في مدى(${2:0}, ${3:10}, ${4:1}) {",
      "\t$0",
      "}"
    ],
    "description": "حلقة مدى كسولة"
  },
  "مجمع عمال": {
    "prefix": "عمال",
    "body": [
      "استورد \"عمال\"",
      "خل مجمع = عمال.مجمع_جديد(${1:4}, دالة(بيانات) {",
      "\tارجع $0",
      "})",
      "خل نتائج = انتظر مجمع.حول(${2:قائمة})"
    ],
    "description": "مجمع عمال متوازٍ"
  },
  "نتيجة": {
    "prefix": "نتيجة",
    "body": [
      "استورد \"نتيجة\"",
      "خل ر = نتيجة.محاولة(${1:دالة}, ${2:وسيط})",
      "اطبع(ر.افتح_او(${3:0}))"
    ],
    "description": "معالجة أخطاء بنتيجة"
  }
}