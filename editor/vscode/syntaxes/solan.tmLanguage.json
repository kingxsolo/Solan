{
  "name": "Solan",
  "scopeName": "source.solan",
  "fileTypes": [
    "سو",
    "solan"
  ],
  "patterns": [
    {
      "name": "comment.block.solan",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line.solan",
      "match": "//.*$"
    },
    {
      "name": "comment.line.shebang.solan",
      "match": "\\A#!.*$"
    },
    {
      "name": "string.quoted.double.solan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.solan",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.solan",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    {
      "name": "string.quoted.single.solan",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.solan",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.guillemet.solan",
      "begin": "«",
      "end": "»"
    },
    {
      "name": "keyword.control.solan",
      "match": "(?<![\\p{L}\\p{N}_])(غير_ذلك_اذا|انهي_الحلقة|في_النهاية|عند_الخطأ|عند_الخطا|بخلاف_ذلك|والا_اذا|وإلا_إذا|كرر_مرات|خلاف_ذلك|سوى_ذلك|اذا_كان|غير_ذلك|في_حالة|إذا_كان|والا_لو|افتراضي|من_أجل|أخيراً|في_حال|ان_كان|طول_ما|اخيراً|او_اذا|ما_دام|من_اجل|ارجاع|نهاية|طالما|مادام|عندما|والّا|او_لو|اخيرا|انتظر|استمر|التقط|و_الا|تجاوز|تبديل|بينما|حاول|اطلق|طابق|ارجع|كرّر|وإلا|لأجل|تخطى|القي|حالة|رجّع|واصل|امسك|ترقب|ألقِ|انتج|اكسر|ارفع|توقف|لاجل|أعطِ|ولّد|ارمي|اعطي|والا|جرّب|أنتج|تابع|اذا|لكل|حين|اعد|أعد|ولد|جرب|حسب|إذا|ضمن|كرر|ارم|رجع|قف|لو|في)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "storage.type.solan",
      "match": "(?<![\\p{L}\\p{N}_])(غير_متزامنة|قيمة_ثابتة|غير_متزامن|يشتق_من|يمتد_من|يرث_من|دالّة|مولّد|تعداد|فليكن|وظيفه|خاصية|إجراء|متغير|اجراء|وظيفة|مولد|دالة|قالب|اجعل|ساكن|ليكن|ثابت|كلاس|يمتد|دائم|يرث|فئة|ترث|صنف|عرف|خل)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.solan",
      "match": "(?<![\\p{L}\\p{N}_])(بلا_قيمة|لا_شيء|حقيقي|لاشيء|زائف|صحيح|فارغ|خاطئ|خالي|صدق|عدم|كذب|غلط|نعم|صح)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "variable.language.solan",
      "match": "(?<![\\p{L}\\p{N}_])(الأصل|الاصل|نفسه|ذاتي|الاب|الأب|هذا|هذه)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.word.solan",
      "match": "(?<![\\p{L}\\p{N}_])(وكذلك|ليست|نفي|ليس|او|أو|و)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.import.solan",
      "match": "(?<![\\p{L}\\p{N}_])(اجلب_مكتبة|ادرج_مكتبة|استورد|استدعي|بمسمى|كاسم|باسم|من)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.class.module.solan",
      "match": "(?<![\\p{L}\\p{N}_])(رياضيات|ويبسوكت|مسارات|عشوائي|اختبار|ألوان|جيسون|ملفات|قاعدة|تشفير|جداول|وسائط|حلقة|سوكت|شبكة|نظام|زمن|نمط|ضغط|ضخم|سجل)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.function.builtin.solan",
      "match": "(?<![\\p{L}\\p{N}_])(جلب_غير_متزامن|ارقام_الاخراج|ارقام_لاتينية|ارقام_فارسية|ارقام_عربية|لون_الكود|خادم_حلقة|كل_الوعود|هل_قائمة|هل_قاموس|كوروتين|هل_دالة|هل_رقم|هل_فرع|هل_عدم|استأنف|هل_نص|منتهي|عملية|اكتب|لديه|تأكد|ادخل|سباق|اطبع|وعد|مدى|طول|رقم|نسق|شغل|نوع|حرف|رمز|نم|نص)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "entity.name.class.solan",
      "match": "(?<=صنف |فئة |كلاس |قالب |يرث )[\\p{L}_][\\p{L}\\p{N}_]*"
    },
    {
      "name": "entity.name.function.call.solan",
      "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    },
    {
      "name": "constant.numeric.solan",
      "match": "(?<![\\p{L}_])[0-9٠-٩۰-۹][0-9٠-٩۰-۹_.٫]*"
    },
    {
      "name": "keyword.operator.solan",
      "match": "\\?\\.|\\?\\?|=>|\\*\\*=?|//=?|<<|>>|[+\\-*/%&|^<>=!]=?|\\+\\+|--|\\.\\.\\.|؟|×|÷"
    }
  ]
}