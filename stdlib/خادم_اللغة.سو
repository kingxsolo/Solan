استورد "نظام"
استورد "جيسون"

خل _رموز = نظام.رموز()
خل _وثائق = {}
خل _حروف_فاصلة = " \t(){}[],;:=+-*/%<>!&|?.\"'#\r"

دالة _ارسل(ك) { ك["jsonrpc"] = "2.0"; نظام.ارسل_lsp(جيسون.ترميز(ك)) }
دالة _رد(معرف, نتيجة) { _ارسل({"id": معرف, "result": نتيجة}) }
دالة _خطأ(معرف, رمز, رسالة) { _ارسل({"id": معرف, "error": {"code": رمز, "message": رسالة}}) }
دالة _اشعار(طريقة, معاملات) { _ارسل({"method": طريقة, "params": معاملات}) }

دالة _اقرأ_رسالة() {
  خل طول = 0
  طالما صح {
    خل س = ادخل()
    اذا س == عدم { ارجع عدم }
    اذا س == "" { توقف }
    اذا س.يبدأ_ب("Content-Length:") { طول = رقم(س.جزء(15).نظف()) }
  }
  اذا طول <= 0 { ارجع عدم }
  خل جسم = نظام.اقرا_بايتات(طول)
  اذا جسم == عدم { ارجع عدم }
  ارجع جيسون.فك(جسم)
}

دالة _هل_رمز_فاصل(ح) { ارجع _حروف_فاصلة.يحتوي(ح) }

دالة _كلمات(س) {
  خل نتيجة = []
  خل بداية = -1
  خل ط = س.طول
  لكل ي في مدى(ط + 1) {
    خل فاصل = ي == ط او _هل_رمز_فاصل(س[ي])
    اذا فاصل {
      اذا بداية >= 0 { نتيجة.اضف({"ن": س.جزء(بداية, ي), "ب": بداية}); بداية = -1 }
    } والا اذا بداية < 0 { بداية = ي }
  }
  ارجع نتيجة
}
دالة _في(قائمة, ن) { ارجع قائمة.يحتوي(ن) }
دالة _ازل_اسبق(ك) {
  خل ي = 0
  طالما ي < ك.طول - 1 {
    خل ط = نظام.طبّع(ك[ي]["ن"])
    اذا ط == نظام.طبّع("غير_متزامن") او ط == نظام.طبّع("ساكن") او ط == نظام.طبّع("مولد") { ي += 1 } والا { توقف }
  }
  ارجع ي
}

دالة _تعريفات(نص) {
  خل خارج = []
  خل سطور = نص.قسم("\n")
  خل جدول = _رموز.تعريفات
  خل دوال = جدول["دالة"]
  خل اصناف = جدول["صنف"]
  خل متغيرات = جدول["خل"]
  خل ثوابت = جدول["ثابت"]
  لكل ر، س في سطور {
    خل ك = _كلمات(س)
    اذا ك.طول < 2 { استمر }
    خل ب = _ازل_اسبق(ك)
    اذا ب >= ك.طول - 1 { استمر }
    خل كلمة = نظام.طبّع(ك[ب]["ن"])
    خل نوع = 0
    اذا _في(دوال, كلمة) { نوع = 12 }
    والا اذا _في(اصناف, كلمة) { نوع = 5 }
    والا اذا _في(ثوابت, كلمة) { نوع = 14 }
    والا اذا _في(متغيرات, كلمة) { نوع = 13 }
    اذا نوع > 0 {
      خارج.اضف({"الاسم": ك[ب + 1]["ن"], "السطر": ر, "العمود": ك[ب + 1]["ب"], "النوع": نوع, "النص": س.نظف()})
    }
  }
  ارجع خارج
}

دالة _كلمة_عند(نص, سطر, عمود) {
  خل سطور = نص.قسم("\n")
  اذا سطر >= سطور.طول { ارجع عدم }
  خل س = سطور[سطر]
  لكل ك في _كلمات(س) {
    اذا عمود >= ك["ب"] و عمود <= ك["ب"] + ك["ن"].طول { ارجع ك["ن"] }
  }
  ارجع عدم
}

دالة _قبل_النقطة(نص, سطر, عمود) {
  خل سطور = نص.قسم("\n")
  اذا سطر >= سطور.طول { ارجع عدم }
  خل س = سطور[سطر].جزء(0, عمود)
  اذا س.طول == 0 { ارجع عدم }
  خل ي = س.طول - 1
  طالما ي >= 0 و س[ي] != "." و ليس _هل_رمز_فاصل(س[ي]) { ي -= 1 }
  اذا ي < 0 او س[ي] != "." { ارجع عدم }
  خل ختام = ي
  خل ج = ي - 1
  طالما ج >= 0 و ليس _هل_رمز_فاصل(س[ج]) { ج -= 1 }
  اذا ختام - ج - 1 <= 0 { ارجع عدم }
  ارجع س.جزء(ج + 1, ختام)
}

دالة _شخّص(uri) {
  خل نص = _وثائق[uri]
  خل تشخيصات = []
  خل خ = نظام.افحص_صياغة(نص)
  اذا خ != عدم {
    خل سطر = خ[0] - 1
    اذا سطر < 0 { سطر = 0 }
    خل سطور = نص.قسم("\n")
    خل ختام = سطر < سطور.طول ؟ سطور[سطر].طول : 0
    تشخيصات.اضف({
      "range": {"start": {"line": سطر, "character": 0}, "end": {"line": سطر, "character": ختام}},
      "severity": 1, "source": "solan", "message": خ[1]
    })
  }
  _اشعار("textDocument/publishDiagnostics", {"uri": uri, "diagnostics": تشخيصات})
}

دالة _اكمال(uri, سطر, عمود) {
  خل نص = _وثائق.احصل(uri, "")
  خل بنود = []
  خل قبل = _قبل_النقطة(نص, سطر, عمود)
  اذا قبل != عدم {
    خل ط = نظام.طبّع(قبل)
    خل م = _رموز.وحدات[ط]
    اذا م != عدم { لكل ف في م { بنود.اضف({"label": ف, "kind": 3, "detail": "دالة في مكتبة " + قبل}) } }
    والا { لكل ف في _رموز.طرق { بنود.اضف({"label": ف, "kind": 2, "detail": "دالة مدمجة للقيم"}) } }
    ارجع {"isIncomplete": غلط, "items": بنود}
  }
  لكل ك في _رموز.قياسية { بنود.اضف({"label": ك, "kind": 14, "detail": "كلمة مفتاحية"}) }
  لكل ف في _رموز.مدمجة { بنود.اضف({"label": ف, "kind": 3, "detail": "دالة مدمجة"}) }
  لكل ك في _رموز.وحدات.مفاتيح() { بنود.اضف({"label": ك, "kind": 9, "detail": "مكتبة أصلية"}) }
  لكل ك في _رموز.مكتبات { بنود.اضف({"label": ك, "kind": 9, "detail": "مكتبة قياسية"}) }
  لكل ت في _تعريفات(نص) { بنود.اضف({"label": ت["الاسم"], "kind": ت["النوع"], "detail": ت["النص"]}) }
  ارجع {"isIncomplete": غلط, "items": بنود}
}

دالة _تحويم(uri, سطر, عمود) {
  خل نص = _وثائق.احصل(uri, "")
  خل كلمة = _كلمة_عند(نص, سطر, عمود)
  اذا كلمة == عدم { ارجع عدم }
  خل ط = نظام.طبّع(كلمة)
  لكل ت في _تعريفات(نص) {
    اذا نظام.طبّع(ت["الاسم"]) == ط { ارجع {"contents": {"kind": "markdown", "value": "```solan\n" + ت["النص"] + "\n```"}} }
  }
  اذا _في(_رموز.مدمجة, ط) { ارجع {"contents": {"kind": "markdown", "value": "**" + كلمة + "** — دالة مدمجة"}} }
  اذا _رموز.وحدات.احصل(ط) != عدم { ارجع {"contents": {"kind": "markdown", "value": "**" + كلمة + "** — مكتبة أصلية (" + نسق("{}", _رموز.وحدات[ط].طول) + " دالة)"}} }
  اذا _في(_رموز.مكتبات, ط) { ارجع {"contents": {"kind": "markdown", "value": "**" + كلمة + "** — مكتبة قياسية"}} }
  اذا _في(_رموز.كلمات, ط) { ارجع {"contents": {"kind": "markdown", "value": "**" + كلمة + "** — كلمة مفتاحية"}} }
  ارجع عدم
}

دالة _تعريف(uri, سطر, عمود) {
  خل نص = _وثائق.احصل(uri, "")
  خل كلمة = _كلمة_عند(نص, سطر, عمود)
  اذا كلمة == عدم { ارجع عدم }
  خل ط = نظام.طبّع(كلمة)
  لكل ت في _تعريفات(نص) {
    اذا نظام.طبّع(ت["الاسم"]) == ط {
      ارجع {"uri": uri, "range": {"start": {"line": ت["السطر"], "character": ت["العمود"]}, "end": {"line": ت["السطر"], "character": ت["العمود"] + ت["الاسم"].طول}}}
    }
  }
  ارجع عدم
}

دالة _رموز_المستند(uri) {
  خل نص = _وثائق.احصل(uri, "")
  خل خارج = []
  لكل ت في _تعريفات(نص) {
    خارج.اضف({
      "name": ت["الاسم"], "kind": ت["النوع"],
      "location": {"uri": uri, "range": {"start": {"line": ت["السطر"], "character": ت["العمود"]}, "end": {"line": ت["السطر"], "character": ت["العمود"] + ت["الاسم"].طول}}}
    })
  }
  ارجع خارج
}

دالة _عالج(ر) {
  خل طريقة = ر.احصل("method")
  خل م = ر.احصل("params", {})
  خل معرف = ر.احصل("id")
  اذا طريقة == "initialize" {
    _رد(معرف, {
      "capabilities": {
        "textDocumentSync": 1,
        "completionProvider": {"triggerCharacters": ["."]},
        "hoverProvider": صح,
        "definitionProvider": صح,
        "documentSymbolProvider": صح
      },
      "serverInfo": {"name": "solan-lsp", "version": "1.0"}
    })
  }
  والا اذا طريقة == "initialized" { }
  والا اذا طريقة == "shutdown" { _رد(معرف, عدم) }
  والا اذا طريقة == "exit" { نظام.اخرج(0) }
  والا اذا طريقة == "textDocument/didOpen" {
    خل د = م["textDocument"]
    _وثائق[د["uri"]] = د["text"]
    _شخّص(د["uri"])
  }
  والا اذا طريقة == "textDocument/didChange" {
    خل uri = م["textDocument"]["uri"]
    خل تغييرات = م["contentChanges"]
    اذا تغييرات.طول > 0 { _وثائق[uri] = تغييرات[تغييرات.طول - 1]["text"] }
    _شخّص(uri)
  }
  والا اذا طريقة == "textDocument/didSave" {
    خل uri = م["textDocument"]["uri"]
    اذا م.احصل("text") != عدم { _وثائق[uri] = م["text"] }
    اذا _وثائق.احصل(uri) != عدم { _شخّص(uri) }
  }
  والا اذا طريقة == "textDocument/didClose" {
    _وثائق[م["textDocument"]["uri"]] = عدم
    _اشعار("textDocument/publishDiagnostics", {"uri": م["textDocument"]["uri"], "diagnostics": []})
  }
  والا اذا طريقة == "textDocument/completion" { _رد(معرف, _اكمال(م["textDocument"]["uri"], م["position"]["line"], م["position"]["character"])) }
  والا اذا طريقة == "textDocument/hover" { _رد(معرف, _تحويم(م["textDocument"]["uri"], م["position"]["line"], م["position"]["character"])) }
  والا اذا طريقة == "textDocument/definition" { _رد(معرف, _تعريف(م["textDocument"]["uri"], م["position"]["line"], م["position"]["character"])) }
  والا اذا طريقة == "textDocument/documentSymbol" { _رد(معرف, _رموز_المستند(م["textDocument"]["uri"])) }
  والا اذا معرف != عدم { _خطأ(معرف, -32601, "طريقة غير مدعومة: " + نسق("{}", طريقة)) }
}

دالة شغل() {
  طالما صح {
    خل ر = _اقرأ_رسالة()
    اذا ر == عدم { توقف }
    حاول { _عالج(ر) } امسك (خ) {
      اذا ر.احصل("id") != عدم { _خطأ(ر["id"], -32603, "خطأ داخلي: " + نسق("{}", خ)) }
    }
  }
}
