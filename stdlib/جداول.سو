استورد "ملفات"
استورد "ألوان"
استورد "نصوص"

دالة كشف_فاصل(نص) {
  خل سطر = نص.قسم("\n")[0]
  خل افضل = ","; خل عدد = -1
  لكل ف في [",", ";", "\t", "|"] {
    خل ن = سطر.قسم(ف).طول - 1
    اذا ن > عدد { عدد = ن; افضل = ف }
  }
  ارجع افضل
}

دالة حلل(نص, فاصل = ",") {
  اذا نص.يبدأ_ب(حرف(65279)) { نص = نص.جزء(1) }
  خل صفوف = []; خل صف = []; خل حقل = ""; خل داخل = غلط; خل ي = 0; خل مقتبس = غلط
  خل ح = نص.حروف(); خل ن = ح.طول
  طالما ي < ن {
    خل ك = ح[ي]
    اذا داخل {
      اذا ك == "\"" {
        اذا ي + 1 < ن و ح[ي + 1] == "\"" { حقل += "\""; ي += 1 }
        والا { داخل = غلط }
      } والا { حقل += ك }
    }
    والا اذا ك == "\"" { داخل = صح; مقتبس = صح }
    والا اذا ك == فاصل { صف.اضف(حقل); حقل = ""; مقتبس = غلط }
    والا اذا ك == "\n" { صف.اضف(حقل); صفوف.اضف(صف); صف = []; حقل = ""; مقتبس = غلط }
    والا اذا ك == "\r" { }
    والا { حقل += ك }
    ي += 1
  }
  اذا حقل != "" او صف.طول > 0 او مقتبس { صف.اضف(حقل); صفوف.اضف(صف) }
  ارجع صفوف
}

دالة حلل_رؤوس(نص, فاصل = ",") {
  خل صفوف = حلل(نص, فاصل)
  اذا صفوف.طول == 0 { ارجع [] }
  خل رؤوس = صفوف[0]; خل ناتج = []
  لكل ي في مدى(1, صفوف.طول) {
    خل م = {}
    لكل ج، ر في رؤوس { م[ر] = ج < صفوف[ي].طول ؟ صفوف[ي][ج] : "" }
    ناتج.اضف(م)
  }
  ارجع ناتج
}

دالة _قيمة(ن) {
  اذا ن == "" { ارجع عدم }
  اذا ن == "صح" او ن == "true" او ن == "TRUE" { ارجع صح }
  اذا ن == "غلط" او ن == "false" او ن == "FALSE" { ارجع غلط }
  اذا ن.طول > 15 { ارجع ن }
  اذا ن.طول > 1 و ن.يبدأ_ب("0") و ليس ن.يبدأ_ب("0.") { ارجع ن }
  خل ر = رقم(ن)
  ارجع ر == عدم ؟ ن : ر
}
دالة حول_انواع(قواميس) {
  خل ناتج = []
  لكل م في قواميس {
    خل ن = {}
    لكل ك، ق في م { ن[ك] = هل_نص(ق) ؟ _قيمة(ق) : ق }
    ناتج.اضف(ن)
  }
  ارجع ناتج
}

دالة _حقل(ق, فاصل) {
  خل ن = ق == عدم ؟ "" : نسق("{}", ق)
  اذا ن.يحتوي(فاصل) او ن.يحتوي("\"") او ن.يحتوي("\n") او ن.يحتوي("\r") { ارجع "\"" + ن.ابدل("\"", "\"\"") + "\"" }
  ارجع ن
}
دالة كتب(صفوف, فاصل = ",") {
  خل خطوط = []
  لكل ص في صفوف { خطوط.اضف(ص.حول((ق) => _حقل(ق, فاصل)).ادمج(فاصل)) }
  ارجع خطوط.ادمج("\n") + "\n"
}
دالة اعمدة(قواميس) {
  خل ناتج = []; خل رأيت = {}
  لكل م في قواميس { لكل ك في م.مفاتيح() { اذا ليس (ك في رأيت) { رأيت[ك] = صح; ناتج.اضف(ك) } } }
  ارجع ناتج
}
دالة كتب_قواميس(قواميس, رؤوس = عدم, فاصل = ",") {
  خل ر = رؤوس == عدم ؟ اعمدة(قواميس) : رؤوس
  خل صفوف = [ر]
  لكل م في قواميس { صفوف.اضف(ر.حول((ك) => م.احصل(ك))) }
  ارجع كتب(صفوف, فاصل)
}
دالة اقرا(مسار, فاصل = عدم) {
  خل ن = ملفات.اقرا(مسار)
  ارجع حلل_رؤوس(ن, فاصل == عدم ؟ كشف_فاصل(ن) : فاصل)
}
دالة احفظ(مسار, بيانات, فاصل = ",") {
  خل ن = (بيانات.طول > 0 و هل_قاموس(بيانات[0])) ؟ كتب_قواميس(بيانات, عدم, فاصل) : كتب(بيانات, فاصل)
  ملفات.اكتب(مسار, ن)
}
دالة حلل_tsv(نص) { ارجع حلل_رؤوس(نص, "\t") }
دالة كتب_tsv(قواميس) { ارجع كتب_قواميس(قواميس, عدم, "\t") }

دالة اختر(قواميس, ع) {
  ارجع قواميس.حول((م) => { خل ن = {}; لكل ك في ع { ن[ك] = م.احصل(ك) }; ارجع ن })
}
دالة رتب_حسب(قواميس, عمود, تنازلي = غلط) {
  ارجع قواميس.انسخ().رتب((أ, ب) => {
    خل س = أ.احصل(عمود); خل ص = ب.احصل(عمود)
    خل ر = س == ص ؟ 0 : (س < ص ؟ -1 : 1)
    ارجع تنازلي ؟ -ر : ر
  })
}
دالة جمّع_حسب(قواميس, عمود) {
  خل ناتج = {}
  لكل م في قواميس {
    خل ك = نسق("{}", م.احصل(عمود))
    اذا ليس (ك في ناتج) { ناتج[ك] = [] }
    ناتج[ك].اضف(م)
  }
  ارجع ناتج
}
دالة _ارقام(قواميس, عمود) { ارجع قواميس.حول((م) => م.احصل(عمود)).رشح((ق) => هل_رقم(ق)) }
دالة مجموع(قواميس, عمود) { خل ج = 0; لكل ق في _ارقام(قواميس, عمود) { ج += ق } ارجع ج }
دالة متوسط(قواميس, عمود) { خل ق = _ارقام(قواميس, عمود); ارجع ق.طول == 0 ؟ عدم : مجموع(قواميس, عمود) / ق.طول }
دالة اعلى(قواميس, عمود) { خل ق = _ارقام(قواميس, عمود); اذا ق.طول == 0 { ارجع عدم }; خل ر = ق[0]; لكل س في ق { اذا س > ر { ر = س } } ارجع ر }
دالة ادنى(قواميس, عمود) { خل ق = _ارقام(قواميس, عمود); اذا ق.طول == 0 { ارجع عدم }; خل ر = ق[0]; لكل س في ق { اذا س < ر { ر = س } } ارجع ر }
دالة عمود(قواميس, عمود) { ارجع قواميس.حول((م) => م.احصل(عمود)) }
دالة فريد_حسب(قواميس, عمود) {
  خل رأيت = {}; خل ناتج = []
  لكل م في قواميس {
    خل ك = نسق("{}", م.احصل(عمود))
    اذا ليس (ك في رأيت) { رأيت[ك] = صح; ناتج.اضف(م) }
  }
  ارجع ناتج
}

دالة اعرض(بيانات, رؤوس = عدم, حد = 40) {
  خل صفوف = []; خل ر = []
  اذا بيانات.طول > 0 و هل_قاموس(بيانات[0]) {
    ر = رؤوس == عدم ؟ اعمدة(بيانات) : رؤوس
    لكل م في بيانات { صفوف.اضف(ر.حول((ك) => م.احصل(ك))) }
  } والا {
    ر = رؤوس == عدم ؟ [] : رؤوس
    صفوف = بيانات
  }
  خل خلايا = صفوف.حول((ص) => ص.حول((ق) => نصوص.اقتطع(ق == عدم ؟ "" : نسق("{}", ق).ابدل("\n", " "), حد)))
  خل ن = ر.طول
  لكل ص في خلايا { اذا ص.طول > ن { ن = ص.طول } }
  خل ع = []
  لكل ج في مدى(ن) {
    خل ا = ج < ر.طول ؟ الوان.طول_مرئي(ر[ج]) : 0
    لكل ص في خلايا { اذا ج < ص.طول و الوان.طول_مرئي(ص[ج]) > ا { ا = الوان.طول_مرئي(ص[ج]) } }
    ع.اضف(ا)
  }
  دالة خط(طرف1, ربط, طرف2) { ارجع طرف1 + ع.حول((ق) => "─" * (ق + 2)).ادمج(ربط) + طرف2 }
  دالة صف(ص) {
    خل ا = []
    لكل ج في مدى(ع.طول) {
      خل ق = ج < ص.طول ؟ ص[ج] : ""
      ا.اضف(" " + ق + " " * (ع[ج] - الوان.طول_مرئي(ق)) + " ")
    }
    ارجع "│" + ا.ادمج("│") + "│"
  }
  خل خ = [خط("┌", "┬", "┐")]
  اذا ر.طول > 0 { خ.اضف(صف(ر)); خ.اضف(خط("├", "┼", "┤")) }
  لكل ي في مدى(خلايا.طول) {
    خل س = خلايا[ي]
    خل ا = []
    لكل ج في مدى(ع.طول) {
      خل ق = ج < س.طول ؟ س[ج] : ""
      خل مسافة = ع[ج] - الوان.طول_مرئي(ق)
      خل خام = (ج < صفوف[ي].طول) ؟ صفوف[ي][ج] : عدم
      ا.اضف(" " + (هل_رقم(خام) ؟ " " * مسافة + ق : ق + " " * مسافة) + " ")
    }
    خ.اضف("│" + ا.ادمج("│") + "│")
  }
  خ.اضف(خط("└", "┴", "┘"))
  ارجع خ.ادمج("\n")
}
