استورد "زمن"
استورد "ملفات"
استورد "ألوان"
استورد "جيسون"

خل _مستويات = {"تصحيح": 10, "معلومة": 20, "تحذير": 30, "خطأ": 40, "حرج": 50}
خل _اسماء = [[10, "تصحيح"], [20, "معلومة"], [30, "تحذير"], [40, "خطأ"], [50, "حرج"]]
خل _اعداد = {"مستوى": 20, "ملف": عدم, "صيغة": "نص", "لون": صح, "حجم_اقصى": 0, "نسخ": 3, "زمن": "%Y-%m-%d %H:%M:%S", "طرفية": صح}
خل _معالجات = []

دالة _رقم_مستوى(م) {
  اذا هل_نص(م) {
    خل ر = _مستويات.احصل(م)
    اذا ر == عدم { ارمي "مستوى سجل غير معروف: ${م}" }
    ارجع ر
  }
  ارجع م
}
دالة _اسم_مستوى(رقم) {
  خل اسم = "تصحيح"
  لكل ز في _اسماء { اذا رقم >= ز[0] { اسم = ز[1] } }
  ارجع اسم
}
دالة اعداد(م) {
  لكل ك، ق في م {
    اذا ك == "مستوى" { _اعداد[ك] = _رقم_مستوى(ق) }
    والا { _اعداد[ك] = ق }
  }
}
دالة مستوى(م) { _اعداد["مستوى"] = _رقم_مستوى(م) }
دالة ملف(مسار) { _اعداد["ملف"] = مسار }
دالة صيغة(ص) { _اعداد["صيغة"] = ص }
دالة اضف_معالج(ف) { _معالجات.اضف(ف) }
دالة امسح_المعالجات() { _معالجات.امسح() }
دالة _دوّر(مسار) {
  خل حد = _اعداد["حجم_اقصى"]
  اذا حد <= 0 او ليس ملفات.موجود(مسار) { ارجع }
  اذا ملفات.حجم(مسار) < حد { ارجع }
  خل ن = _اعداد["نسخ"]
  اذا ن < 1 { ملفات.احذف(مسار); ارجع }
  اذا ملفات.موجود(مسار + "." + نص(ن)) { ملفات.احذف(مسار + "." + نص(ن)) }
  خل ي = ن - 1
  طالما ي >= 1 {
    اذا ملفات.موجود(مسار + "." + نص(ي)) { ملفات.انقل(مسار + "." + نص(ي), مسار + "." + نص(ي + 1)) }
    ي -= 1
  }
  ملفات.انقل(مسار, مسار + ".1")
}
دالة _لون(رقم, ن) {
  اذا رقم >= 50 { ارجع الوان.غامق(الوان.احمر(ن)) }
  اذا رقم >= 40 { ارجع الوان.احمر(ن) }
  اذا رقم >= 30 { ارجع الوان.اصفر(ن) }
  اذا رقم >= 20 { ارجع الوان.سماوي(ن) }
  ارجع الوان.رمادي(ن)
}
دالة _اكتب(رقم, مسجل, قيم) {
  اذا رقم < _اعداد["مستوى"] { ارجع }
  خل رسالة = ""
  لكل س، ق في قيم { رسالة += (س > 0 ؟ " " : "") + نسق("{}", ق) }
  خل اسم = _اسم_مستوى(رقم)
  خل وقت = زمن.تنسيق(_اعداد["زمن"])
  خل سطر = ""
  اذا _اعداد["صيغة"] == "جيسون" {
    خل س = {"زمن": زمن.تنسيق("%Y-%m-%dT%H:%M:%S"), "مستوى": اسم, "رسالة": رسالة}
    اذا مسجل.اسم != "" { س["مسجل"] = مسجل.اسم }
    لكل ك، ق في مسجل.حقول { س[ك] = ق }
    سطر = جيسون.ترميز(س)
  }
  والا {
    سطر = "[" + وقت + "] [" + اسم + "] "
    اذا مسجل.اسم != "" { سطر += "[" + مسجل.اسم + "] " }
    سطر += رسالة
    لكل ك، ق في مسجل.حقول { سطر += " " + ك + "=" + نسق("{}", ق) }
  }
  اذا _اعداد["ملف"] != عدم {
    _دوّر(_اعداد["ملف"])
    ملفات.الحق(_اعداد["ملف"], سطر + "\n")
  }
  اذا _اعداد["طرفية"] { اطبع(_اعداد["لون"] ؟ _لون(رقم, سطر) : سطر) }
  لكل م في _معالجات { م({"مستوى": رقم, "اسم_المستوى": اسم, "رسالة": رسالة, "مسجل": مسجل.اسم, "حقول": مسجل.حقول, "سطر": سطر}) }
}

صنف مسجل {
  بناء(اسم = "", حقول = {}) { هذا.اسم = اسم; هذا.حقول = حقول }
  مع(ح) {
    خل م = {}
    لكل ك، ق في هذا.حقول { م[ك] = ق }
    لكل ك، ق في ح { م[ك] = ق }
    ارجع مسجل(هذا.اسم, م)
  }
  فرعي(ا) { ارجع مسجل(هذا.اسم == "" ؟ ا : هذا.اسم + "." + ا, هذا.حقول) }
  سجل(م, ...ق) { _اكتب(_رقم_مستوى(م), هذا, ق) }
  تصحيح(...ق) { _اكتب(10, هذا, ق) }
  معلومة(...ق) { _اكتب(20, هذا, ق) }
  تحذير(...ق) { _اكتب(30, هذا, ق) }
  خطأ(...ق) { _اكتب(40, هذا, ق) }
  حرج(...ق) { _اكتب(50, هذا, ق) }
}

خل _افتراضي = مسجل()
دالة جديد(اسم = "", حقول = {}) { ارجع مسجل(اسم, حقول) }
دالة سجل(م, ...ق) { _اكتب(_رقم_مستوى(م), _افتراضي, ق) }
دالة تصحيح(...ق) { _اكتب(10, _افتراضي, ق) }
دالة معلومة(...ق) { _اكتب(20, _افتراضي, ق) }
دالة تحذير(...ق) { _اكتب(30, _افتراضي, ق) }
دالة خطأ(...ق) { _اكتب(40, _افتراضي, ق) }
دالة حرج(...ق) { _اكتب(50, _افتراضي, ق) }
