دالة _هيكس(ه) {
  ه = ه.يبدأ_ب("#") ؟ ه.جزء(1) : ه
  اذا ه.طول == 3 { ه = ه.جزء(0, 1) * 2 + ه.جزء(1, 2) * 2 + ه.جزء(2, 3) * 2 }
  اذا ه.طول != 6 { ارمي "لون هيكس غير صالح: ${ه}" }
  خل ق = "0123456789abcdef"; خل خ = []
  لكل ي في [0, 2, 4] {
    خل ع = ق.ابحث(ه.جزء(ي, ي + 1).صغير()); خل ص = ق.ابحث(ه.جزء(ي + 1, ي + 2).صغير())
    اذا ع < 0 او ص < 0 { ارمي "لون هيكس غير صالح: ${ه}" }
    خ.اضف(ع * 16 + ص)
  }
  ارجع خ
}
دالة هيكس(ه, ن) { خل ق = _هيكس(ه); ارجع rgb(ق[0], ق[1], ق[2], ن) }
دالة خلفية_هيكس(ه, ن) { خل ق = _هيكس(ه); ارجع خلفية_rgb(ق[0], ق[1], ق[2], ن) }
دالة ازل(ن) { ارجع نمط.ابدل("\x1b\\[[0-9;]*m", نسق("{}", ن), "") }
دالة طول_مرئي(ن) { ارجع ازل(ن).طول }
دالة وسوم(ن) {
  ن = نسق("{}", ن)
  خل خ = []; خل ي = 0; خل ط = ن.طول; خل مفتوح = غلط
  طالما ي < ط {
    خل ك = ن.جزء(ي, ي + 1)
    اذا ك == "[" {
      خل ج = ي + 1
      طالما ج < ط و ن.جزء(ج, ج + 1) != "]" { ج += 1 }
      اذا ج < ط {
        خل وسم = ن.جزء(ي + 1, ج)
        اذا وسم == "/" {
          اذا مفتوح و مفعل { خ.اضف("\x1b[0m") }
          مفتوح = غلط
          ي = ج + 1
          استمر
        }
        خل كود = _اسماء.احصل(وسم)
        اذا كود != عدم {
          اذا مفعل { خ.اضف("\x1b[" + كود + "m"); مفتوح = صح }
          ي = ج + 1
          استمر
        }
      }
    }
    خ.اضف(ك)
    ي += 1
  }
  اذا مفتوح و مفعل { خ.اضف("\x1b[0m") }
  ارجع خ.ادمج("")
}
دالة اطار(نص, عنوان = "", حشو = 1) {
  خل سطور = نسق("{}", نص).قسم("\n")
  خل ع = طول_مرئي(عنوان) + 2
  لكل س في سطور { اذا طول_مرئي(س) > ع { ع = طول_مرئي(س) } }
  خل ك = ع + حشو * 2
  خل اعلى = "┌" + "─" * ك + "┐"
  اذا عنوان != "" {
    خل ر = " " + عنوان + " "
    اعلى = "┌" + ر + "─" * (ك - ر.طول) + "┐"
  }
  خل خ = [اعلى]
  لكل س في سطور { خ.اضف("│" + " " * حشو + س + " " * (ع - طول_مرئي(س)) + " " * حشو + "│") }
  خ.اضف("└" + "─" * ك + "┘")
  ارجع خ.ادمج("\n")
}
دالة شريط_تقدم(نسبة, عرض = 20, ممتلئ = "█", باقي = "░") {
  خل ن = نسبة
  اذا ن < 0 { ن = 0 }
  اذا ن > 1 { ن = 1 }
  خل م = رياضيات.قرب(ن * عرض)
  ارجع ممتلئ * م + باقي * (عرض - م) + " " + نسق("{:.0f}", ن * 100) + "%"
}
