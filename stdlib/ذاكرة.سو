استورد "زمن"

صنف ذاكرة_مؤقتة {
  بناء(سعة = 0, عمر = 0) {
    هذا._سعة = سعة; هذا._عمر = عمر; هذا._د = {}
    هذا.اصابات = 0; هذا.اخفاقات = 0
  }
  _ك(مفتاح) { ارجع نوع(مفتاح) + ":" + نسق("{}", مفتاح) }
  _منتهية(مدخل) { ارجع مدخل["حتى"] != عدم و زمن.ساعة() >= مدخل["حتى"] }
  ضع(مفتاح, قيمة, عمر = عدم) {
    خل ك = هذا._ك(مفتاح)
    اذا ك في هذا._د { هذا._د.احذف(ك) }
    خل ع = عمر == عدم ؟ هذا._عمر : عمر
    هذا._د[ك] = {"م": مفتاح, "ق": قيمة, "حتى": ع > 0 ؟ زمن.ساعة() + ع : عدم}
    اذا هذا._سعة > 0 و هذا._د.طول > هذا._سعة {
      لكل س في هذا._د.مفاتيح() { هذا._د.احذف(س); توقف }
    }
    ارجع قيمة
  }
  خذ(مفتاح, افتراضي = عدم) {
    خل ك = هذا._ك(مفتاح)
    خل م = هذا._د.احصل(ك)
    اذا م == عدم { هذا.اخفاقات += 1; ارجع افتراضي }
    اذا هذا._منتهية(م) { هذا._د.احذف(ك); هذا.اخفاقات += 1; ارجع افتراضي }
    هذا._د.احذف(ك)
    هذا._د[ك] = م
    هذا.اصابات += 1
    ارجع م["ق"]
  }
  يوجد(مفتاح) {
    خل م = هذا._د.احصل(هذا._ك(مفتاح))
    ارجع م != عدم و ليس هذا._منتهية(م)
  }
  احذف(مفتاح) { خل ك = هذا._ك(مفتاح); اذا ك في هذا._د { هذا._د.احذف(ك) } ارجع هذا }
  امسح() { هذا._د = {}; ارجع هذا }
  نظف() {
    لكل ك في هذا._د.مفاتيح() { اذا هذا._منتهية(هذا._د[ك]) { هذا._د.احذف(ك) } }
    ارجع هذا._د.طول
  }
  حجم() { ارجع هذا.نظف() }
  مفاتيح() { هذا.نظف(); ارجع هذا._د.قيم().حول((م) => م["م"]) }
  احسب(مفتاح, ف, عمر = عدم) {
    اذا هذا.يوجد(مفتاح) { ارجع هذا.خذ(مفتاح) }
    ارجع هذا.ضع(مفتاح, ف(), عمر)
  }
  احصائيات() {
    خل م = هذا.اصابات + هذا.اخفاقات
    ارجع {"اصابات": هذا.اصابات, "اخفاقات": هذا.اخفاقات, "نسبة_الاصابة": م == 0 ؟ 0 : هذا.اصابات / م, "حجم": هذا.حجم()}
  }
}
دالة جديد(سعة = 0, عمر = 0) { ارجع ذاكرة_مؤقتة(سعة, عمر) }
دالة احفظ_نتيجة(ف, عمر = 0, سعة = 0) {
  خل ذ = ذاكرة_مؤقتة(سعة, عمر)
  ارجع دالة(...وسائط) {
    ارجع ذ.احسب(وسائط, () => ف(...وسائط))
  }
}
