استورد "نظام"
استورد "زمن"
استورد "ألوان"
استورد "نمط"
استورد "جيسون"

خل _قائمة = []
خل _بادئة = []
خل _قبل_كل = []
خل _بعد_كل = []
خل _قبل_الكل = []
خل _بعد_الكل = []

دالة _اسم_كامل(اسم) {
  خل ق = _بادئة.انسخ()
  ق.اضف(اسم)
  ارجع ق.ادمج(" › ")
}
دالة اختبر(اسم, ف) { _قائمة.اضف({"اسم": _اسم_كامل(اسم), "ف": ف, "حالة": "عادي", "قبل": _قبل_كل.انسخ(), "بعد": _بعد_كل.انسخ()}) }
دالة ارجئ(اسم, ف) { _قائمة.اضف({"اسم": _اسم_كامل(اسم), "ف": ف, "حالة": "تخطي", "قبل": [], "بعد": []}) }
دالة فقط(اسم, ف) { _قائمة.اضف({"اسم": _اسم_كامل(اسم), "ف": ف, "حالة": "فقط", "قبل": _قبل_كل.انسخ(), "بعد": _بعد_كل.انسخ()}) }
دالة مجموعة(اسم, ف) {
  _بادئة.اضف(اسم)
  خل ق = _قبل_كل.طول; خل ب = _بعد_كل.طول
  حاول { ف() } اخيرا {
    _بادئة.اسحب()
    _قبل_كل = _قبل_كل.جزء(0, ق)
    _بعد_كل = _بعد_كل.جزء(0, ب)
  }
}
دالة قبل_كل(ف) { _قبل_كل.اضف(ف) }
دالة بعد_كل(ف) { _بعد_كل.اضف(ف) }
دالة قبل_الكل(ف) { _قبل_الكل.اضف(ف) }
دالة بعد_الكل(ف) { _بعد_الكل.اضف(ف) }

دالة _فشل(رسالة) { ارمي {"اختبار_فشل": صح, "رسالة": رسالة} }
دالة _متساو(أ, ب) {
  اذا هل_قاموس(أ) و هل_قاموس(ب) {
    اذا أ.طول != ب.طول { ارجع غلط }
    لكل ك، ق في أ {
      اذا ليس (ك في ب) { ارجع غلط }
      اذا ليس _متساو(ق, ب[ك]) { ارجع غلط }
    }
    ارجع صح
  }
  اذا هل_قائمة(أ) و هل_قائمة(ب) {
    اذا أ.طول != ب.طول { ارجع غلط }
    لكل ي في مدى(أ.طول) { اذا ليس _متساو(أ[ي], ب[ي]) { ارجع غلط } }
    ارجع صح
  }
  ارجع أ == ب
}
دالة _عرض(ق) { ارجع هل_نص(ق) ؟ "\"" + ق + "\"" : نسق("{}", ق) }
دالة _مطلق(س) { ارجع س < 0 ؟ -س : س }

دالة تأكد_ان(شرط, رسالة = "فشل التأكيد") { اذا ليس شرط { _فشل(رسالة) } }
دالة هو_صح(ق, رسالة = "") { اذا ق != صح { _فشل(نسق("المتوقع صح لكن الفعلي {} {}", _عرض(ق), رسالة)) } }
دالة هو_غلط(ق, رسالة = "") { اذا ق != غلط { _فشل(نسق("المتوقع غلط لكن الفعلي {} {}", _عرض(ق), رسالة)) } }
دالة يساوي(فعلي, متوقع, رسالة = "") {
  اذا ليس _متساو(فعلي, متوقع) { _فشل(نسق("المتوقع {} لكن الفعلي {} {}", _عرض(متوقع), _عرض(فعلي), رسالة)) }
}
دالة لا_يساوي(أ, ب, رسالة = "") { اذا _متساو(أ, ب) { _فشل(نسق("القيمتان متساويتان: {} {}", _عرض(أ), رسالة)) } }
دالة قريب(أ, ب, دقة = 0.000001) { اذا _مطلق(أ - ب) > دقة { _فشل(نسق("{} ليست قريبة من {}", أ, ب)) } }
دالة اكبر_من(أ, ب) { اذا ليس (أ > ب) { _فشل(نسق("{} ليست أكبر من {}", أ, ب)) } }
دالة اصغر_من(أ, ب) { اذا ليس (أ < ب) { _فشل(نسق("{} ليست أصغر من {}", أ, ب)) } }
دالة هو_عدم(ق) { اذا ق != عدم { _فشل(نسق("المتوقع عدم لكن الفعلي {}", _عرض(ق))) } }
دالة ليس_عدم(ق) { اذا ق == عدم { _فشل("المتوقع قيمة غير عدم") } }
دالة من_نوع(ق, ن) { اذا نوع(ق) != ن { _فشل(نسق("المتوقع نوع {} لكن الفعلي {}", ن, نوع(ق))) } }
دالة طول_يساوي(ق, ن) { اذا ق.طول != ن { _فشل(نسق("المتوقع طول {} لكن الفعلي {}", ن, ق.طول)) } }
دالة يحتوي(حاوية, عنصر) { اذا ليس (عنصر في حاوية) { _فشل(نسق("{} لا يحتوي {}", _عرض(حاوية), _عرض(عنصر))) } }
دالة لا_يحتوي(حاوية, عنصر) { اذا عنصر في حاوية { _فشل(نسق("{} يحتوي {}", _عرض(حاوية), _عرض(عنصر))) } }
دالة يطابق(س, ن) { اذا ليس نمط.هل(ن, س) { _فشل(نسق("{} لا يطابق النمط {}", _عرض(س), ن)) } }
دالة يرمي(ف, ن = عدم, رسالة = "كان متوقعا حدوث خطأ") {
  خل رمى = غلط; خل خطأ = عدم
  حاول { ف() } امسك (خ) { رمى = صح; خطأ = خ }
  اذا ليس رمى { _فشل(رسالة) }
  اذا ن != عدم {
    خل نص_الخطأ = (هل_قاموس(خطأ) و خطأ.احصل("رسالة") != عدم) ؟ نسق("{}", خطأ["رسالة"]) : نسق("{}", خطأ)
    اذا ليس نص_الخطأ.يحتوي(ن) و ليس نمط.هل(ن, نص_الخطأ) { _فشل(نسق("الخطأ {} لا يطابق {}", _عرض(نص_الخطأ), _عرض(ن))) }
  }
}
دالة لا_يرمي(ف) {
  حاول { ف() } امسك (خ) { _فشل(نسق("لم يكن متوقعا حدوث خطأ: {}", خ)) }
}

دالة وهمية(ناتج = عدم) {
  خل سجل = {"استدعاءات": [], "عدد": 0}
  سجل["ف"] = دالة(...ق) {
    سجل["استدعاءات"].اضف(ق)
    سجل["عدد"] += 1
    ارجع هل_دالة(ناتج) ؟ ناتج(...ق) : ناتج
  }
  ارجع سجل
}
دالة استدعيت_مرات(م, عدد = عدم) {
  اذا عدد == عدم و م["عدد"] == 0 { _فشل("لم تستدعَ الدالة الوهمية") }
  اذا عدد != عدم و م["عدد"] != عدد { _فشل(نسق("المتوقع {} استدعاء لكن الفعلي {}", عدد, م["عدد"])) }
}
دالة استدعيت_بوسائط(م, ...وسائط) {
  لكل ق في م["استدعاءات"] { اذا _متساو(ق, وسائط) { ارجع } }
  _فشل(نسق("لم تستدعَ الدالة بالوسائط {}", _عرض(وسائط)))
}

دالة _حرر(خ) { ارجع (هل_قاموس(خ) و خ.احصل("اختبار_فشل") == صح) ؟ خ["رسالة"] : نسق("{}", خ) }
دالة شغل_الكل(انهاء = صح, مرشح = عدم, تقرير = غلط) {
  خل ناجح = 0; خل فاشل = 0; خل متخطى = 0; خل بداية = زمن.ساعة()
  خل قائمة = _قائمة; _قائمة = []
  خل يوجد_فقط = غلط
  لكل ز في قائمة { اذا ز["حالة"] == "فقط" { يوجد_فقط = صح } }
  خل نتائج = []; خل اخطاء = []
  لكل ف في _قبل_الكل { ف() }
  لكل ز في قائمة {
    خل ب = زمن.ساعة()
    خل اسم = ز["اسم"]
    اذا ز["حالة"] == "تخطي" او (يوجد_فقط و ز["حالة"] != "فقط") او (مرشح != عدم و ليس اسم.يحتوي(مرشح)) {
      متخطى += 1
      اذا ليس تقرير { اطبع(الوان.اصفر("  ○"), اسم) }
      نتائج.اضف({"اسم": اسم, "حالة": "تخطي"})
      استمر
    }
    حاول {
      لكل ف في ز["قبل"] { ف() }
      ز["ف"]()
      لكل ف في ز["بعد"] { ف() }
      ناجح += 1
      خل مللي = (زمن.ساعة() - ب) * 1000
      اذا ليس تقرير { اطبع(الوان.اخضر("  ✓"), اسم, الوان.رمادي(نسق("({:.0f}ms)", مللي))) }
      نتائج.اضف({"اسم": اسم, "حالة": "نجاح", "مللي": مللي})
    } امسك (خ) {
      فاشل += 1
      خل م = _حرر(خ)
      حاول { لكل ف في ز["بعد"] { ف() } } امسك (ق) { }
      اذا ليس تقرير { اطبع(الوان.احمر("  ✗"), اسم, "—", م) }
      نتائج.اضف({"اسم": اسم, "حالة": "فشل", "رسالة": م})
      اخطاء.اضف({"اسم": اسم, "رسالة": م})
    }
  }
  لكل ف في _بعد_الكل { ف() }
  خل مجموع = {"ناجح": ناجح, "فاشل": فاشل, "متخطى": متخطى, "ثواني": زمن.ساعة() - بداية, "نتائج": نتائج}
  اذا تقرير { ارجع جيسون.ترميز(مجموع) }
  اطبع()
  اطبع(الوان.غامق(نسق("{} ناجح، {} فاشل، {} متخطى ({:.2f} ث)", ناجح, فاشل, متخطى, مجموع["ثواني"])))
  اذا انهاء و فاشل > 0 { نظام.اخرج(1) }
  ارجع مجموع
}
