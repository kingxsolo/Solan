استورد "نظام"
استورد "سوكت"
استورد "جيسون"
استورد "حلقة"

خل _مفتوحة = []

دالة _ارسل(م, قيمة) { سوكت.ارسل(م, جيسون.ترميز(قيمة) + "\n") }
دالة _اقرأ(م) {
  خل س = سوكت.سطر(م)
  اذا س == عدم { ارجع عدم }
  ارجع جيسون.فك(س)
}

صنف قناة {
  بناء(م) { هذا.م = م }
  ارسل(رسالة) { _ارسل(هذا.م, رسالة) }
  استقبل() { ارجع _اقرأ(هذا.م) }
}

صنف عامل {
  بناء(م, pid) {
    هذا.م = م
    هذا.pid = pid
    هذا.حي = صح
    هذا._رقم = 0
    هذا._معلق = {}
    هذا._عند = عدم
    هذا._يراقب = غلط
  }
  ارسل(رسالة) { _ارسل(هذا.م, رسالة) }
  استقبل() { ارجع _اقرأ(هذا.م) }
  عند_رسالة(ف) { هذا._عند = ف; هذا._راقب() }
  اطلب(رسالة) {
    هذا._رقم += 1
    خل ر = هذا._رقم
    خل وع = وعد()
    هذا._معلق[نص(ر)] = وع
    _ارسل(هذا.م, {"ر": ر, "ب": رسالة})
    هذا._راقب()
    ارجع وع
  }
  _راقب() {
    اذا هذا._يراقب { ارجع }
    هذا._يراقب = صح
    خل ذا = هذا
    حلقة.راقب(هذا.م, دالة(م) {
      خل ر = _اقرأ(م)
      اذا ر == عدم {
        حلقة.الغ_مراقبة(م); ذا._يراقب = غلط; ذا.حي = غلط
        لكل ك في ذا._معلق.مفاتيح() { ذا._معلق[ك].ارفض("انتهى العامل قبل الرد") }
        ذا._معلق = {}
        ارجع
      }
      اذا ر.احصل("ر") != عدم {
        خل ك = نص(ر["ر"])
        خل وع = ذا._معلق[ك]
        اذا وع != عدم {
          ذا._معلق[ك] = عدم
          اذا ر.احصل("خطأ") != عدم { وع.ارفض(ر["خطأ"]) } والا { وع.حل(ر.احصل("قيمة")) }
        }
      } والا اذا ذا._عند { ذا._عند(ر) }
    })
  }
  انهِ() {
    اذا ليس هذا.حي { ارجع }
    هذا.حي = غلط
    حاول { حلقة.الغ_مراقبة(هذا.م) } امسك (خ) { }
    خل م = هذا.م
    _مفتوحة = _مفتوحة.رشح((ق) => ق != م)
    سوكت.اغلق(هذا.م)
    حاول { نظام.اقتل(هذا.pid) } امسك (خ) { }
    نظام.انتظر_عملية(هذا.pid)
  }
}

دالة انشئ(ف) {
  خل قدامى = _مفتوحة.انسخ()
  خل ع = نظام.عامل(دالة(م) {
    لكل ق في قدامى { حاول { سوكت.اغلق(ق) } امسك (خ) { } }
    ف(قناة(م))
  })
  خل ك = عامل(ع.مقبض, ع.pid)
  _مفتوحة.اضف(ع.مقبض)
  ارجع ك
}

دالة خادم_طلبات(معالج) {
  ارجع دالة(ق) {
    طالما صح {
      خل ر = ق.استقبل()
      اذا ر == عدم { ارجع }
      حاول { ق.ارسل({"ر": ر["ر"], "قيمة": معالج(ر["ب"])}) }
      امسك (خ) { ق.ارسل({"ر": ر["ر"], "خطأ": نص(خ)}) }
    }
  }
}

صنف مجمع {
  بناء(عدد, معالج) {
    هذا.عمال = []
    هذا._انشغال = []
    كرر عدد {
      هذا.عمال.اضف(انشئ(خادم_طلبات(معالج)))
      هذا._انشغال.اضف(0)
    }
  }
  نفذ(بيانات) {
    خل افضل = 0
    لكل ط في مدى(هذا.عمال.طول) { اذا هذا._انشغال[ط] < هذا._انشغال[افضل] { افضل = ط } }
    هذا._انشغال[افضل] += 1
    خل ذا = هذا
    خل وع = هذا.عمال[افضل].اطلب(بيانات)
    ارجع وع.ثم(دالة(ق) { ذا._انشغال[افضل] -= 1; ارجع ق }).التقط(دالة(خ) { ذا._انشغال[افضل] -= 1; ارمي خ })
  }
  حول(قائمة) { ارجع كل_الوعود(قائمة.حول((ع) => هذا.نفذ(ع))) }
  اغلق() { لكل ع في هذا.عمال { ع.انهِ() } }
}

دالة مجمع_جديد(عدد, معالج) { ارجع مجمع(عدد, معالج) }
