استورد "عشوائي"
استورد "رياضيات"
استورد "نظام"

صنف بناء {
  بناء() { هذا._ق = [] }
  اضف(س) { هذا._ق.اضف(س); ارجع هذا }
  سطر(س = "") { هذا._ق.اضف(س); هذا._ق.اضف("\n"); ارجع هذا }
  امسح() { هذا._ق = []; ارجع هذا }
  نص() {
    خل ن = هذا._ق.ادمج("")
    هذا._ق = [ن]
    ارجع ن
  }
  طول() { ارجع هذا.نص().طول }
}
دالة جديد() { ارجع بناء() }

خل _فراغ = " \t\n\r"
خل _تشكيل = {}
لكل ر في مدى(1611, 1632) { _تشكيل[حرف(ر)] = صح }
_تشكيل[حرف(1648)] = صح
_تشكيل[حرف(1600)] = صح
خل _ترقيم = {}
لكل ر في [1548, 1563, 1567, 1470, 171, 187, 160] { _ترقيم[حرف(ر)] = صح }

دالة هل_فارغ(س) { ارجع س == عدم او س.نظف() == "" }
دالة نظف_يسار(س) {
  خل ي = 0
  طالما ي < س.طول و _فراغ.يحتوي(س.جزء(ي, ي + 1)) { ي += 1 }
  ارجع س.جزء(ي)
}
دالة نظف_يمين(س) {
  خل ن = س.طول
  طالما ن > 0 و _فراغ.يحتوي(س.جزء(ن - 1, ن)) { ن -= 1 }
  ارجع س.جزء(0, ن)
}
دالة ازل_بادئة(س, ب) { ارجع (ب != "" و س.يبدأ_ب(ب)) ؟ س.جزء(ب.طول) : س }
دالة ازل_لاحقة(س, ل) { ارجع (ل != "" و س.ينتهي_ب(ل)) ؟ س.جزء(0, س.طول - ل.طول) : س }
دالة يبدأ_باحد(س, قائمة) { لكل ق في قائمة { اذا س.يبدأ_ب(ق) { ارجع صح } } ارجع غلط }
دالة ينتهي_باحد(س, قائمة) { لكل ق في قائمة { اذا س.ينتهي_ب(ق) { ارجع صح } } ارجع غلط }
دالة اقتطع(س, حد, لاحقة = "…") {
  اذا س.طول <= حد { ارجع س }
  خل ن = حد - لاحقة.طول
  اذا ن < 0 { ن = 0 }
  ارجع س.جزء(0, ن) + لاحقة
}
دالة كلمات(س) { ارجع س.ابدل("\n", " ").ابدل("\t", " ").ابدل("\r", " ").قسم(" ").رشح((ك) => ك != "") }
دالة عدد_كلمات(س) { ارجع كلمات(س).طول }
دالة عد(س, ج) {
  اذا ج == "" { ارجع 0 }
  ارجع س.قسم(ج).طول - 1
}
دالة املأ_يسار(س, ع, ح = " ") {
  س = نسق("{}", س)
  اذا س.طول >= ع { ارجع س }
  ارجع ح * (ع - س.طول) + س
}
دالة املأ_يمين(س, ع, ح = " ") {
  س = نسق("{}", س)
  اذا س.طول >= ع { ارجع س }
  ارجع س + ح * (ع - س.طول)
}
دالة وسّط(س, ع, ح = " ") {
  س = نسق("{}", س)
  اذا س.طول >= ع { ارجع س }
  خل ك = ع - س.طول
  خل ي = رياضيات.ارضي(ك / 2)
  ارجع ح * ي + س + ح * (ك - ي)
}
دالة صفر_بادئ(رقم, ع) { ارجع املأ_يسار(رقم, ع, "0") }
دالة لف(س, عرض) {
  خل سطور = []; خل حالي = ""
  لكل ك في كلمات(س) {
    اذا حالي == "" { حالي = ك }
    والا اذا حالي.طول + 1 + ك.طول <= عرض { حالي += " " + ك }
    والا { سطور.اضف(حالي); حالي = ك }
  }
  اذا حالي != "" { سطور.اضف(حالي) }
  ارجع سطور.ادمج("\n")
}
دالة ازل_التشكيل(س) {
  خل خ = []
  لكل ك في س.حروف() { اذا ليس (ك في _تشكيل) { خ.اضف(ك) } }
  ارجع خ.ادمج("")
}
دالة طبّع_عربي(س) { ارجع نظام.طبّع(ازل_التشكيل(س)) }
دالة هل_عربي(س) {
  لكل ك في س.حروف() { خل ر = رمز(ك); اذا ر >= 1569 و ر <= 1610 { ارجع صح } }
  ارجع غلط
}
دالة هل_ارقام(س) {
  اذا س == "" { ارجع غلط }
  لكل ك في س.حروف() {
    خل ر = رمز(ك)
    اذا ليس ((ر >= 48 و ر <= 57) او (ر >= 1632 و ر <= 1641) او (ر >= 1776 و ر <= 1785)) { ارجع غلط }
  }
  ارجع صح
}
دالة الى_هندية(س) {
  خل خ = []
  لكل ك في نسق("{}", س).حروف() {
    خل ر = رمز(ك)
    خ.اضف((ر >= 48 و ر <= 57) ؟ حرف(1632 + ر - 48) : ك)
  }
  ارجع خ.ادمج("")
}
دالة الى_غربية(س) {
  خل خ = []
  لكل ك في نسق("{}", س).حروف() {
    خل ر = رمز(ك)
    اذا ر >= 1632 و ر <= 1641 { خ.اضف(حرف(48 + ر - 1632)) }
    والا اذا ر >= 1776 و ر <= 1785 { خ.اضف(حرف(48 + ر - 1776)) }
    والا { خ.اضف(ك) }
  }
  ارجع خ.ادمج("")
}
دالة _حرف_كلمة(ك) {
  خل ر = رمز(ك)
  اذا (ر >= 48 و ر <= 57) او (ر >= 65 و ر <= 90) او (ر >= 97 و ر <= 122) { ارجع صح }
  اذا ك في _ترقيم او ك في _تشكيل { ارجع غلط }
  ارجع ر >= 1569 و ر <= 1791 او ر >= 192 و ر <= 591
}
دالة مفكك(س) {
  خل كلم = []; خل حالي = ""; خل سابق = ""
  لكل ك في نسق("{}", س).حروف() {
    اذا ليس _حرف_كلمة(ك) {
      اذا حالي != "" { كلم.اضف(حالي); حالي = "" }
    }
    والا {
      اذا حالي != "" و ك != ك.صغير() و سابق == سابق.صغير() و سابق != سابق.كبير() { كلم.اضف(حالي); حالي = "" }
      حالي += ك
    }
    سابق = ك
  }
  اذا حالي != "" { كلم.اضف(حالي) }
  ارجع كلم.حول((ك) => ك.صغير())
}
دالة ثعباني(س) { ارجع مفكك(س).ادمج("_") }
دالة وصلات(س) { ارجع مفكك(س).ادمج("-") }
دالة جمل(س) {
  خل ك = مفكك(س)
  اذا ك.طول == 0 { ارجع "" }
  ارجع ك[0] + ك.جزء(1).حول((ح) => ح.جزء(0, 1).كبير() + ح.جزء(1)).ادمج("")
}
دالة باسكال(س) { ارجع مفكك(س).حول((ح) => ح.جزء(0, 1).كبير() + ح.جزء(1)).ادمج("") }
دالة عنوان(س) {
  ارجع كلمات(س).حول((ح) => ح.جزء(0, 1).كبير() + ح.جزء(1).صغير()).ادمج(" ")
}
دالة وصلة_رابط(س) {
  خل خ = []; خل فاصل = غلط
  لكل ك في ازل_التشكيل(نسق("{}", س)).صغير().حروف() {
    اذا _حرف_كلمة(ك) { اذا فاصل و خ.طول > 0 { خ.اضف("-") }; فاصل = غلط; خ.اضف(ك) }
    والا { فاصل = صح }
  }
  ارجع خ.ادمج("")
}
دالة مسافة(أ, ب) {
  خل س = أ.حروف(); خل ص = ب.حروف()
  اذا س.طول == 0 { ارجع ص.طول }
  اذا ص.طول == 0 { ارجع س.طول }
  خل سابق = مدى(0, ص.طول + 1)
  لكل ي في مدى(س.طول) {
    خل حالي = [ي + 1]
    لكل ج في مدى(ص.طول) {
      خل كلفة = س[ي] == ص[ج] ؟ 0 : 1
      حالي.اضف(رياضيات.اصغر(رياضيات.اصغر(حالي[ج] + 1, سابق[ج + 1] + 1), سابق[ج] + كلفة))
    }
    سابق = حالي
  }
  ارجع سابق[ص.طول]
}
دالة تشابه(أ, ب) {
  خل ك = رياضيات.اكبر(أ.طول, ب.طول)
  اذا ك == 0 { ارجع 1 }
  ارجع 1 - مسافة(أ, ب) / ك
}
دالة اقرب(س, خيارات, حد = 0.6) {
  خل افضل = عدم; خل درجة = 0
  لكل خ في خيارات {
    خل د = تشابه(س, خ)
    اذا د > درجة { درجة = د; افضل = خ }
  }
  ارجع درجة >= حد ؟ افضل : عدم
}
دالة رمز_عشوائي(ط = 16, ابجدية = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789") {
  خل ح = ابجدية.حروف(); خل خ = []
  كرر ط { خ.اضف(ح[عشوائي.صحيح(0, ح.طول - 1)]) }
  ارجع خ.ادمج("")
}
