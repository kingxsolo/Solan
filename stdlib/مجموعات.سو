استورد "عشوائي"

دالة _مفتاح(ق) { ارجع نوع(ق) + ":" + نسق("{}", ق) }

صنف مجموعة_فريدة {
  بناء(عناصر = []) {
    هذا._د = {}
    لكل ع في عناصر { هذا.اضف(ع) }
  }
  اضف(ع) { هذا._د[_مفتاح(ع)] = ع; ارجع هذا }
  احذف(ع) { خل ك = _مفتاح(ع); اذا ك في هذا._د { هذا._د[ك] = عدم; هذا._د.احذف(ك) } ارجع هذا }
  يحتوي(ع) { ارجع _مفتاح(ع) في هذا._د }
  حجم() { ارجع هذا._د.طول }
  فارغة() { ارجع هذا._د.طول == 0 }
  قيم() { ارجع هذا._د.قيم() }
  الى_قائمة() { ارجع هذا._د.قيم() }
  امسح() { هذا._د = {}; ارجع هذا }
  لكل_عنصر(ف) { لكل ع في هذا._د.قيم() { ف(ع) } }
  حول(ف) { ارجع مجموعة_فريدة(هذا.قيم().حول(ف)) }
  رشح(ف) { ارجع مجموعة_فريدة(هذا.قيم().رشح(ف)) }
  اتحاد(ا) { خل ن = مجموعة_فريدة(هذا.قيم()); لكل ع في ا.قيم() { ن.اضف(ع) } ارجع ن }
  تقاطع(ا) { ارجع هذا.رشح((ع) => ا.يحتوي(ع)) }
  فرق(ا) { ارجع هذا.رشح((ع) => ليس ا.يحتوي(ع)) }
  فرق_متماثل(ا) { ارجع هذا.فرق(ا).اتحاد(ا.فرق(هذا)) }
  هل_جزء_من(ا) { لكل ع في هذا.قيم() { اذا ليس ا.يحتوي(ع) { ارجع غلط } } ارجع صح }
  يساوي(ا) { ارجع هذا.حجم() == ا.حجم() و هذا.هل_جزء_من(ا) }
}
دالة مجموعة_من(عناصر = []) { ارجع مجموعة_فريدة(عناصر) }

صنف طابور {
  بناء() { هذا._ق = []; هذا._ر = 0 }
  ادفع(ع) { هذا._ق.اضف(ع); ارجع هذا }
  اسحب() {
    اذا هذا.فارغ() { ارمي "الطابور فارغ" }
    خل ع = هذا._ق[هذا._ر]
    هذا._ق[هذا._ر] = عدم
    هذا._ر += 1
    اذا هذا._ر > 64 و هذا._ر * 2 > هذا._ق.طول { هذا._ق = هذا._ق.جزء(هذا._ر); هذا._ر = 0 }
    ارجع ع
  }
  انظر() { اذا هذا.فارغ() { ارمي "الطابور فارغ" } ارجع هذا._ق[هذا._ر] }
  حجم() { ارجع هذا._ق.طول - هذا._ر }
  فارغ() { ارجع هذا._ق.طول == هذا._ر }
  الى_قائمة() { ارجع هذا._ق.جزء(هذا._ر) }
  امسح() { هذا._ق = []; هذا._ر = 0; ارجع هذا }
}

صنف مكدس {
  بناء() { هذا._ق = [] }
  ادفع(ع) { هذا._ق.اضف(ع); ارجع هذا }
  اسحب() { اذا هذا._ق.طول == 0 { ارمي "المكدس فارغ" } ارجع هذا._ق.اسحب() }
  انظر() { اذا هذا._ق.طول == 0 { ارمي "المكدس فارغ" } ارجع هذا._ق[هذا._ق.طول - 1] }
  حجم() { ارجع هذا._ق.طول }
  فارغ() { ارجع هذا._ق.طول == 0 }
  الى_قائمة() { ارجع هذا._ق.انسخ() }
  امسح() { هذا._ق = []; ارجع هذا }
}

صنف ثنائي_الطرف {
  بناء() { هذا._د = {}; هذا._أ = 0; هذا._ب = 0 }
  اضف_خلف(ع) { هذا._د[نص(هذا._ب)] = ع; هذا._ب += 1; ارجع هذا }
  اضف_امام(ع) { هذا._أ -= 1; هذا._د[نص(هذا._أ)] = ع; ارجع هذا }
  ازل_امام() {
    اذا هذا.فارغ() { ارمي "فارغ" }
    خل ك = نص(هذا._أ); خل ع = هذا._د[ك]; هذا._د.احذف(ك); هذا._أ += 1
    ارجع ع
  }
  ازل_خلف() {
    اذا هذا.فارغ() { ارمي "فارغ" }
    هذا._ب -= 1
    خل ك = نص(هذا._ب); خل ع = هذا._د[ك]; هذا._د.احذف(ك)
    ارجع ع
  }
  امام() { اذا هذا.فارغ() { ارمي "فارغ" } ارجع هذا._د[نص(هذا._أ)] }
  خلف() { اذا هذا.فارغ() { ارمي "فارغ" } ارجع هذا._د[نص(هذا._ب - 1)] }
  حجم() { ارجع هذا._ب - هذا._أ }
  فارغ() { ارجع هذا._ب == هذا._أ }
  الى_قائمة() { خل ق = []; لكل ي في مدى(هذا._أ, هذا._ب) { ق.اضف(هذا._د[نص(ي)]) } ارجع ق }
}

صنف كومة {
  بناء(اصغر_اولا = صح, مفتاح = عدم) {
    هذا._ق = []; هذا._اص = اصغر_اولا; هذا._م = مفتاح
  }
  _اقل(أ, ب) {
    خل س = هذا._م == عدم ؟ أ : هذا._م(أ); خل ص = هذا._م == عدم ؟ ب : هذا._م(ب)
    ارجع هذا._اص ؟ س < ص : س > ص
  }
  ادفع(ع) {
    هذا._ق.اضف(ع)
    خل ي = هذا._ق.طول - 1
    طالما ي > 0 {
      خل ا = (ي - 1 - ((ي - 1) % 2)) / 2
      اذا هذا._اقل(هذا._ق[ي], هذا._ق[ا]) { خل ت = هذا._ق[ي]; هذا._ق[ي] = هذا._ق[ا]; هذا._ق[ا] = ت; ي = ا }
      والا { توقف }
    }
    ارجع هذا
  }
  اسحب() {
    اذا هذا._ق.طول == 0 { ارمي "الكومة فارغة" }
    خل اول = هذا._ق[0]
    خل اخر = هذا._ق.اسحب()
    اذا هذا._ق.طول > 0 {
      هذا._ق[0] = اخر
      خل ي = 0; خل ن = هذا._ق.طول
      طالما صح {
        خل ل = 2 * ي + 1; خل ر = ل + 1; خل ص = ي
        اذا ل < ن و هذا._اقل(هذا._ق[ل], هذا._ق[ص]) { ص = ل }
        اذا ر < ن و هذا._اقل(هذا._ق[ر], هذا._ق[ص]) { ص = ر }
        اذا ص == ي { توقف }
        خل ت = هذا._ق[ي]; هذا._ق[ي] = هذا._ق[ص]; هذا._ق[ص] = ت; ي = ص
      }
    }
    ارجع اول
  }
  انظر() { اذا هذا._ق.طول == 0 { ارمي "الكومة فارغة" } ارجع هذا._ق[0] }
  حجم() { ارجع هذا._ق.طول }
  فارغة() { ارجع هذا._ق.طول == 0 }
}

دالة عداد(قائمة) {
  خل م = {}
  لكل ع في قائمة { خل ك = نسق("{}", ع); م[ك] = م.احصل(ك, 0) + 1 }
  ارجع م
}
دالة الاكثر_شيوعا(قائمة, ن = 3) {
  خل م = عداد(قائمة); خل ازواج = []
  لكل ك، ق في م { ازواج.اضف([ك, ق]) }
  ارجع ازواج.رتب((أ, ب) => ب[1] - أ[1]).جزء(0, ن)
}
دالة فريد(قائمة) { ارجع مجموعة_فريدة(قائمة).قيم() }
دالة دفعات(قائمة, حجم) {
  خل ن = []
  لكل ي في مدى(0, قائمة.طول, حجم) { ن.اضف(قائمة.جزء(ي, ي + حجم)) }
  ارجع ن
}
دالة نوافذ(قائمة, حجم) {
  خل ن = []
  لكل ي في مدى(0, قائمة.طول - حجم + 1) { ن.اضف(قائمة.جزء(ي, ي + حجم)) }
  ارجع ن
}
دالة ازواج(أ, ب) {
  خل ن = []
  لكل ي في مدى(أ.طول < ب.طول ؟ أ.طول : ب.طول) { ن.اضف([أ[ي], ب[ي]]) }
  ارجع ن
}
دالة سطّح(قائمة, عمق = 1) {
  خل ن = []
  لكل ع في قائمة { اذا هل_قائمة(ع) و عمق > 0 { لكل س في سطّح(ع, عمق - 1) { ن.اضف(س) } } والا { ن.اضف(ع) } }
  ارجع ن
}
دالة جمّع(قائمة, ف) {
  خل م = {}
  لكل ع في قائمة {
    خل ك = نسق("{}", ف(ع))
    اذا ليس (ك في م) { م[ك] = [] }
    م[ك].اضف(ع)
  }
  ارجع م
}
دالة قسّم_حسب(قائمة, شرط) {
  خل ا = []; خل ب = []
  لكل ع في قائمة { اذا شرط(ع) { ا.اضف(ع) } والا { ب.اضف(ع) } }
  ارجع [ا, ب]
}
دالة خلط(قائمة) {
  خل ن = قائمة.انسخ()
  خل ي = ن.طول - 1
  طالما ي > 0 {
    خل ج = عشوائي.صحيح(0, ي)
    خل ت = ن[ي]; ن[ي] = ن[ج]; ن[ج] = ت
    ي -= 1
  }
  ارجع ن
}
دالة عينة(قائمة, ن = 1) { ارجع خلط(قائمة).جزء(0, ن) }
دالة مجموع(قائمة) { خل ج = 0; لكل ع في قائمة { ج += ع } ارجع ج }
دالة اكبر(قائمة, ف = عدم) {
  اذا قائمة.طول == 0 { ارجع عدم }
  خل ر = قائمة[0]
  لكل ع في قائمة { اذا (ف == عدم ؟ ع : ف(ع)) > (ف == عدم ؟ ر : ف(ر)) { ر = ع } }
  ارجع ر
}
دالة اصغر(قائمة, ف = عدم) {
  اذا قائمة.طول == 0 { ارجع عدم }
  خل ر = قائمة[0]
  لكل ع في قائمة { اذا (ف == عدم ؟ ع : ف(ع)) < (ف == عدم ؟ ر : ف(ر)) { ر = ع } }
  ارجع ر
}
دالة ادمج_قواميس(...ق) {
  خل ن = {}
  لكل م في ق { لكل ك، ف في م { ن[ك] = ف } }
  ارجع ن
}
دالة عكس_قاموس(م) { خل ن = {}; لكل ك، ق في م { ن[نسق("{}", ق)] = ك } ارجع ن }
