استورد "ملفات"
استورد "جيسون"
استورد "تشفير"
استورد "نظام"
استورد "عشوائي"

خل البيان = "solan.json"
خل القفل = "solan.lock"
خل الحد_الاقصى_للملفات = 5000
خل الحد_الاقصى_للحجم = 52428800
خل الحد_الاقصى_للحزم = 500
خل الحد_الاقصى_للسجل = 500

خل البيت = نظام.بيت_سولان(ملفات.مسار_مطلق("."))
خل المتجر = البيت + "/store"
خل الكاش = البيت + "/cache"
خل ملف_السجل = البيت + "/projects.json"
خل _وضع = {"محلي": غلط}
خل _مستضيفات_غير_حساسة = ["github.com", "gitlab.com", "bitbucket.org", "codeberg.org"]

دالة _نفذ(قائمة) {
  خل ر = نظام.شغل_قائمة(قائمة)
  اذا ر["رمز"] == 127 و قائمة[0] == "git" {
    ارمي "git غير مثبت أو غير موجود في PATH. ثبّته من https://git-scm.com ثم أعد المحاولة"
  }
  ارجع ر
}
دالة _مسار_داخلي(مسار) {
  ارجع مسار.يبدأ_ب(المتجر + "/") او مسار.يبدأ_ب(الكاش + "/")
}
دالة _انشئ(مسار) {
  اذا ملفات.هل_مجلد(مسار) { ارجع }
  اذا ليس ملفات.انشئ_مجلدات(مسار) او ليس ملفات.هل_مجلد(مسار) { ارمي "تعذّر إنشاء المجلد (تحقق من الصلاحيات أو SOLAN_HOME): " + مسار }
}
دالة _احذف_مجلد(مسار) {
  اذا ليس _مسار_داخلي(مسار) { ارمي "رفض حذف مسار خارج المتجر والكاش: " + مسار }
  ملفات.احذف_شجرة(مسار)
}
دالة _اكتب_ذري(مسار, نص) {
  خل مؤقت = مسار + ".tmp" + نص_عشوائي()
  ملفات.اكتب(مؤقت, نص)
  اذا ملفات.انقل(مؤقت, مسار) { ارجع }
  اذا ملفات.موجود(مسار) { ملفات.احذف(مسار) }
  اذا ليس ملفات.انقل(مؤقت, مسار) { ملفات.احذف(مؤقت); ارمي "تعذّرت الكتابة في " + مسار }
}
دالة نص_عشوائي() { ارجع "." + نص(عشوائي.صحيح(1, 1000000000)) }

دالة _رقمي(ج) {
  اذا طول(ج) == 0 { ارجع غلط }
  لكل ح في ج { اذا ليس "0123456789".يحتوي(ح) { ارجع غلط } }
  ارجع صح
}
دالة _ست_عشري(س) {
  اذا طول(س) == 0 { ارجع غلط }
  لكل ح في س { اذا ليس "0123456789abcdefABCDEF".يحتوي(ح) { ارجع غلط } }
  ارجع صح
}
دالة _سليم(س) {
  اذا ليس هل_نص(س) او طول(س) == 0 او طول(س) > 300 او س[0] == "-" { ارجع غلط }
  لكل ح في س { اذا "'\"\\$`;&|<>()*?{}[]!\n\r\t ".يحتوي(ح) { ارجع غلط } }
  ارجع صح
}
دالة _تحقق(س, ماذا) {
  اذا ليس _سليم(س) { ارمي "قيمة غير صالحة لـ " + ماذا + ": " + نسق("{}", س) }
}
دالة _اسم_اعتمادية(اسم) {
  اذا ليس هل_نص(اسم) او اسم == "" او طول(اسم) > 100 او اسم.يحتوي("/") او اسم.يحتوي("\\") او اسم.يحتوي(" ") او اسم.يحتوي("\"") او اسم.يبدأ_ب(".") {
    ارمي "اسم اعتمادية غير صالح: " + نسق("{}", اسم)
  }
  اذا نظام.مكتبة_قياسية(اسم) {
    ارمي "الاسم '" + اسم + "' محجوز للمكتبة القياسية ولا يمكن تغطيته بحزمة (اختر اسما آخر: solan add اسم_آخر=المصدر)"
  }
}

دالة _اجزاء(نص) {
  اذا ليس هل_نص(نص) { ارجع عدم }
  خل س = نص
  اذا س.يبدأ_ب("v") او س.يبدأ_ب("V") { س = س.جزء(1) }
  اذا س.يحتوي("-") او س.يحتوي("+") { ارجع عدم }
  خل ق = س.قسم(".")
  اذا طول(ق) < 1 او طول(ق) > 3 { ارجع عدم }
  خل ن = []
  لكل ج في ق {
    اذا ليس _رقمي(ج) او طول(ج) > 9 { ارجع عدم }
    ن.اضف(رقم(ج))
  }
  طالما طول(ن) < 3 { ن.اضف(0) }
  ارجع ن
}
دالة _قارن(أ, ب) {
  لكل ي في مدى(3) {
    اذا أ[ي] < ب[ي] { ارجع -1 }
    اذا أ[ي] > ب[ي] { ارجع 1 }
  }
  ارجع 0
}
دالة _عدد_الاجزاء(نص) {
  خل س = نص
  اذا س.يبدأ_ب("v") او س.يبدأ_ب("V") { س = س.جزء(1) }
  ارجع طول(س.قسم("."))
}
دالة _شرط(ن, ش0) {
  خل ش = ش0.نظف()
  اذا ش == "" او ش == "*" او ش == "latest" او ش == "x" او ش == "X" { ارجع صح }
  اذا ش.يبدأ_ب("^") او ش.يبدأ_ب("~") {
    خل ب = _اجزاء(ش.جزء(1))
    اذا ب == عدم { ارجع غلط }
    خل أعلى = [0, 0, 0]
    اذا ش.يبدأ_ب("~") { أعلى = [ب[0], ب[1] + 1, 0] }
    والا اذا ب[0] > 0 { أعلى = [ب[0] + 1, 0, 0] }
    والا اذا ب[1] > 0 { أعلى = [0, ب[1] + 1, 0] }
    والا { أعلى = [0, 0, ب[2] + 1] }
    ارجع _قارن(ن, ب) >= 0 و _قارن(ن, أعلى) < 0
  }
  لكل عامل في [">=", "<=", ">", "<", "="] {
    اذا ش.يبدأ_ب(عامل) {
      خل ب = _اجزاء(ش.جزء(طول(عامل)).نظف())
      اذا ب == عدم { ارجع غلط }
      خل ق = _قارن(ن, ب)
      اذا عامل == ">=" { ارجع ق >= 0 }
      اذا عامل == "<=" { ارجع ق <= 0 }
      اذا عامل == ">" { ارجع ق > 0 }
      اذا عامل == "<" { ارجع ق < 0 }
      ارجع ق == 0
    }
  }
  خل ص = ش.ابدل(".x", "").ابدل(".X", "").ابدل(".*", "")
  خل ب = _اجزاء(ص)
  اذا ب == عدم { ارجع غلط }
  خل ع = _عدد_الاجزاء(ص)
  اذا ع >= 3 { ارجع _قارن(ن, ب) == 0 }
  اذا ع == 2 { ارجع ن[0] == ب[0] و ن[1] == ب[1] }
  ارجع ن[0] == ب[0]
}
دالة _يطابق(ن, نطاق) {
  لكل ش في نطاق.قسم(" ") {
    اذا ش != "" و ليس _شرط(ن, ش) { ارجع غلط }
  }
  ارجع صح
}

دالة _حلل(نص) {
  اذا ليس هل_نص(نص) او نص.نظف() == "" { ارمي "مصدر اعتمادية فارغ أو غير نصي" }
  خل م = نص.نظف()
  خل مرجع = ""
  خل نطاق = ""
  خل ط = م.ابحث("#")
  اذا ط >= 0 { مرجع = م.جزء(ط + 1); م = م.جزء(0, ط) }
  اذا م.يبدأ_ب("./") او م.يبدأ_ب("../") او م.يبدأ_ب("/") او م.يبدأ_ب("~/") او (طول(م) > 2 و م[1] == ":" و (م[2] == "/" او م[2] == "\\")) {
    ارجع {"نوع": "مسار", "مسار": م.ابدل("\\", "/")}
  }
  خل ع = م.اعكس().ابحث("@")
  اذا ع >= 0 {
    خل موضع = طول(م) - 1 - ع
    خل شرطة = م.اعكس().ابحث("/")
    خل موضع_شرطة = شرطة >= 0 ؟ طول(م) - 1 - شرطة : -1
    خل نقطتان = م.اعكس().ابحث(":")
    خل موضع_نقطتين = نقطتان >= 0 ؟ طول(م) - 1 - نقطتان : -1
    اذا موضع > موضع_شرطة و موضع > موضع_نقطتين و موضع > 0 { نطاق = م.جزء(موضع + 1); م = م.جزء(0, موضع) }
  }
  خل رابط = م
  خل معرف = ""
  خل مضيف = ""
  اذا م.يبدأ_ب("git+") { م = م.جزء(4); رابط = م }
  اذا م.يبدأ_ب("file://") {
    معرف = "file" + م.جزء(7)
    مضيف = "file"
  } والا اذا م.يحتوي("://") {
    خل مخطط = م.جزء(0, م.ابحث("://"))
    اذا ليس ["https", "http", "ssh", "git"].يحتوي(مخطط) { ارمي "بروتوكول غير مسموح: " + مخطط + " (المسموح: https, http, ssh, git, file)" }
    خل ب = م.جزء(م.ابحث("://") + 3)
    خل ا = ب.ابحث("@")
    خل ش = ب.ابحث("/")
    اذا ا >= 0 و (ش < 0 او ا < ش) { ب = ب.جزء(ا + 1) }
    معرف = ب
    مضيف = ب.قسم("/")[0].قسم(":")[0]
  } والا اذا م.يبدأ_ب("git@") {
    معرف = م.جزء(4).ابدل(":", "/")
    مضيف = معرف.قسم("/")[0]
  } والا {
    اذا ليس م.يحتوي("/") او م.يحتوي(":") { ارمي "مصدر غير صالح (الشكل المتوقع owner/repo): " + نص }
    رابط = "https://github.com/" + م + ".git"
    معرف = "github.com/" + م
    مضيف = "github.com"
  }
  معرف = معرف.ابدل(":", "_")
  اذا معرف.ينتهي_ب(".git") { معرف = معرف.جزء(0, طول(معرف) - 4) }
  طالما معرف.ينتهي_ب("/") { معرف = معرف.جزء(0, طول(معرف) - 1) }
  اذا _مستضيفات_غير_حساسة.يحتوي(مضيف.صغير()) { معرف = معرف.صغير() }
  اذا معرف.يحتوي("..") او معرف.يبدأ_ب("/") او معرف.يبدأ_ب("-") او معرف.يحتوي("//") او طول(معرف) > 200 او طول(معرف.قسم("/")) < 2 { ارمي "مصدر غير صالح: " + نص }
  لكل ح في معرف {
    اذا ليس ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-/".يحتوي(ح)) { ارمي "مصدر غير صالح (حرف غير مسموح): " + نص }
  }
  اذا رابط.يبدأ_ب("-") او رابط.يحتوي(" ") او رابط.يحتوي("\n") او رابط.يحتوي("\"") او رابط.يبدأ_ب("ext::") او طول(رابط) > 400 { ارمي "رابط غير صالح: " + نص }
  اذا مرجع != "" { _تحقق(مرجع, "المرجع") }
  اذا نطاق != "" { لكل ح في نطاق { اذا ليس "0123456789.xX*^~<>=vV latest".يحتوي(ح) { ارمي "نطاق إصدار غير صالح: " + نطاق } } }
  اذا مرجع != "" و نطاق != "" { ارمي "لا يمكن الجمع بين نطاق إصدار ومرجع (#): " + نص }
  ارجع {"نوع": "git", "رابط": رابط, "معرف": معرف, "نطاق": نطاق, "مرجع": مرجع}
}
دالة _اسم_افتراضي(معرف) {
  خل ق = معرف.قسم("/")
  ارجع ق[طول(ق) - 1]
}

دالة _وسوم(رابط) {
  خل ر = _نفذ(["git", "ls-remote", "--tags", "--refs", "--", رابط])
  اذا ر["رمز"] != 0 { ارمي "تعذّر قراءة وسوم المستودع (تحقق من الرابط والاتصال والصلاحيات): " + رابط }
  خل خارج = []
  لكل س في ر["ناتج"].قسم("\n") {
    خل ج = س.قسم("\t")
    اذا طول(ج) < 2 { استمر }
    خل وسم = ج[1].نظف()
    اذا ليس وسم.يبدأ_ب("refs/tags/") { استمر }
    وسم = وسم.جزء(10)
    خل ن = _اجزاء(وسم)
    اذا ن != عدم { خارج.اضف({"وسم": وسم, "ن": ن, "نص": "${ن[0]}.${ن[1]}.${ن[2]}"}) }
  }
  ارجع خارج
}
دالة _اصدارات_محلية(معرف) {
  خل خارج = []
  خل مجلد = المتجر + "/" + معرف
  اذا ليس ملفات.هل_مجلد(مجلد) { ارجع خارج }
  لكل س في ملفات.قائمة(مجلد) {
    خل ن = _اجزاء(س)
    اذا ن != عدم { خارج.اضف({"وسم": "v" + س, "ن": ن, "نص": س}) }
  }
  ارجع خارج
}
دالة _ميتا(معرف, اصدار) {
  خل مسار = _مسار_المتجر(معرف, اصدار) + "/.solan-meta"
  اذا ملفات.موجود(مسار) {
    حاول { ارجع جيسون.فك(ملفات.اقرا(مسار)) } امسك (خ) { ارجع عدم }
  }
  ارجع عدم
}
دالة _اختر(وسوم, نطاق) {
  خل مرشح = وسوم.رشح(ع => _يطابق(ع["ن"], نطاق))
  اذا طول(مرشح) == 0 { ارجع عدم }
  خل مرتب = مرشح.رتب((أ, ب) => _قارن(ب["ن"], أ["ن"]))
  ارجع مرتب[0]
}

دالة _ملفات(مجلد, اساس, خارج) {
  لكل س في ملفات.قائمة(مجلد) {
    اذا س == ".git" او س == ".solan-meta" { استمر }
    خل مسار = مجلد + "/" + س
    خل نسبي = اساس == "" ؟ س : اساس + "/" + س
    اذا ملفات.هل_رابط(مسار) { ارمي "الحزمة تحتوي رابطا رمزيا (غير مسموح): " + نسبي }
    اذا ملفات.هل_مجلد(مسار) { _ملفات(مسار, نسبي, خارج) } والا {
      خارج.اضف(نسبي)
      اذا طول(خارج) > الحد_الاقصى_للملفات { ارمي "الحزمة تتجاوز الحد الأقصى لعدد الملفات (" + نسق("{}", الحد_الاقصى_للملفات) + ")" }
    }
  }
}
دالة بصمة(مجلد) {
  خل ق = []
  _ملفات(مجلد, "", ق)
  ق = ق.رتب()
  خل ب = []
  خل حجم = 0
  لكل م في ق {
    حجم += ملفات.حجم(مجلد + "/" + م)
    اذا حجم > الحد_الاقصى_للحجم { ارمي "الحزمة تتجاوز الحد الأقصى للحجم (50 ميغابايت)" }
    ب.اضف(م + ":" + تشفير.sha256(ملفات.اقرا(مجلد + "/" + م)))
  }
  ارجع تشفير.sha256(ب.ادمج("\n"))
}

دالة _مسار_المتجر(معرف, اصدار) { ارجع المتجر + "/" + معرف + "/" + اصدار }
دالة _معرف_كامل(معرف, اصدار) { ارجع معرف + "@" + اصدار }
دالة _اصدار_من(id) {
  خل ق = id.قسم("@")
  ارجع ق[طول(ق) - 1]
}
دالة _معرف_من(id) {
  خل ص = _اصدار_من(id)
  ارجع id.جزء(0, طول(id) - طول(ص) - 1)
}
دالة _قصير(س) { ارجع س == عدم ؟ "" : (طول(س) > 8 ؟ س.جزء(0, 8) : س) }

دالة _اجلب(رابط, مرجع, وجهة_مؤقتة) {
  خل وسم_او_فرع = مرجع != "" و ليس (طول(مرجع) >= 7 و _ست_عشري(مرجع))
  خل اساس = ["git", "-c", "advice.detachedHead=false", "-c", "core.autocrlf=false", "-c", "core.eol=lf"]
  اذا مرجع == "" او وسم_او_فرع {
    خل أمر = اساس + ["clone", "-q", "--depth", "1"]
    اذا مرجع != "" { أمر = أمر + ["--branch", مرجع] }
    أمر = أمر + ["--", رابط, وجهة_مؤقتة]
    اذا _نفذ(أمر)["رمز"] != 0 { ارمي "فشل جلب " + رابط + (مرجع != "" ؟ " (" + مرجع + ")" : "") }
  } والا {
    اذا _نفذ(اساس + ["clone", "-q", "--", رابط, وجهة_مؤقتة])["رمز"] != 0 { ارمي "فشل جلب " + رابط }
    اذا _نفذ(["git", "-C", وجهة_مؤقتة, "checkout", "-q", "--detach", مرجع])["رمز"] != 0 { ارمي "الالتزام غير موجود: " + مرجع }
  }
  خل ت = _نفذ(["git", "-C", وجهة_مؤقتة, "rev-parse", "HEAD"])
  اذا ت["رمز"] != 0 { ارمي "تعذّر قراءة الالتزام" }
  خل التزام = ت["ناتج"].نظف()
  _احذف_مجلد(وجهة_مؤقتة + "/.git")
  ارجع التزام
}

دالة _قيد_المتجر(معرف, اصدار, رابط, مرجع, التزام_مقفل, بصمة_مقفلة) {
  اذا اصدار != "" {
    خل موجود = _مسار_المتجر(معرف, اصدار)
    اذا ملفات.هل_مجلد(موجود) {
      خل م = _ميتا(معرف, اصدار)
      اذا م != عدم { ارجع {"التزام": م["التزام"], "بصمة": م["بصمة"], "اصدار": اصدار, "جديد": غلط} }
      ارجع {"التزام": التزام_مقفل != عدم ؟ التزام_مقفل : "غير معروف", "بصمة": بصمة(موجود), "اصدار": اصدار, "جديد": غلط}
    }
  }
  _انشئ(الكاش)
  خل مؤقت = الكاش + "/جلب" + نص_عشوائي()
  ملفات.احذف_شجرة(مؤقت)
  خل نتيجة = عدم
  حاول {
    خل التزام = _اجلب(رابط, مرجع, مؤقت)
    اذا التزام_مقفل != عدم و التزام_مقفل != "" و التزام != التزام_مقفل {
      ارمي "الالتزام لا يطابق القفل لـ " + معرف + " (المتوقع " + _قصير(التزام_مقفل) + "، الفعلي " + _قصير(التزام) + ")"
    }
    خل ب = بصمة(مؤقت)
    اذا بصمة_مقفلة != عدم و بصمة_مقفلة != "" و ب != بصمة_مقفلة {
      ارمي "عدم تطابق البصمة لـ " + معرف + " (تلاعب أو تغيّر المصدر)"
    }
    خل نهائي = اصدار != "" ؟ اصدار : "head-" + التزام.جزء(0, 8)
    خل وجهة = _مسار_المتجر(معرف, نهائي)
    اذا ملفات.هل_مجلد(وجهة) {
      ملفات.احذف_شجرة(مؤقت)
      نتيجة = {"التزام": التزام, "بصمة": ب, "اصدار": نهائي, "جديد": غلط}
    } والا {
      ملفات.اكتب(مؤقت + "/.solan-meta", جيسون.ترميز({"التزام": التزام, "بصمة": ب}))
      _انشئ(المتجر + "/" + معرف)
      اذا ليس ملفات.انقل(مؤقت, وجهة) {
        اذا ملفات.هل_مجلد(وجهة) { ملفات.احذف_شجرة(مؤقت) } والا { ارمي "تعذّر نقل الحزمة إلى المتجر" }
      }
      نتيجة = {"التزام": التزام, "بصمة": ب, "اصدار": نهائي, "جديد": صح}
    }
  } امسك (خ) {
    ملفات.احذف_شجرة(مؤقت)
    ارمي خ
  }
  ارجع نتيجة
}

دالة _اقرأ_json(مسار, ماذا) {
  خل نص = ملفات.اقرا(مسار)
  حاول { ارجع جيسون.فك(نص) } امسك (خ) { ارمي ماذا + " غير صالح (JSON): " + مسار + " — " + خ }
}
دالة _اقرأ_بيان(مجلد = ".") {
  خل مسار = مجلد + "/" + البيان
  اذا ليس ملفات.موجود(مسار) { ارمي "لا يوجد " + مسار + " (شغّل: solan init)" }
  خل ب = _اقرأ_json(مسار, البيان)
  اذا ليس هل_قاموس(ب) { ارمي البيان + " يجب أن يكون كائن JSON" }
  ارجع ب
}
دالة _اعتماديات(بيان) {
  خل أ = بيان.احصل("الاعتماديات")
  خل ب = بيان.احصل("dependencies")
  اذا أ != عدم و ب != عدم { ارمي "لا يمكن وجود الاعتماديات و dependencies معا في " + البيان }
  خل د = أ != عدم ؟ أ : ب
  اذا د == عدم { ارجع {} }
  اذا ليس هل_قاموس(د) { ارمي "الاعتماديات يجب أن تكون كائنا (اسم: مصدر)" }
  لكل اسم، ن في د {
    اذا ليس هل_نص(ن) او ن.نظف() == "" { ارمي "قيمة الاعتمادية '" + اسم + "' يجب أن تكون نصا غير فارغ" }
  }
  ارجع د
}
دالة _مفتاح_الاعتماديات(بيان) {
  اذا بيان.احصل("dependencies") != عدم و بيان.احصل("الاعتماديات") == عدم { ارجع "dependencies" }
  ارجع "الاعتماديات"
}
دالة _اقرأ_قفل() {
  اذا ليس ملفات.موجود(القفل) { ارجع عدم }
  خل ق = عدم
  حاول { ق = جيسون.فك(ملفات.اقرا(القفل)) } امسك (خ) {
    اطبع("تنبيه: solan.lock تالف وسيُعاد توليده")
    ارجع عدم
  }
  اذا ليس هل_قاموس(ق) { ارجع عدم }
  خل نسخة = ق.احصل("نسخة")
  اذا هل_رقم(نسخة) و نسخة > 2 { ارمي "solan.lock أحدث من هذه النسخة من سولان (نسخة القفل " + نسق("{}", نسخة) + ")؛ حدّث سولان" }
  اذا نسخة != 2 او ق.احصل("حزم") == عدم او ق.احصل("جذر") == عدم او ق.احصل("مواصفات") == عدم { ارجع عدم }
  ارجع ق
}
دالة _اكتب_قفل(قفل) { _اكتب_ذري(القفل, جيسون.ترميز(قفل, 2) + "\n") }
دالة _اكتب_بيان(بيان) { _اكتب_ذري(البيان, جيسون.ترميز(بيان, 2) + "\n") }

دالة _سجل_المشاريع() {
  اذا ليس ملفات.موجود(ملف_السجل) { ارجع [] }
  حاول {
    خل ق = جيسون.فك(ملفات.اقرا(ملف_السجل))
    اذا هل_قائمة(ق) { ارجع ق }
  } امسك (خ) { }
  ارجع []
}
دالة _سجل(جذر) {
  حاول {
    خل ق = _سجل_المشاريع()
    اذا ق.يحتوي(جذر) { ارجع }
    ق.اضف(جذر)
    اذا طول(ق) > الحد_الاقصى_للسجل { ق = ق.اقتطع(طول(ق) - الحد_الاقصى_للسجل) }
    _انشئ(البيت)
    _اكتب_ذري(ملف_السجل, جيسون.ترميز(ق) + "\n")
  } امسك (خ) { }
}

دالة _ثبت_مواصفة(نص, حالة, عمق, اساس_المسار) {
  اذا عمق > 16 { ارمي "عمق الاعتماديات كبير جدا (دورة؟): " + نص }
  اذا طول(حالة["حزم"].مفاتيح()) > الحد_الاقصى_للحزم { ارمي "عدد الحزم يتجاوز الحد الأقصى (" + نسق("{}", الحد_الاقصى_للحزم) + ")" }
  خل م = _حلل(نص)
  اذا م["نوع"] == "مسار" {
    اذا عمق > 0 { ارمي "الاعتماديات المحلية (مسارات) مسموحة لمشروعك الرئيسي فقط وليس داخل حزمة: " + نص }
    خل مسار = م["مسار"]
    خل كامل = (مسار.يبدأ_ب("/") او (طول(مسار) > 2 و مسار[1] == ":")) ؟ مسار : اساس_المسار + "/" + مسار
    اذا ليس ملفات.هل_مجلد(كامل) { ارمي "مجلد الاعتمادية المحلية غير موجود: " + مسار }
    خل معرف_محلي = "محلي:" + مسار
    اذا حالة["حزم"].احصل(معرف_محلي) != عدم { ارجع معرف_محلي }
    خل ادخال = {"مصدر": نص, "مسار": مسار, "اعتماديات": {}}
    حالة["حزم"][معرف_محلي] = ادخال
    اذا ملفات.موجود(كامل + "/" + البيان) {
      لكل اسم، ن في _اعتماديات(_اقرأ_بيان(كامل)) { ادخال["اعتماديات"][اسم] = _ثبت_مواصفة(ن, حالة, عمق + 1, كامل) }
    }
    ارجع معرف_محلي
  }
  خل مفتاح_طلب = نص.نظف()
  خل سابق = حالة["مفهرس"].احصل(مفتاح_طلب)
  خل معرف = م["معرف"]
  خل اصدار = ""
  خل مرجع = ""
  خل التزام_مقفل = عدم
  خل بصمة_مقفلة = عدم
  اذا سابق != عدم {
    اصدار = سابق["اصدار"]; مرجع = سابق["مرجع"]; التزام_مقفل = سابق["التزام"]; بصمة_مقفلة = سابق["بصمة"]
  } والا اذا م["مرجع"] != "" {
    مرجع = م["مرجع"]
    اصدار = "ref-" + (_ست_عشري(مرجع) و طول(مرجع) >= 7 ؟ مرجع.جزء(0, 12) : مرجع.ابدل("/", "_"))
  } والا {
    خل اختيار = عدم
    خل بلا_وسوم = غلط
    اذا _وضع["محلي"] { اختيار = _اختر(_اصدارات_محلية(معرف), م["نطاق"]) }
    اذا اختيار == عدم {
      خل وسوم = عدم
      حاول { وسوم = _وسوم(م["رابط"]) } امسك (خ) {
        اختيار = _اختر(_اصدارات_محلية(معرف), م["نطاق"])
        اذا اختيار == عدم { ارمي خ }
        اطبع("تنبيه: لا اتصال بالمستودع، استُخدم الإصدار المثبت محليا لـ " + معرف)
      }
      اذا وسوم != عدم { اختيار = _اختر(وسوم, م["نطاق"]); بلا_وسوم = اختيار == عدم و طول(وسوم) == 0 }
    }
    اذا اختيار != عدم { اصدار = اختيار["نص"]; مرجع = اختيار["وسم"] }
    والا اذا بلا_وسوم و (م["نطاق"] == "" او م["نطاق"] == "latest" او م["نطاق"] == "*") { اصدار = ""; مرجع = "" }
    والا { ارمي "لا يوجد إصدار يطابق '" + م["نطاق"] + "' في " + معرف }
  }
  خل نتيجة = _قيد_المتجر(معرف, اصدار, م["رابط"], مرجع, التزام_مقفل, بصمة_مقفلة)
  اصدار = نتيجة["اصدار"]
  خل id = _معرف_كامل(معرف, اصدار)
  اذا حالة["حزم"].احصل(id) != عدم { ارجع id }
  خل ادخال = {"مصدر": نص, "رابط": م["رابط"], "وسم": مرجع, "التزام": نتيجة["التزام"], "بصمة": نتيجة["بصمة"], "اعتماديات": {}}
  حالة["حزم"][id] = ادخال
  حالة["مفهرس"][مفتاح_طلب] = {"اصدار": اصدار, "مرجع": مرجع, "التزام": نتيجة["التزام"], "بصمة": نتيجة["بصمة"]}
  خل مجلد = _مسار_المتجر(معرف, اصدار)
  اذا ملفات.موجود(مجلد + "/" + البيان) {
    خل بيان_حزمة = _اقرأ_بيان(مجلد)
    اذا نتيجة["جديد"] و مرجع.يبدأ_ب("v") {
      خل مُعلن = بيان_حزمة.احصل("النسخة") != عدم ؟ بيان_حزمة.احصل("النسخة") : بيان_حزمة.احصل("version")
      اذا هل_نص(مُعلن) و _اجزاء(مُعلن) != عدم و _قارن(_اجزاء(مُعلن), _اجزاء(اصدار)) != 0 {
        اطبع("تنبيه: وسم " + id + " لا يطابق النسخة المعلنة داخل solan.json (" + مُعلن + ")")
      }
    }
    لكل اسم، ن في _اعتماديات(بيان_حزمة) { ادخال["اعتماديات"][اسم] = _ثبت_مواصفة(ن, حالة, عمق + 1, مجلد) }
  }
  ارجع id
}

دالة _ابنِ(بيان, قفل_قديم, تجديد) {
  خل حالة = {"حزم": {}, "مفهرس": {}}
  اذا قفل_قديم != عدم {
    لكل id، ادخال في قفل_قديم["حزم"] {
      اذا ادخال.احصل("مسار") == عدم و هل_نص(ادخال.احصل("مصدر")) {
        حالة["مفهرس"][ادخال["مصدر"]] = {"اصدار": _اصدار_من(id), "مرجع": ادخال["وسم"], "التزام": ادخال["التزام"], "بصمة": ادخال["بصمة"]}
      }
    }
    اذا تجديد != عدم { لكل ن في تجديد { حالة["مفهرس"].احذف(ن) } }
  }
  خل جذر = {}
  خل مواصفات = {}
  لكل اسم، نص في _اعتماديات(بيان) {
    _اسم_اعتمادية(اسم)
    جذر[اسم] = _ثبت_مواصفة(نص, حالة, 0, ".")
    مواصفات[اسم] = نص
  }
  ارجع {"نسخة": 2, "جذر": جذر, "مواصفات": مواصفات, "حزم": حالة["حزم"]}
}

دالة ثبت_الكل(مجمد = غلط, صامت = غلط, محلي = غلط) {
  _وضع["محلي"] = محلي
  خل بيان = _اقرأ_بيان()
  خل قديم = _اقرأ_قفل()
  خل جذر_المشروع = ملفات.مسار_مطلق(".")
  اذا مجمد {
    اذا قديم == عدم { ارمي "لا يوجد solan.lock صالح (شغّل: solan install بدون --frozen)" }
    خل د = _اعتماديات(بيان)
    لكل اسم، نص في د {
      اذا قديم["مواصفات"].احصل(اسم) != نص { ارمي "solan.json لا يطابق solan.lock عند '" + اسم + "' (شغّل: solan install)" }
    }
    لكل اسم في قديم["مواصفات"].مفاتيح() {
      اذا د.احصل(اسم) == عدم { ارمي "solan.lock يحتوي اعتمادية '" + اسم + "' غير موجودة في solan.json (شغّل: solan install)" }
    }
    لكل id، ادخال في قديم["حزم"] {
      اذا ادخال.احصل("مسار") != عدم { استمر }
      خل اصدار = _اصدار_من(id)
      خل معرف = _معرف_من(id)
      خل مجلد_موجود = _مسار_المتجر(معرف, اصدار)
      اذا ملفات.هل_مجلد(مجلد_موجود) و بصمة(مجلد_موجود) != ادخال["بصمة"] {
        اطبع("تنبيه: المتجر تالف أو معدَّل لـ " + id + "، سيُعاد جلبها")
        _احذف_مجلد(مجلد_موجود)
      }
      _قيد_المتجر(معرف, اصدار, ادخال["رابط"], ادخال["وسم"] != "" ؟ ادخال["وسم"] : ادخال["التزام"], ادخال["التزام"], ادخال["بصمة"])
    }
    _سجل(جذر_المشروع)
    اذا ليس صامت { اطبع("تم تثبيت " + نسق("{}", طول(قديم["حزم"].مفاتيح())) + " حزمة من القفل") }
    ارجع
  }
  خل جديد = _ابنِ(بيان, قديم, عدم)
  _اكتب_قفل(جديد)
  _سجل(جذر_المشروع)
  اذا ليس صامت {
    لكل اسم، id في جديد["جذر"] { اطبع("✓ " + اسم + " ← " + id) }
    اطبع("تم تثبيت " + نسق("{}", طول(جديد["حزم"].مفاتيح())) + " حزمة")
  }
}

دالة اضف(نص, اسم = عدم) {
  خل مصدر = نص
  خل اسم_صريح = اسم
  خل ي = نص.ابحث("=")
  اذا ي > 0 و (نص.ابحث("/") < 0 او ي < نص.ابحث("/")) { اسم_صريح = نص.جزء(0, ي); مصدر = نص.جزء(ي + 1) }
  خل م = _حلل(مصدر)
  خل بيان = _اقرأ_بيان()
  خل اسم_نهائي = اسم_صريح
  اذا اسم_نهائي == عدم او اسم_نهائي == "" {
    اسم_نهائي = م["نوع"] == "مسار" ؟ _اسم_افتراضي(م["مسار"].ابدل("./", "")) : _اسم_افتراضي(م["معرف"])
  }
  _اسم_اعتمادية(اسم_نهائي)
  خل نص_محفوظ = مصدر
  اذا م["نوع"] == "git" و م["نطاق"] == "" و م["مرجع"] == "" {
    خل وس = _اختر(_وسوم(م["رابط"]), "")
    اذا وس != عدم { نص_محفوظ = مصدر + "@^" + وس["نص"] }
  }
  خل مفتاح = _مفتاح_الاعتماديات(بيان)
  اذا بيان.احصل(مفتاح) == عدم { بيان[مفتاح] = {} }
  خل نص_قديم = بيان[مفتاح].احصل(اسم_نهائي)
  خل موجودة = نص_قديم != عدم
  بيان[مفتاح][اسم_نهائي] = نص_محفوظ
  _اكتب_بيان(بيان)
  اطبع((موجودة ؟ "حُدّثت '" : "أُضيفت '") + اسم_نهائي + "' ← " + نص_محفوظ)
  حاول { ثبت_الكل() } امسك (خ) {
    خل بيان2 = _اقرأ_بيان()
    اذا موجودة { بيان2[مفتاح][اسم_نهائي] = نص_قديم } والا { بيان2[مفتاح].احذف(اسم_نهائي) }
    _اكتب_بيان(بيان2)
    ارمي خ
  }
}

دالة احذف(اسم) {
  خل بيان = _اقرأ_بيان()
  خل مفتاح = _مفتاح_الاعتماديات(بيان)
  خل د = _اعتماديات(بيان)
  اذا د.احصل(اسم) == عدم { ارمي "الاعتمادية '" + اسم + "' غير موجودة في " + البيان }
  د.احذف(اسم)
  بيان[مفتاح] = د
  _اكتب_بيان(بيان)
  خل جديد = _ابنِ(بيان, _اقرأ_قفل(), عدم)
  _اكتب_قفل(جديد)
  اطبع("أُزيلت '" + اسم + "' (تبقى النسخة في المتجر المشترك ولا تتأثر بها المشاريع الأخرى؛ للتنظيف: solan prune)")
}

دالة حدّث(اسم = عدم, رئيسي = غلط) {
  _وضع["محلي"] = غلط
  خل بيان = _اقرأ_بيان()
  خل مفتاح = _مفتاح_الاعتماديات(بيان)
  خل د = _اعتماديات(بيان)
  اذا اسم != عدم و د.احصل(اسم) == عدم { ارمي "الاعتمادية '" + اسم + "' غير موجودة في " + البيان }
  خل قديم = _اقرأ_قفل()
  خل اهداف = اسم != عدم ؟ [اسم] : د.مفاتيح()
  خل مواصفات_مجددة = []
  لكل ه في اهداف {
    اذا رئيسي {
      خل م = _حلل(د[ه])
      اذا م["نوع"] == "git" و م["مرجع"] == "" {
        خل وس = _اختر(_وسوم(م["رابط"]), "")
        اذا وس != عدم {
          خل اساس = د[ه]
          خل ي = اساس.اعكس().ابحث("@")
          خل موضع = طول(اساس) - 1 - ي
          اذا ي >= 0 و موضع > اساس.اعكس().ابحث("/") { اساس = اساس.جزء(0, موضع) }
          د[ه] = اساس + "@^" + وس["نص"]
        }
      }
    }
    مواصفات_مجددة.اضف(د[ه])
  }
  اذا رئيسي { بيان[مفتاح] = د; _اكتب_بيان(بيان) }
  خل جديد = _ابنِ(بيان, قديم, مواصفات_مجددة)
  _اكتب_قفل(جديد)
  خل تغيّر = 0
  لكل ه، id في جديد["جذر"] {
    خل قبل = قديم != عدم ؟ قديم["جذر"].احصل(ه) : عدم
    اذا قبل != id { اطبع("↑ " + ه + ": " + (قبل == عدم ؟ "جديد" : قبل) + " ← " + id); تغيّر += 1 }
  }
  اذا تغيّر == 0 { اطبع("كل شيء محدّث") }
}

دالة _مثبتة(id, ادخال) {
  اذا ادخال.احصل("مسار") != عدم { ارجع ملفات.هل_مجلد(ادخال["مسار"]) }
  ارجع ملفات.هل_مجلد(_مسار_المتجر(_معرف_من(id), _اصدار_من(id)))
}
دالة _مسح_المتجر(مجلد, نسبي, خارج) {
  اذا ليس ملفات.هل_مجلد(مجلد) { ارجع }
  لكل س في ملفات.قائمة(مجلد) {
    خل مسار = مجلد + "/" + س
    اذا ليس ملفات.هل_مجلد(مسار) { استمر }
    خل ن = نسبي == "" ؟ س : نسبي + "/" + س
    اذا ملفات.موجود(مسار + "/.solan-meta") { خارج.اضف(ن.جزء(0, طول(ن) - طول(س) - 1) + "@" + س) } والا { _مسح_المتجر(مسار, ن, خارج) }
  }
}
دالة اعرض(شجرة = غلط, مخزن = غلط) {
  اذا مخزن {
    خل خارج = []
    _مسح_المتجر(المتجر, "", خارج)
    اذا طول(خارج) == 0 { اطبع("المتجر فارغ (" + المتجر + ")"); ارجع }
    لكل ح في خارج.رتب() { اطبع(ح) }
    اطبع("— " + نسق("{}", طول(خارج)) + " حزمة في " + المتجر)
    ارجع
  }
  خل بيان = _اقرأ_بيان()
  خل قفل = _اقرأ_قفل()
  خل د = _اعتماديات(بيان)
  اذا طول(د.مفاتيح()) == 0 { اطبع("لا توجد اعتماديات"); ارجع }
  لكل اسم، نص في د {
    خل id = قفل != عدم ؟ قفل["جذر"].احصل(اسم) : عدم
    اذا id == عدم { اطبع(اسم + " ← " + نص + "  (غير مثبتة: شغّل solan install)"); استمر }
    خل ادخال = قفل["حزم"][id]
    اطبع(اسم + " ← " + id + (_مثبتة(id, ادخال) ؟ "" : "  ✗ مفقودة من المتجر"))
    اذا شجرة { _اطبع_فروع(قفل, id, "  ", {}) }
  }
}
دالة _اطبع_فروع(قفل, id, بادئة, مرئي) {
  خل ادخال = قفل["حزم"].احصل(id)
  اذا ادخال == عدم او مرئي.احصل(id) != عدم { ارجع }
  مرئي[id] = صح
  لكل ن، ابن في ادخال["اعتماديات"] {
    اطبع(بادئة + "└ " + ن + " ← " + ابن)
    _اطبع_فروع(قفل, ابن, بادئة + "  ", مرئي)
  }
}

دالة لماذا(اسم) {
  خل قفل = _اقرأ_قفل()
  اذا قفل == عدم { ارمي "لا يوجد solan.lock صالح (شغّل: solan install)" }
  خل اهداف = []
  لكل id في قفل["حزم"].مفاتيح() { اذا id.صغير().يحتوي(اسم.صغير()) { اهداف.اضف(id) } }
  لكل ن، id في قفل["جذر"] { اذا ن == اسم و ليس اهداف.يحتوي(id) { اهداف.اضف(id) } }
  اذا طول(اهداف) == 0 { ارمي "لا توجد حزمة تطابق '" + اسم + "' في القفل" }
  لكل ه في اهداف {
    اطبع(ه)
    خل وجد = غلط
    لكل ن، id في قفل["جذر"] { اذا id == ه { اطبع("  ← مطلوبة مباشرة من مشروعك باسم '" + ن + "'"); وجد = صح } }
    لكل p، ادخال في قفل["حزم"] {
      لكل ن، ابن في ادخال["اعتماديات"] { اذا ابن == ه { اطبع("  ← يطلبها " + p + " باسم '" + ن + "'"); وجد = صح } }
    }
    اذا ليس وجد { اطبع("  (يتيمة: غير مطلوبة من أي حزمة)") }
  }
}

دالة قديمة() {
  _وضع["محلي"] = غلط
  خل بيان = _اقرأ_بيان()
  خل قفل = _اقرأ_قفل()
  خل د = _اعتماديات(بيان)
  خل عدد = 0
  لكل اسم، نص في د {
    خل م = _حلل(نص)
    اذا م["نوع"] != "git" او م["مرجع"] != "" { استمر }
    خل id = قفل != عدم ؟ قفل["جذر"].احصل(اسم) : عدم
    خل الحالي = id != عدم ؟ _اصدار_من(id) : "-"
    خل وسوم = عدم
    حاول { وسوم = _وسوم(م["رابط"]) } امسك (خ) { اطبع(اسم + ": تعذّر الاتصال بالمستودع"); استمر }
    خل مسموح = _اختر(وسوم, م["نطاق"])
    خل احدث = _اختر(وسوم, "")
    خل م_نص = مسموح != عدم ؟ مسموح["نص"] : "-"
    خل ا_نص = احدث != عدم ؟ احدث["نص"] : "-"
    اذا الحالي != م_نص او م_نص != ا_نص {
      اطبع(اسم + "  الحالي " + الحالي + "  المسموح " + م_نص + "  الأحدث " + ا_نص)
      عدد += 1
    }
  }
  اذا عدد == 0 { اطبع("كل الاعتماديات محدّثة") }
}

دالة تحقق() {
  خل قفل = _اقرأ_قفل()
  اذا قفل == عدم { ارمي "لا يوجد solan.lock صالح (شغّل: solan install)" }
  خل سليم = صح
  لكل id، م في قفل["حزم"] {
    اذا م.احصل("مسار") != عدم { استمر }
    خل مسار = _مسار_المتجر(_معرف_من(id), _اصدار_من(id))
    اذا ليس ملفات.هل_مجلد(مسار) { اطبع("✗ " + id + ": مفقودة"); سليم = غلط; استمر }
    خل ب = عدم
    حاول { ب = بصمة(مسار) } امسك (خ) { اطبع("✗ " + id + ": " + خ); سليم = غلط; استمر }
    اذا ب != م["بصمة"] { اطبع("✗ " + id + ": البصمة لا تطابق القفل"); سليم = غلط } والا { اطبع("✓ " + id) }
  }
  اذا ليس سليم { ارمي "فشل التحقق من سلامة الحزم" }
}

دالة نظف_المتجر(تجربة = غلط) {
  خل مستخدمة = {}
  خل جذور = _سجل_المشاريع()
  خل باقية = []
  لكل ج في جذور {
    خل ملف = ج + "/" + القفل
    اذا ليس ملفات.موجود(ملف) { استمر }
    باقية.اضف(ج)
    حاول {
      خل ق = جيسون.فك(ملفات.اقرا(ملف))
      لكل id في ق["حزم"].مفاتيح() { مستخدمة[id] = صح }
    } امسك (خ) { }
  }
  خل خارج = []
  _مسح_المتجر(المتجر, "", خارج)
  خل محذوف = 0
  لكل id في خارج {
    اذا مستخدمة.احصل(id) == عدم {
      اطبع((تجربة ؟ "سيُحذف: " : "حُذف: ") + id)
      اذا ليس تجربة { _احذف_مجلد(_مسار_المتجر(_معرف_من(id), _اصدار_من(id))) }
      محذوف += 1
    }
  }
  اذا ليس تجربة و طول(باقية) != طول(جذور) { _اكتب_ذري(ملف_السجل, جيسون.ترميز(باقية) + "\n") }
  اطبع("— " + نسق("{}", محذوف) + " حزمة غير مستخدمة، " + نسق("{}", طول(خارج) - محذوف) + " محتفظ بها (من " + نسق("{}", طول(باقية)) + " مشروع مسجّل)")
}
دالة نظف_الكاش() {
  اذا ملفات.هل_مجلد(الكاش) { ملفات.احذف_شجرة(الكاش) }
  اطبع("نُظّف الكاش: " + الكاش)
}

دالة بدء(مكتبة = غلط) {
  اذا ملفات.موجود(البيان) { ارمي البيان + " موجود مسبقا" }
  اذا ليس مكتبة {
    ملفات.اكتب(البيان, جيسون.ترميز({"الاسم": "مشروعي", "النسخة": "0.1.0", "الاعتماديات": {}}, 2) + "\n")
    اطبع("أُنشئ " + البيان)
    ارجع
  }
  خل اسم = ملفات.مسار_مطلق(".").قسم("/")
  خل اسم_المجلد = اسم[طول(اسم) - 1]
  ملفات.اكتب(البيان, جيسون.ترميز({"الاسم": اسم_المجلد, "النسخة": "0.1.0", "الوصف": "وصف قصير للمكتبة", "المؤلف": "", "الرخصة": "MIT", "المدخل": "رئيسي.سو", "الاعتماديات": {}}, 2) + "\n")
  خل الملفات_الاولية = {
    "رئيسي.سو": "دالة مرحبا(اسم = \"عالم\") {\n  ارجع \"مرحبا \" + اسم\n}\n",
    "tests/اختبار.سو": "استورد \"نظام\"\nاستورد \"../رئيسي\"\n\nاذا رئيسي.مرحبا(\"سولان\") != \"مرحبا سولان\" {\n  اطبع(\"فشل: مرحبا\")\n  نظام.اخرج(1)\n}\nاطبع(\"نجح\")\n",
    "README.md": "# " + اسم_المجلد + "\n\nوصف المكتبة.\n\n## الاستخدام\n\nsolan add owner/" + اسم_المجلد + "\n\nاستورد \"" + اسم_المجلد + "\"\n"
  }
  لكل ف، محتوى في الملفات_الاولية {
    اذا ليس ملفات.موجود(ف) {
      خل ق = ف.قسم("/")
      اذا طول(ق) > 1 { ملفات.انشئ_مجلدات(ف.جزء(0, طول(ف) - طول(ق[طول(ق) - 1]) - 1)) }
      ملفات.اكتب(ف, محتوى)
    }
  }
  اطبع("أُنشئت هيكلة المكتبة: " + البيان + "، رئيسي.سو، tests/، README.md")
}

دالة _قابلية_النقل(قائمة) {
  خل محجوزة = ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]
  خل مرئية = {}
  لكل مسار في قائمة {
    اذا طول(مسار) > 240 { ارمي "مسار طويل جدا (يتجاوز 240 حرفا): " + مسار }
    لكل جزء في مسار.قسم("/") {
      اذا طول(جزء) > 150 { ارمي "اسم ملف طويل جدا: " + مسار }
      لكل ح في جزء {
        اذا "<>:\"|?*\\".يحتوي(ح) او رمز(ح) < 32 { ارمي "اسم ملف يحتوي حرفا غير مسموح على ويندوز (" + ح + "): " + مسار }
      }
      اذا جزء.ينتهي_ب(" ") او جزء.ينتهي_ب(".") { ارمي "اسم ملف ينتهي بمسافة أو نقطة (غير مسموح على ويندوز): " + مسار }
      خل قاعدة = جزء.قسم(".")[0].صغير()
      اذا محجوزة.يحتوي(قاعدة) { ارمي "اسم ملف محجوز في ويندوز (" + جزء + "): " + مسار }
    }
    خل مفتاح = مسار.صغير()
    اذا مرئية.احصل(مفتاح) != عدم { ارمي "ملفان يختلفان بحالة الأحرف فقط (يتصادمان على ويندوز وماك): " + مسار + " و " + مرئية[مفتاح] }
    مرئية[مفتاح] = مسار
  }
}
دالة انشر(تجربة = غلط, ادفع = غلط) {
  خل بيان = _اقرأ_بيان()
  خل اسم = بيان.احصل("الاسم") != عدم ؟ بيان.احصل("الاسم") : بيان.احصل("name")
  اذا ليس هل_نص(اسم) او اسم.نظف() == "" { ارمي "الحقل الاسم (أو name) مطلوب في " + البيان }
  خل نسخة = بيان.احصل("النسخة") != عدم ؟ بيان.احصل("النسخة") : بيان.احصل("version")
  اذا ليس هل_نص(نسخة) { ارمي "الحقل النسخة (أو version) مطلوب في " + البيان }
  خل ن = _اجزاء(نسخة)
  اذا ن == عدم او طول(نسخة.قسم(".")) != 3 او نسخة.يبدأ_ب("v") { ارمي "النسخة '" + نسخة + "' غير صالحة (الشكل المطلوب MAJOR.MINOR.PATCH مثل 1.2.3)" }
  خل مدخل = بيان.احصل("المدخل") != عدم ؟ بيان.احصل("المدخل") : (بيان.احصل("entry") != عدم ؟ بيان.احصل("entry") : "رئيسي.سو")
  اذا ليس هل_نص(مدخل) او مدخل.يحتوي("..") او مدخل.يبدأ_ب("/") { ارمي "المدخل غير صالح: " + نسق("{}", مدخل) }
  اذا ليس ملفات.موجود(مدخل) { ارمي "ملف المدخل غير موجود: " + مدخل }
  لكل اس، مصدر في _اعتماديات(بيان) {
    _اسم_اعتمادية(اس)
    خل م = _حلل(مصدر)
    اذا م["نوع"] == "مسار" { ارمي "لا يمكن نشر مكتبة تعتمد على مسار محلي ('" + اس + "')" }
  }
  اذا _نفذ(["git", "rev-parse", "--is-inside-work-tree"])["رمز"] != 0 { ارمي "هذا المجلد ليس مستودع git (نفّذ: git init)" }
  خل حالة = _نفذ(["git", "status", "--porcelain"])
  اذا حالة["ناتج"].نظف() != "" { ارمي "توجد تغييرات غير مُلتزَم بها؛ نفّذ commit أولا" }
  خل وسم = "v" + نسخة
  خل وسوم = _نفذ(["git", "tag", "-l"])["ناتج"].قسم("\n")
  اذا وسوم.يحتوي(وسم) { ارمي "الوسم " + وسم + " موجود مسبقا؛ ارفع رقم النسخة في " + البيان }
  لكل ت في وسوم {
    خل اج = _اجزاء(ت.نظف())
    اذا اج != عدم و _قارن(اج, ن) > 0 { ارمي "يوجد وسم أحدث (" + ت.نظف() + ") من النسخة " + نسخة }
  }
  خل ملفات_المكتبة = []
  _ملفات(".", "", ملفات_المكتبة)
  _قابلية_النقل(ملفات_المكتبة)
  اطبع("✓ " + اسم + " " + نسخة + " جاهزة للنشر (" + نسق("{}", طول(ملفات_المكتبة)) + " ملف)")
  اذا تجربة { اطبع("(تجربة: لم يُنشأ أي وسم)"); ارجع }
  اذا _نفذ(["git", "tag", "-a", وسم, "-m", اسم + " " + نسخة])["رمز"] != 0 { ارمي "فشل إنشاء الوسم " + وسم }
  اطبع("أُنشئ الوسم " + وسم)
  اذا ادفع {
    اذا _نفذ(["git", "push", "origin", وسم])["رمز"] != 0 { ارمي "فشل دفع الوسم (تحقق من remote origin والصلاحيات)" }
    اطبع("دُفع الوسم " + وسم + " إلى origin")
  } والا { اطبع("لنشره: git push origin " + وسم) }
}
