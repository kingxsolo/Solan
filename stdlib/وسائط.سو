استورد "نظام"

دالة _نوع(م) { ارجع هل_قاموس(م) ؟ م.احصل("نوع", "نص") : "نص" }
دالة _يأخذ_قيمة(ن) { ارجع ن == "نص" او ن == "رقم" او ن == "قائمة" }
دالة _حول(ن, قيمة, اسم, اخطاء) {
  اذا ن == "رقم" {
    خل ر = رقم(قيمة)
    اذا ر == عدم { اخطاء.اضف("قيمة غير رقمية للخيار --${اسم}: ${قيمة}") }
    ارجع ر
  }
  اذا ن == "منطقي" { ارجع قيمة == "صح" او قيمة == "true" او قيمة == "1" او قيمة == "yes" }
  ارجع قيمة
}
دالة _خزن(خيارات, اسم, ن, قيمة, اخطاء) {
  اذا ن == "قائمة" {
    اذا خيارات.احصل(اسم) == عدم او ليس هل_قائمة(خيارات[اسم]) { خيارات[اسم] = [] }
    خيارات[اسم].اضف(قيمة)
  }
  والا { خيارات[اسم] = قيمة }
}

دالة حلل(قائمة, مواصفات = {}) {
  خل خيارات = {}; خل موضعية = []; خل مجهولة = []; خل اخطاء = []
  خل ي = 0; خل انتهت = غلط
  لكل اسم، م في مواصفات {
    خل ن = _نوع(م)
    اذا ن == "عدد" { خيارات[اسم] = 0 }
    اذا ن == "قائمة" { خيارات[اسم] = [] }
    اذا هل_قاموس(م) و م.احصل("افتراضي") != عدم { خيارات[اسم] = م["افتراضي"] }
  }
  دالة بحث_اختصار(ح) {
    لكل اسم، م في مواصفات { اذا هل_قاموس(م) و م.احصل("اختصار") == ح { ارجع اسم } }
    ارجع عدم
  }
  دالة اضبط(اسم, قيمة_خام, ت) {
    خل م = مواصفات.احصل(اسم)
    اذا م == عدم و مواصفات.طول > 0 { مجهولة.اضف(ت); ارجع }
    خل ن = _نوع(م)
    اذا ن == "منطقي" { خيارات[اسم] = قيمة_خام == عدم ؟ صح : _حول("منطقي", قيمة_خام, اسم, اخطاء) }
    والا اذا ن == "عدد" { خيارات[اسم] = خيارات.احصل(اسم, 0) + 1 }
    والا {
      اذا قيمة_خام == عدم {
        اذا ي + 1 >= قائمة.طول { اخطاء.اضف("الخيار --${اسم} يحتاج قيمة"); ارجع }
        ي += 1; قيمة_خام = قائمة[ي]
      }
      _خزن(خيارات, اسم, ن, _حول(ن, قيمة_خام, اسم, اخطاء), اخطاء)
    }
  }
  طالما ي < قائمة.طول {
    خل ت = قائمة[ي]
    اذا انتهت او ليس ت.يبدأ_ب("-") او ت == "-" { موضعية.اضف(ت) }
    والا اذا ت == "--" { انتهت = صح }
    والا اذا ت.يبدأ_ب("--") {
      خل اسم = ت.جزء(2); خل قيمة = عدم
      اذا اسم.يحتوي("=") { خل ج = اسم.قسم("="); اسم = ج[0]; قيمة = ج.جزء(1).ادمج("=") }
      اذا اسم.يبدأ_ب("no-") و مواصفات.احصل(اسم) == عدم و مواصفات.احصل(اسم.جزء(3)) != عدم {
        خيارات[اسم.جزء(3)] = غلط
      }
      والا اذا اسم.يبدأ_ب("بلا-") و مواصفات.احصل(اسم) == عدم و مواصفات.احصل(اسم.جزء(4)) != عدم {
        خيارات[اسم.جزء(4)] = غلط
      }
      والا { اضبط(اسم, قيمة, ت) }
    }
    والا {
      خل حروف = ت.جزء(1).حروف()
      لكل ك في مدى(حروف.طول) {
        خل ح = حروف[ك]
        خل اسم = بحث_اختصار(ح)
        اذا اسم == عدم {
          اذا مواصفات.طول > 0 { مجهولة.اضف("-" + ح) }
          خيارات[ح] = صح
          استمر
        }
        خل ن = _نوع(مواصفات[اسم])
        اذا _يأخذ_قيمة(ن) {
          خل باقي = حروف.جزء(ك + 1).ادمج("")
          اضبط(اسم, باقي != "" ؟ باقي : عدم, ت)
          توقف
        }
        اضبط(اسم, عدم, ت)
      }
    }
    ي += 1
  }
  لكل اسم، م في مواصفات {
    اذا هل_قاموس(م) {
      خل بيئة = م.احصل("بيئة")
      اذا بيئة != عدم و ليس (اسم في خيارات) او (بيئة != عدم و خيارات[اسم] == م.احصل("افتراضي") و نظام.بيئة(بيئة) != عدم) {
        خل خام = نظام.بيئة(بيئة)
        اذا خام != عدم { خيارات[اسم] = _حول(_نوع(م), خام, اسم, اخطاء) }
      }
      خل ق = خيارات.احصل(اسم)
      اذا م.احصل("مطلوب", غلط) و (ق == عدم او ق == []) { اخطاء.اضف("الخيار --${اسم} مطلوب") }
      خل ك = م.احصل("اختيارات")
      اذا ك != عدم و ق != عدم و ليس (ق في ك) و _نوع(م) != "قائمة" {  خل مسموح = ك.ادمج("، "); اخطاء.اضف("قيمة غير مسموحة للخيار --${اسم}: ${ق} (المسموح: ${مسموح})") }
    }
  }
  ارجع {"خيارات": خيارات, "موضعية": موضعية, "اخطاء": اخطاء, "مجهولة": مجهولة}
}

دالة مساعدة(مواصفات, عنوان = "الخيارات") {
  خل س = [عنوان + ":"]
  لكل اسم، م في مواصفات {
    خل ا = (هل_قاموس(م) و م.احصل("اختصار") != عدم) ؟ "-" + م["اختصار"] + ", " : "    "
    خل ن = _نوع(م)
    خل وص = هل_قاموس(م) ؟ م.احصل("وصف", "") : ""
    خل اضافات = []
    اذا هل_قاموس(م) و م.احصل("افتراضي") != عدم { اضافات.اضف("افتراضي: " + نسق("{}", م["افتراضي"])) }
    اذا هل_قاموس(م) و م.احصل("مطلوب", غلط) { اضافات.اضف("مطلوب") }
    اذا هل_قاموس(م) و م.احصل("اختيارات") != عدم { اضافات.اضف("من: " + م["اختيارات"].ادمج("|")) }
    اذا هل_قاموس(م) و م.احصل("بيئة") != عدم { اضافات.اضف("بيئة: " + م["بيئة"]) }
    خل نوع_نص = _يأخذ_قيمة(ن) ؟ " <" + ن + ">" : ""
    خل ذيل = اضافات.طول > 0 ؟ " (" + اضافات.ادمج("، ") + ")" : ""
    س.اضف(نسق("  {}--{:<18} {}{}", ا, اسم + نوع_نص, وص, ذيل))
  }
  ارجع س.ادمج("\n")
}

دالة حلل_او_اخرج(قائمة, مواصفات = {}, وصف = "", امر_اسم = "") {
  خل ر = حلل(قائمة, مواصفات)
  خل ع = ر["خيارات"]
  اذا ع.احصل("help") == صح او ع.احصل("مساعدة") == صح او ع.احصل("h") == صح {
    اذا وصف != "" { اطبع(وصف); اطبع() }
    اطبع(مساعدة(مواصفات))
    نظام.اخرج(0)
  }
  خل ك = ر["اخطاء"].انسخ()
  لكل م في ر["مجهولة"] { ك.اضف("خيار غير معروف: ${م}") }
  اذا ك.طول > 0 {
    لكل ق في ك { اطبع("خطأ: " + ق) }
    اطبع()
    اطبع(مساعدة(مواصفات))
    نظام.اخرج(2)
  }
  ارجع ر
}

دالة حلل_اوامر(قائمة, اوامر, عام = {}) {
  خل اولي = حلل(قائمة, عام)
  خل اسم = عدم
  اذا اولي["موضعية"].طول > 0 و اولي["موضعية"][0] في اوامر { اسم = اولي["موضعية"][0] }
  خل مواصفات = {}
  لكل ك، ق في عام { مواصفات[ك] = ق }
  اذا اسم != عدم {
    خل خاص = اوامر[اسم].احصل("خيارات", {})
    لكل ك، ق في خاص { مواصفات[ك] = ق }
  }
  خل ر = حلل(قائمة, مواصفات)
  اذا اسم != عدم { ر["موضعية"] = ر["موضعية"].جزء(1) }
  ر["امر"] = اسم
  ارجع ر
}

دالة مساعدة_اوامر(اوامر, عام = {}, برنامج = "") {
  خل س = []
  اذا برنامج != "" { س.اضف("الاستعمال: " + برنامج + " <امر> [خيارات]"); س.اضف("") }
  س.اضف("الأوامر:")
  لكل اسم، م في اوامر { س.اضف(نسق("  {:<14} {}", اسم, م.احصل("وصف", ""))) }
  اذا عام.طول > 0 { س.اضف(""); س.اضف(مساعدة(عام, "خيارات عامة")) }
  ارجع س.ادمج("\n")
}
