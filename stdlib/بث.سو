صنف مرسل {
  بناء() { هذا._م = {} }
  على(حدث, ف) {
    اذا ليس (حدث في هذا._م) { هذا._م[حدث] = [] }
    هذا._م[حدث].اضف({"ف": ف, "مرة": غلط})
    ارجع هذا
  }
  مرة(حدث, ف) {
    اذا ليس (حدث في هذا._م) { هذا._م[حدث] = [] }
    هذا._م[حدث].اضف({"ف": ف, "مرة": صح})
    ارجع هذا
  }
  الغ(حدث, ف = عدم) {
    اذا ليس (حدث في هذا._م) { ارجع هذا }
    اذا ف == عدم { هذا._م.احذف(حدث); ارجع هذا }
    هذا._م[حدث] = هذا._م[حدث].رشح((ق) => ق["ف"] != ف)
    ارجع هذا
  }
  امسح(حدث = عدم) {
    اذا حدث == عدم { هذا._م = {} } والا اذا حدث في هذا._م { هذا._م.احذف(حدث) }
    ارجع هذا
  }
  ارسل(حدث, ...وسائط) {
    خل عدد = 0
    اذا حدث في هذا._م {
      خل نسخة = هذا._م[حدث].انسخ()
      هذا._م[حدث] = هذا._م[حدث].رشح((ق) => ليس ق["مرة"])
      لكل ق في نسخة { ق["ف"](...وسائط); عدد += 1 }
    }
    اذا "*" في هذا._م و حدث != "*" {
      لكل ق في هذا._م["*"].انسخ() { ق["ف"](حدث, ...وسائط); عدد += 1 }
    }
    ارجع عدد
  }
  عدد_المستمعين(حدث) { ارجع (حدث في هذا._م) ؟ هذا._م[حدث].طول : 0 }
  اسماء_الاحداث() { ارجع هذا._م.مفاتيح() }
}
دالة جديد() { ارجع مرسل() }
