استورد "رياضيات"

دالة _مطلق(س) { ارجع س < 0 ؟ -س : س }

دالة ارقام_مفصولة(ن, فاصل = ",", عشري = عدم) {
  خل نص_رقم = عشري == عدم ؟ نسق("{}", _مطلق(ن)) : نسق("{:." + نص(عشري) + "f}", _مطلق(ن))
  اذا نص_رقم.يحتوي("e") { ارجع نسق("{}", ن) }
  خل اجزاء = نص_رقم.قسم(".")
  خل جز_اول = اجزاء[0]; خل خ = []
  خل ي = جز_اول.طول
  طالما ي > 0 {
    خل ب = ي - 3
    اذا ب < 0 { ب = 0 }
    خ.اضف(جز_اول.جزء(ب, ي))
    ي = ب
  }
  خل ناتج = خ.اعكس().ادمج(فاصل)
  اذا اجزاء.طول > 1 { ناتج += "." + اجزاء[1] }
  ارجع (ن < 0 ؟ "-" : "") + ناتج
}

دالة حجم_ملف(بايت, عشري = 1, عربي = غلط) {
  خل وحدات = عربي ؟ ["بايت", "ك.ب", "م.ب", "ج.ب", "ت.ب", "ب.ب"] : ["B", "KB", "MB", "GB", "TB", "PB"]
  خل ق = _مطلق(بايت); خل ي = 0
  طالما ق >= 1024 و ي < وحدات.طول - 1 { ق = ق / 1024; ي += 1 }
  اذا ي == 0 { ارجع نسق("{} {}", بايت, وحدات[0]) }
  ارجع نسق("{:." + نص(عشري) + "f} {}", (بايت < 0 ؟ -ق : ق), وحدات[ي])
}

دالة نسبة(ق, عشري = 1) { ارجع نسق("{:." + نص(عشري) + "f}%", ق * 100) }
دالة عملة(ق, رمز = "", عشري = 2) {
  خل ن = ارقام_مفصولة(ق, ",", عشري)
  ارجع رمز == "" ؟ ن : ن + " " + رمز
}

دالة عدد_معدود(ن, مفرد, مثنى, جمع, كثير = عدم) {
  خل ك = كثير == عدم ؟ مفرد : كثير
  اذا ن == 1 { ارجع مفرد }
  اذا ن == 2 { ارجع مثنى }
  اذا ن == 0 { ارجع "0 " + جمع }
  خل م = ن % 100
  اذا م >= 3 و م <= 10 { ارجع نسق("{} {}", ن, جمع) }
  ارجع نسق("{} {}", ن, ك)
}

خل _وحدات_زمن = [
  ["يوم", "يومان", "ايام", "يوما", 86400],
  ["ساعة", "ساعتان", "ساعات", "ساعة", 3600],
  ["دقيقة", "دقيقتان", "دقائق", "دقيقة", 60],
  ["ثانية", "ثانيتان", "ثوان", "ثانية", 1]
]
دالة مدة(ثواني, حد = 2) {
  خل ق = رياضيات.ارضي(_مطلق(ثواني)); خل اجزاء = []
  لكل وح في _وحدات_زمن {
    خل ع = رياضيات.ارضي(ق / وح[4])
    اذا ع > 0 و اجزاء.طول < حد {
      اجزاء.اضف(عدد_معدود(ع, وح[0], وح[1], وح[2], وح[3]))
      ق -= ع * وح[4]
    }
  }
  اذا اجزاء.طول == 0 { ارجع "0 ثانية" }
  ارجع اجزاء.ادمج(" و ")
}
دالة مدة_قصيرة(ثواني) {
  خل ق = رياضيات.ارضي(_مطلق(ثواني)); خل ج = []
  لكل ز في [["d", 86400], ["h", 3600], ["m", 60], ["s", 1]] {
    خل ع = رياضيات.ارضي(ق / ز[1])
    اذا ع > 0 { ج.اضف(نص(ع) + ز[0]); ق -= ع * ز[1] }
  }
  ارجع ج.طول == 0 ؟ "0s" : ج.ادمج(" ")
}

خل _احاد = ["", "واحد", "اثنان", "ثلاثة", "أربعة", "خمسة", "ستة", "سبعة", "ثمانية", "تسعة", "عشرة", "أحد عشر", "اثنا عشر", "ثلاثة عشر", "أربعة عشر", "خمسة عشر", "ستة عشر", "سبعة عشر", "ثمانية عشر", "تسعة عشر"]
خل _عشرات = ["", "", "عشرون", "ثلاثون", "أربعون", "خمسون", "ستون", "سبعون", "ثمانون", "تسعون"]
خل _مئات = ["", "مئة", "مئتان", "ثلاثمئة", "أربعمئة", "خمسمئة", "ستمئة", "سبعمئة", "ثمانمئة", "تسعمئة"]
خل _مقاييس = [["", "", "", ""], ["ألف", "ألفان", "آلاف", "ألف"], ["مليون", "مليونان", "ملايين", "مليون"], ["مليار", "ملياران", "مليارات", "مليار"], ["ترليون", "ترليونان", "ترليونات", "ترليون"]]

دالة _مجموعة(ن) {
  خل م = رياضيات.ارضي(ن / 100); خل ب = ن % 100; خل ق = []
  اذا م > 0 { ق.اضف(_مئات[م]) }
  اذا ب > 0 {
    اذا ب < 20 { ق.اضف(_احاد[ب]) }
    والا {
      خل ف = ب % 10
      اذا ف > 0 { ق.اضف(_احاد[ف] + " و" + _عشرات[رياضيات.ارضي(ب / 10)]) } والا { ق.اضف(_عشرات[رياضيات.ارضي(ب / 10)]) }
    }
  }
  ارجع ق.ادمج(" و")
}
دالة عدد_بالحروف(ن) {
  خل ق = رياضيات.قرب(ن)
  اذا ق == 0 { ارجع "صفر" }
  خل سالب = ق < 0
  ق = _مطلق(ق)
  خل مجموعات = []
  طالما ق > 0 { مجموعات.اضف(ق % 1000); ق = رياضيات.ارضي(ق / 1000) }
  اذا مجموعات.طول > _مقاييس.طول { ارمي "العدد كبير جدا" }
  خل اجزاء = []
  لكل ي في مدى(مجموعات.طول - 1, -1, -1) {
    خل ع = مجموعات[ي]
    اذا ع == 0 { استمر }
    خل م = _مقاييس[ي]
    اذا ي == 0 { اجزاء.اضف(_مجموعة(ع)) }
    والا اذا ع == 1 { اجزاء.اضف(م[0]) }
    والا اذا ع == 2 { اجزاء.اضف(م[1]) }
    والا اذا ع >= 3 و ع <= 10 { اجزاء.اضف(_مجموعة(ع) + " " + م[2]) }
    والا { اجزاء.اضف(_مجموعة(ع) + " " + م[3]) }
  }
  خل ناتج = اجزاء.ادمج(" و")
  ارجع سالب ؟ "سالب " + ناتج : ناتج
}
