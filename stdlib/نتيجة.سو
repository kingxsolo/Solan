استورد "زمن"

صنف نتيجة {
  بناء(ناجح, قيمة, خطأ) { هذا.ناجح = ناجح; هذا.قيمة = قيمة; هذا.خطأ = خطأ }
  هل_ناجح() { ارجع هذا.ناجح }
  هل_فاشل() { ارجع ليس هذا.ناجح }
  افتح() { اذا هذا.ناجح { ارجع هذا.قيمة } ارمي هذا.خطأ }
  افتح_او(افتراضي) { ارجع هذا.ناجح ؟ هذا.قيمة : افتراضي }
  افتح_او_احسب(ف) { ارجع هذا.ناجح ؟ هذا.قيمة : ف(هذا.خطأ) }
  افتح_خطأ() { اذا هذا.ناجح { ارمي "النتيجة ناجحة وليس فيها خطأ" } ارجع هذا.خطأ }
  حول(ف) { اذا هذا.ناجح { ارجع نجاح(ف(هذا.قيمة)) } ارجع هذا }
  حول_خطأ(ف) { اذا هذا.ناجح { ارجع هذا } ارجع فشل(ف(هذا.خطأ)) }
  ثم(ف) { اذا هذا.ناجح { ارجع ف(هذا.قيمة) } ارجع هذا }
  او_ثم(ف) { اذا هذا.ناجح { ارجع هذا } ارجع ف(هذا.خطأ) }
  او(بديل) { ارجع هذا.ناجح ؟ هذا : بديل }
  رشح(شرط, خطأ) { اذا هذا.ناجح و ليس شرط(هذا.قيمة) { ارجع فشل(خطأ) } ارجع هذا }
  اذا_نجح(ف) { اذا هذا.ناجح { ف(هذا.قيمة) } ارجع هذا }
  اذا_فشل(ف) { اذا ليس هذا.ناجح { ف(هذا.خطأ) } ارجع هذا }
  طابق(م) { ارجع هذا.ناجح ؟ م["نجاح"](هذا.قيمة) : م["فشل"](هذا.خطأ) }
  الى_خيار() { ارجع هذا.ناجح ؟ شيء(هذا.قيمة) : غائب() }
  الى_نص() { ارجع هذا.ناجح ؟ "نجاح(" + نسق("{}", هذا.قيمة) + ")" : "فشل(" + نسق("{}", هذا.خطأ) + ")" }
}

دالة نجاح(قيمة = عدم) { ارجع نتيجة(صح, قيمة, عدم) }
دالة فشل(خطأ) { ارجع نتيجة(غلط, عدم, خطأ) }

دالة محاولة(ف, ...وسائط) {
  حاول { ارجع نجاح(ف(...وسائط)) } امسك (خ) { ارجع فشل(خ) }
}

دالة اعد_المحاولة(ف, مرات = 3, تأخير = 0, مضاعف = 1) {
  خل ر = فشل("لم تجرَّ أي محاولة"); خل ت = تأخير
  كرر مرات {
    ر = محاولة(ف)
    اذا ر.ناجح { ارجع ر }
    اذا ت > 0 { زمن.نوم(ت); ت = ت * مضاعف }
  }
  ارجع ر
}

دالة تجميع(قائمة) {
  خل ق = []
  لكل ر في قائمة {
    اذا ر.هل_فاشل() { ارجع ر }
    ق.اضف(ر.قيمة)
  }
  ارجع نجاح(ق)
}

دالة تجميع_اخطاء(قائمة) {
  خل ق = []; خل اخطاء = []
  لكل ر في قائمة { اذا ر.ناجح { ق.اضف(ر.قيمة) } والا { اخطاء.اضف(ر.خطأ) } }
  ارجع اخطاء.طول == 0 ؟ نجاح(ق) : فشل(اخطاء)
}

دالة فرز(قائمة) {
  خل ن = []; خل ف = []
  لكل ر في قائمة { اذا ر.ناجح { ن.اضف(ر.قيمة) } والا { ف.اضف(ر.خطأ) } }
  ارجع {"نجاح": ن, "فشل": ف}
}

صنف خيار {
  بناء(موجود, قيمة) { هذا.موجود = موجود; هذا.قيمة = قيمة }
  هل_موجود() { ارجع هذا.موجود }
  هل_غائب() { ارجع ليس هذا.موجود }
  افتح() { اذا هذا.موجود { ارجع هذا.قيمة } ارمي "الخيار غائب" }
  افتح_او(افتراضي) { ارجع هذا.موجود ؟ هذا.قيمة : افتراضي }
  افتح_او_احسب(ف) { ارجع هذا.موجود ؟ هذا.قيمة : ف() }
  حول(ف) { اذا هذا.موجود { ارجع شيء(ف(هذا.قيمة)) } ارجع هذا }
  ثم(ف) { اذا هذا.موجود { ارجع ف(هذا.قيمة) } ارجع هذا }
  او(بديل) { ارجع هذا.موجود ؟ هذا : بديل }
  او_ثم(ف) { ارجع هذا.موجود ؟ هذا : ف() }
  رشح(شرط) { اذا هذا.موجود و ليس شرط(هذا.قيمة) { ارجع غائب() } ارجع هذا }
  اذا_وجد(ف) { اذا هذا.موجود { ف(هذا.قيمة) } ارجع هذا }
  طابق(م) { ارجع هذا.موجود ؟ م["شيء"](هذا.قيمة) : م["غائب"]() }
  الى_نتيجة(خطأ) { ارجع هذا.موجود ؟ نجاح(هذا.قيمة) : فشل(خطأ) }
  الى_نص() { ارجع هذا.موجود ؟ "شيء(" + نسق("{}", هذا.قيمة) + ")" : "غائب" }
}
دالة شيء(قيمة) { ارجع خيار(صح, قيمة) }
دالة غائب() { ارجع خيار(غلط, عدم) }
دالة من_قيمة(قيمة) { ارجع قيمة == عدم ؟ غائب() : شيء(قيمة) }
دالة من_قاموس(م, مفتاح) { ارجع م.احصل(مفتاح) == عدم ؟ غائب() : شيء(م[مفتاح]) }
دالة من_قائمة(ق, فهرس) { ارجع ق.احصل(فهرس) == عدم ؟ غائب() : شيء(ق[فهرس]) }
