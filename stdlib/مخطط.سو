استورد "نمط"

دالة _قاعدة(ق) { ارجع هل_نص(ق) ؟ {"نوع": ق} : ق }
دالة _مسار(م, ج) {
  اذا م == "" { ارجع هل_نص(ج) ؟ ج : "[" + نص(ج) + "]" }
  ارجع هل_نص(ج) ؟ م + "." + ج : م + "[" + نص(ج) + "]"
}
دالة _من_النوع(ق, ن) {
  اذا ن == "اي" { ارجع صح }
  اذا ن == "نص" { ارجع هل_نص(ق) }
  اذا ن == "رقم" { ارجع هل_رقم(ق) }
  اذا ن == "منطقي" { ارجع ق == صح او ق == غلط }
  اذا ن == "قائمة" { ارجع هل_قائمة(ق) }
  اذا ن == "قاموس" { ارجع هل_قاموس(ق) }
  اذا ن == "دالة" { ارجع هل_دالة(ق) }
  ارمي "نوع غير معروف في المخطط: ${ن}"
}
دالة _حوّل(ق, ن) {
  اذا ن == "رقم" و هل_نص(ق) { خل ر = رقم(ق.نظف()); ارجع ر == عدم ؟ ق : ر }
  اذا ن == "منطقي" و هل_نص(ق) {
    اذا ق == "صح" او ق == "true" او ق == "1" { ارجع صح }
    اذا ق == "غلط" او ق == "false" او ق == "0" { ارجع غلط }
    ارجع ق
  }
  اذا ن == "نص" و (هل_رقم(ق) او ق == صح او ق == غلط) { ارجع نسق("{}", ق) }
  ارجع ق
}
دالة _خطأ(اخطاء, م, رسالة) { اخطاء.اضف({"مسار": م, "رسالة": رسالة}) }

دالة _افحص(ق, قاعدة, م, اخطاء) {
  خل ر = _قاعدة(قاعدة)
  خل ن = ر.احصل("نوع", "اي")
  خل حد_ادنى = ر.احصل("اقل_طول", ر.احصل("اصغر"))
  خل حد_اقصى = ر.احصل("اكثر_طول", ر.احصل("اكبر"))
  اذا ق == عدم {
    اذا ر.احصل("افتراضي") != عدم { ارجع ر["افتراضي"] }
    اذا ر.احصل("يقبل_عدم", غلط) او ر.احصل("اختياري", غلط) { ارجع عدم }
    _خطأ(اخطاء, م, "الحقل مطلوب")
    ارجع عدم
  }
  اذا ر.احصل("تحويل", غلط) { ق = _حوّل(ق, ن) }
  اذا ليس _من_النوع(ق, ن) { _خطأ(اخطاء, م, "يجب أن يكون من نوع ${ن}"); ارجع ق }
  اذا ن == "نص" {
    اذا ر.احصل("قص", غلط) { ق = ق.نظف() }
    اذا ر.احصل("اقل_طول") != عدم و ق.طول < ر["اقل_طول"] { _خطأ(اخطاء, م, "الطول أقل من ${حد_ادنى}") }
    اذا ر.احصل("اكثر_طول") != عدم و ق.طول > ر["اكثر_طول"] { _خطأ(اخطاء, م, "الطول أكبر من ${حد_اقصى}") }
    اذا ر.احصل("نمط") != عدم و ليس نمط.هل(ر["نمط"], ق) { _خطأ(اخطاء, م, "الصيغة غير صحيحة") }
  }
  اذا ن == "رقم" {
    اذا ر.احصل("صحيح", غلط) و ق != نمط_ارضي(ق) { _خطأ(اخطاء, م, "يجب أن يكون عددا صحيحا") }
    اذا ر.احصل("اصغر") != عدم و ق < ر["اصغر"] { _خطأ(اخطاء, م, "القيمة أقل من ${حد_ادنى}") }
    اذا ر.احصل("اكبر") != عدم و ق > ر["اكبر"] { _خطأ(اخطاء, م, "القيمة أكبر من ${حد_اقصى}") }
  }
  اذا ر.احصل("اختيارات") != عدم و ليس (ق في ر["اختيارات"]) { _خطأ(اخطاء, م, "قيمة غير مسموحة") }
  اذا ن == "قائمة" {
    اذا ر.احصل("اقل_طول") != عدم و ق.طول < ر["اقل_طول"] { _خطأ(اخطاء, م, "عدد العناصر أقل من ${حد_ادنى}") }
    اذا ر.احصل("اكثر_طول") != عدم و ق.طول > ر["اكثر_طول"] { _خطأ(اخطاء, م, "عدد العناصر أكبر من ${حد_اقصى}") }
    اذا ر.احصل("عناصر") != عدم {
      خل ناتج = []
      لكل ي، ع في ق { ناتج.اضف(_افحص(ع, ر["عناصر"], _مسار(م, ي), اخطاء)) }
      ق = ناتج
    }
    اذا ر.احصل("فريدة", غلط) {
      خل رأيت = {}
      لكل ع في ق {
        خل ك = نسق("{}", ع)
        اذا ك في رأيت { _خطأ(اخطاء, م, "العناصر يجب أن تكون فريدة"); توقف }
        رأيت[ك] = صح
      }
    }
  }
  اذا ن == "قاموس" {
    خل حقول = ر.احصل("حقول")
    اذا حقول != عدم {
      خل ناتج = {}
      لكل اسم، قاعدة_الحقل في حقول { ناتج[اسم] = _افحص(ق.احصل(اسم), قاعدة_الحقل, _مسار(م, اسم), اخطاء) }
      لكل ك، ف في ق {
        اذا ليس (ك في حقول) {
          اذا ر.احصل("ارفض_الزائد", غلط) { _خطأ(اخطاء, _مسار(م, ك), "حقل غير متوقع") }
          والا اذا ر.احصل("احتفظ_بالزائد", غلط) { ناتج[ك] = ف }
        }
      }
      لكل ك في ناتج.مفاتيح() { اذا ناتج[ك] == عدم و ليس (ك في ق) { ناتج.احذف(ك) } }
      ق = ناتج
    }
  }
  اذا ر.احصل("تحقق") != عدم {
    خل ن2 = ر["تحقق"](ق)
    اذا ن2 != صح و ن2 != عدم { _خطأ(اخطاء, م, هل_نص(ن2) ؟ ن2 : "قيمة غير صالحة") }
  }
  ارجع ق
}
دالة نمط_ارضي(ق) { ارجع ق - (ق % 1) }

دالة افحص(بيانات, قاعدة) {
  خل اخطاء = []
  خل ق = _افحص(بيانات, قاعدة, "", اخطاء)
  ارجع {"صالح": اخطاء.طول == 0, "اخطاء": اخطاء, "قيمة": ق}
}
دالة افتح(بيانات, قاعدة) {
  خل ر = افحص(بيانات, قاعدة)
  اذا ليس ر["صالح"] {
    خل خطوط = ر["اخطاء"].حول((خ) => (خ["مسار"] == "" ؟ "" : خ["مسار"] + ": ") + خ["رسالة"])
    ارمي {"رسالة": "بيانات غير صالحة: " + خطوط.ادمج("، "), "اخطاء": ر["اخطاء"]}
  }
  ارجع ر["قيمة"]
}
دالة صالح(بيانات, قاعدة) { ارجع افحص(بيانات, قاعدة)["صالح"] }

دالة _ادمج(اساس, خيارات) {
  خل ن = {}
  لكل ك، ق في اساس { ن[ك] = ق }
  لكل ك، ق في خيارات { ن[ك] = ق }
  ارجع ن
}
دالة سلسلة(خيارات = {}) { ارجع _ادمج({"نوع": "نص"}, خيارات) }
دالة عدد(خيارات = {}) { ارجع _ادمج({"نوع": "رقم"}, خيارات) }
دالة منطقي(خيارات = {}) { ارجع _ادمج({"نوع": "منطقي"}, خيارات) }
دالة قائمة_من(عناصر, خيارات = {}) { ارجع _ادمج({"نوع": "قائمة", "عناصر": عناصر}, خيارات) }
دالة كائن(حقول, خيارات = {}) { ارجع _ادمج({"نوع": "قاموس", "حقول": حقول}, خيارات) }
دالة اي(خيارات = {}) { ارجع _ادمج({"نوع": "اي"}, خيارات) }
