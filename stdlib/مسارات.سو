استورد "ملفات"
استورد "نظام"
استورد "نمط"
استورد "زمن"
استورد "عشوائي"
دالة ضم(...اجزاء) {
  خل ناتج = ""
  لكل ج في اجزاء {
    اذا ج == "" { استمر }
    اذا ج.يبدأ_ب("/") { ناتج = ج }
    والا اذا ناتج == "" { ناتج = ج }
    والا اذا ناتج.ينتهي_ب("/") { ناتج = ناتج + ج }
    والا { ناتج = ناتج + "/" + ج }
  }
  ارجع ناتج
}
دالة _قص(م) {
  خل ق = م
  طالما ق.طول > 1 و ق.ينتهي_ب("/") { ق = ق.جزء(0, ق.طول - 1) }
  ارجع ق
}
دالة الاسم(م) { خل ق = _قص(م); ارجع ق.قسم("/")[-1] }
دالة المجلد(م) {
  خل ق = _قص(م); خل ج = ق.قسم("/")
  اذا ج.طول == 1 { ارجع "." }
  خل ن = ج.جزء(0, ج.طول - 1).ادمج("/")
  اذا ن == "" { ارجع "/" }
  ارجع ن
}
دالة الامتداد(م) {
  خل ن = الاسم(م); خل ج = ن.قسم(".")
  اذا ج.طول > 1 و ج[0] != "" { ارجع "." + ج[-1] }
  ارجع ""
}
دالة بلا_امتداد(م) { ارجع م.جزء(0, م.طول - الامتداد(م).طول) }
دالة هل_مطلق(م) { ارجع م.يبدأ_ب("/") }
دالة طبّع_المسار(م) {
  خل مطلق = م.يبدأ_ب("/"); خل مكدس = []
  لكل ج في م.قسم("/") {
    اذا ج == "" او ج == "." { استمر }
    اذا ج == ".." {
      اذا مكدس.طول > 0 و مكدس[-1] != ".." { مكدس.اسحب() }
      والا اذا ليس مطلق { مكدس.اضف("..") }
    }
    والا { مكدس.اضف(ج) }
  }
  خل ن = مكدس.ادمج("/")
  اذا مطلق { ارجع "/" + ن }
  ارجع ن == "" ؟ "." : ن
}
دالة مطلق(م) {
  خل ر = ملفات.مسار_مطلق(م)
  اذا ر { ارجع ر }
  ارجع طبّع_المسار(هل_مطلق(م) ؟ م : ضم(نظام.مسار(), م))
}
دالة البيت() { ارجع ملفات.مسار_البيت() }
دالة حلل(م) { ارجع {"مجلد": المجلد(م), "اسم": الاسم(م), "امتداد": الامتداد(م), "جذع": بلا_امتداد(الاسم(م))} }
دالة مقاطع(م) { ارجع م.قسم("/").رشح((ج) => ج != "") }
دالة استبدل_امتداد(م, ام) {
  خل ن = بلا_امتداد(م)
  ارجع ن + ((ام == "" او ام.يبدأ_ب(".")) ؟ ام : "." + ام)
}
دالة اضف_امتداد(م, ام) { ارجع الامتداد(م) == "" ؟ استبدل_امتداد(م, ام) : م }
دالة نسبي(من, الى) {
  خل أ = مقاطع(طبّع_المسار(من)); خل ب = مقاطع(طبّع_المسار(الى))
  خل ي = 0
  طالما ي < أ.طول و ي < ب.طول و أ[ي] == ب[ي] { ي += 1 }
  خل ناتج = []
  لكل ك في مدى(ي, أ.طول) { ناتج.اضف("..") }
  لكل ك في مدى(ي, ب.طول) { ناتج.اضف(ب[ك]) }
  ارجع ناتج.طول == 0 ؟ "." : ناتج.ادمج("/")
}
دالة هل_داخل(م, جذر) {
  خل ر = طبّع_المسار(جذر); خل ن = طبّع_المسار(م)
  اذا ر == "/" { ارجع ن.يبدأ_ب("/") }
  ارجع ن == ر او ن.يبدأ_ب(ر + "/")
}
دالة _نمط_glob(ن) {
  خل خ = ["^"]; خل ح = ن.حروف(); خل ي = 0
  طالما ي < ح.طول {
    خل ك = ح[ي]
    اذا ك == "*" {
      اذا ي + 1 < ح.طول و ح[ي + 1] == "*" { خ.اضف(".*"); ي += 1 }
      والا { خ.اضف("[^/]*") }
    }
    والا اذا ك == "?" { خ.اضف("[^/]") }
    والا اذا ".+()[]{}^$|\\".يحتوي(ك) { خ.اضف("\\" + ك) }
    والا { خ.اضف(ك) }
    ي += 1
  }
  خ.اضف("$")
  ارجع خ.ادمج("")
}
دالة مطابق(م, نمط_glob) { ارجع نمط.هل(_نمط_glob(نمط_glob), م) }
دالة _امش(مجلد, جذر, ناتج, تكراري) {
  لكل اسم في ملفات.قائمة(مجلد) {
    خل كامل = ضم(مجلد, اسم)
    ناتج.اضف(كامل)
    اذا تكراري و ملفات.هل_مجلد(كامل) { _امش(كامل, جذر, ناتج, تكراري) }
  }
}
دالة ابحث(مجلد, نمط_glob = "*", تكراري = صح) {
  خل كل = []; _امش(مجلد, مجلد, كل, تكراري)
  خل ناتج = []; خل بالمسار = نمط_glob.يحتوي("/")
  لكل م في كل {
    خل هدف = بالمسار ؟ نسبي(مجلد, م) : الاسم(م)
    اذا مطابق(هدف, نمط_glob) { ناتج.اضف(م) }
  }
  ارجع ناتج.رتب()
}
دالة مجلد_مؤقت(بادئة = "solan_") {
  خل ن = ضم("/tmp", بادئة + نص(زمن.الان()) + "_" + نص(عشوائي.صحيح(1000, 999999)))
  ملفات.انشئ_مجلد(ن)
  ارجع ن
}
