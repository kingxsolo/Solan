استورد "جيسون"
استورد "عرض"
استورد "نصوص"

دالة هرب_html(س) {
  ارجع نسق("{}", س).ابدل("&", "&amp;").ابدل("<", "&lt;").ابدل(">", "&gt;").ابدل("\"", "&quot;").ابدل("'", "&#39;")
}

دالة _مرشح(اسم, ق, وسيط) {
  اذا اسم == "كبير" { ارجع نسق("{}", ق).كبير() }
  اذا اسم == "صغير" { ارجع نسق("{}", ق).صغير() }
  اذا اسم == "عنوان" { ارجع نصوص.عنوان(نسق("{}", ق)) }
  اذا اسم == "نظف" { ارجع نسق("{}", ق).نظف() }
  اذا اسم == "طول" { ارجع ق == عدم ؟ 0 : ق.طول }
  اذا اسم == "ادمج" { ارجع هل_قائمة(ق) ؟ ق.حول((ع) => نسق("{}", ع)).ادمج(وسيط == عدم ؟ "، " : نسق("{}", وسيط)) : ق }
  اذا اسم == "افتراضي" { ارجع (ق == عدم او ق == "" او ق == غلط) ؟ وسيط : ق }
  اذا اسم == "اقتطع" { ارجع نصوص.اقتطع(نسق("{}", ق), وسيط) }
  اذا اسم == "ارقام" { ارجع عرض.ارقام_مفصولة(ق, ",", وسيط) }
  اذا اسم == "حجم" { ارجع عرض.حجم_ملف(ق) }
  اذا اسم == "نسبة" { ارجع عرض.نسبة(ق, وسيط == عدم ؟ 1 : وسيط) }
  اذا اسم == "مدة" { ارجع عرض.مدة(ق) }
  اذا اسم == "حروف" { ارجع عرض.عدد_بالحروف(ق) }
  اذا اسم == "جيسون" { ارجع جيسون.ترميز(ق) }
  اذا اسم == "هرب" { ارجع هرب_html(ق) }
  اذا اسم == "عكس" { ارجع هل_قائمة(ق) ؟ ق.انسخ().اعكس() : نسق("{}", ق).اعكس() }
  اذا اسم == "رتب" { ارجع ق.انسخ().رتب() }
  اذا اسم == "املأ" { ارجع نصوص.املأ_يمين(ق, وسيط) }
  ارمي "مرشح نماذج غير معروف: ${اسم}"
}

دالة _حرفية(ن) {
  ن = ن.نظف()
  اذا ن.طول >= 2 و ((ن.يبدأ_ب("\"") و ن.ينتهي_ب("\"")) او (ن.يبدأ_ب("'") و ن.ينتهي_ب("'"))) { ارجع {"حرفية": صح, "ق": ن.جزء(1, ن.طول - 1)} }
  اذا ن == "صح" { ارجع {"حرفية": صح, "ق": صح} }
  اذا ن == "غلط" { ارجع {"حرفية": صح, "ق": غلط} }
  اذا ن == "عدم" { ارجع {"حرفية": صح, "ق": عدم} }
  خل ر = رقم(ن)
  اذا ر != عدم و ن != "" { ارجع {"حرفية": صح, "ق": ر} }
  ارجع {"حرفية": غلط, "مسار": ن}
}

دالة _ابحث(سياق, مسار) {
  خل اجزاء = مسار.قسم(".")
  خل ق = عدم; خل وجد = غلط
  خل اول = اجزاء[0]
  لكل ي في مدى(سياق.طول - 1, -1, -1) {
    اذا سياق[ي].احصل(اول) != عدم { ق = سياق[ي][اول]; وجد = صح; توقف }
  }
  اذا ليس وجد { ارجع عدم }
  لكل ي في مدى(1, اجزاء.طول) {
    اذا ق == عدم { ارجع عدم }
    خل ج = اجزاء[ي]
    اذا هل_قاموس(ق) { ق = ق.احصل(ج) }
    والا اذا هل_قائمة(ق) { خل ر = رقم(ج); ق = ر == عدم ؟ عدم : ق.احصل(ر) }
    والا اذا ج == "طول" و هل_نص(ق) { ق = ق.طول }
    والا { ارجع عدم }
  }
  ارجع ق
}
دالة _قيّم(ن, سياق) {
  خل ح = _حرفية(ن)
  ارجع ح["حرفية"] ؟ ح["ق"] : _ابحث(سياق, ح["مسار"])
}
دالة _صادق(ق) {
  اذا ق == عدم او ق == غلط او ق == "" او ق == 0 { ارجع غلط }
  اذا هل_قائمة(ق) او هل_قاموس(ق) { ارجع ق.طول > 0 }
  ارجع صح
}
دالة _شرط(نص_الشرط, سياق) {
  خل ن = نص_الشرط.نظف()
  خل معكوس = غلط
  اذا ن.يبدأ_ب("ليس ") { معكوس = صح; ن = ن.جزء(4).نظف() }
  خل نتيجة = غلط
  خل ح = غلط
  لكل ع في ["==", "!=", ">=", "<=", ">", "<"] {
    اذا ح { توقف }
    خل ف = " " + ع + " "
    اذا ن.يحتوي(ف) {
      خل ج = ن.قسم(ف)
      خل ل = _قيّم(ج[0], سياق); خل ر = _قيّم(ج.جزء(1).ادمج(ف), سياق)
      اذا ع == "==" { نتيجة = ل == ر }
      والا اذا ع == "!=" { نتيجة = ل != ر }
      والا اذا ع == ">=" { نتيجة = ل != عدم و ر != عدم و ل >= ر }
      والا اذا ع == "<=" { نتيجة = ل != عدم و ر != عدم و ل <= ر }
      والا اذا ع == ">" { نتيجة = ل != عدم و ر != عدم و ل > ر }
      والا { نتيجة = ل != عدم و ر != عدم و ل < ر }
      ح = صح
    }
  }
  اذا ليس ح { نتيجة = _صادق(_قيّم(ن, سياق)) }
  ارجع معكوس ؟ ليس نتيجة : نتيجة
}

دالة _حلل_تعبير(ن) {
  خل اجزاء = ن.قسم(" | ")
  خل مرشحات = []
  لكل ي في مدى(1, اجزاء.طول) {
    خل م = اجزاء[ي].نظف()
    خل ك = م.ابحث(":")
    اذا ك < 0 { مرشحات.اضف([م, عدم]) }
    والا { مرشحات.اضف([م.جزء(0, ك).نظف(), م.جزء(ك + 1).نظف()]) }
  }
  ارجع {"مسار": اجزاء[0].نظف(), "مرشحات": مرشحات}
}

دالة _قطّع(نموذج) {
  خل رموز = []
  خل اجزاء = نموذج.قسم("{{")
  اذا اجزاء[0] != "" { رموز.اضف({"ن": "نص", "ق": اجزاء[0]}) }
  خل ي = 1
  طالما ي < اجزاء.طول {
    خل ج = اجزاء[ي]
    خل خام = غلط
    خل خاتمة = ""
    اذا ج.يبدأ_ب("{") {
      خام = صح
      ج = ج.جزء(1)
      خاتمة = "}}}"
    } والا { خاتمة = "}}" }
    خل ك = ج.ابحث(خاتمة)
    اذا ك < 0 { ارمي "وسم قالب غير مغلق" }
    رموز.اضف({"ن": "وسم", "ق": ج.جزء(0, ك).نظف(), "خام": خام})
    خل باقي = ج.جزء(ك + خاتمة.طول)
    اذا باقي != "" { رموز.اضف({"ن": "نص", "ق": باقي}) }
    ي += 1
  }
  ارجع رموز
}

دالة صرّف(نموذج) {
  خل جذر = []
  خل مكدس = []
  خل حالي = جذر
  لكل ر في _قطّع(نموذج) {
    اذا ر["ن"] == "نص" { حالي.اضف({"ن": "نص", "ق": ر["ق"]}); استمر }
    خل ق = ر["ق"]
    اذا ق.يبدأ_ب("#لكل ") {
      خل جزء = ق.جزء(5).نظف().قسم(" في ")
      اذا جزء.طول != 2 { ارمي "صيغة #لكل غير صحيحة: ${ق}" }
      خل عقدة = {"ن": "لكل", "متغير": جزء[0].نظف(), "مصدر": جزء[1].نظف(), "داخل": [], "والا": []}
      حالي.اضف(عقدة); مكدس.اضف([عقدة, حالي]); حالي = عقدة["داخل"]
    }
    والا اذا ق.يبدأ_ب("#اذا ") {
      خل عقدة = {"ن": "اذا", "شرط": ق.جزء(5), "داخل": [], "والا": []}
      حالي.اضف(عقدة); مكدس.اضف([عقدة, حالي]); حالي = عقدة["داخل"]
    }
    والا اذا ق == "والا" {
      اذا مكدس.طول == 0 { ارمي "والا بلا فتح" }
      حالي = مكدس[مكدس.طول - 1][0]["والا"]
    }
    والا اذا ق == "/لكل" او ق == "/اذا" {
      اذا مكدس.طول == 0 { ارمي "اغلاق بلا فتح: ${ق}" }
      حالي = مكدس.اسحب()[1]
    }
    والا {
      خل تعبير = _حلل_تعبير(ق)
      حالي.اضف({"ن": "م", "مسار": تعبير["مسار"], "مرشحات": تعبير["مرشحات"], "خام": ر["خام"]})
    }
  }
  اذا مكدس.طول > 0 { ارمي "وسم مفتوح بلا اغلاق" }
  ارجع جذر
}

دالة _نفذ(عقد, سياق, هرب, خرج) {
  لكل ع في عقد {
    اذا ع["ن"] == "نص" { خرج.اضف(ع["ق"]) }
    والا اذا ع["ن"] == "م" {
      خل ق = _قيّم(ع["مسار"], سياق)
      لكل م في ع["مرشحات"] { ق = _مرشح(م[0], ق, م[1] == عدم ؟ عدم : _قيّم(م[1], سياق)) }
      خل ن = ق == عدم ؟ "" : نسق("{}", ق)
      خرج.اضف((هرب و ليس ع["خام"]) ؟ هرب_html(ن) : ن)
    }
    والا اذا ع["ن"] == "اذا" {
      اذا _شرط(ع["شرط"], سياق) { _نفذ(ع["داخل"], سياق, هرب, خرج) } والا { _نفذ(ع["والا"], سياق, هرب, خرج) }
    }
    والا {
      خل مصدر = _قيّم(ع["مصدر"], سياق)
      اذا هل_قاموس(مصدر) { مصدر = مصدر.مفاتيح().حول((ك) => {"مفتاح": ك, "قيمة": مصدر[ك]}) }
      اذا مصدر == عدم او مصدر.طول == 0 { _نفذ(ع["والا"], سياق, هرب, خرج); استمر }
      لكل ي، عنصر في مصدر {
        خل نطاق = {"هذا": عنصر, "@فهرس": ي, "@رقم": ي + 1, "@اول": ي == 0, "@اخر": ي == مصدر.طول - 1}
        نطاق[ع["متغير"]] = عنصر
        سياق.اضف(نطاق)
        _نفذ(ع["داخل"], سياق, هرب, خرج)
        سياق.اسحب()
      }
    }
  }
}

دالة ارسم(نموذج, بيانات = {}, هرب = غلط) {
  خل شجرة = هل_نص(نموذج) ؟ صرّف(نموذج) : نموذج
  خل خرج = []
  _نفذ(شجرة, [بيانات], هرب, خرج)
  ارجع خرج.ادمج("")
}
دالة ارسم_html(نموذج, بيانات = {}) { ارجع ارسم(نموذج, بيانات, صح) }
